{
  "name": "collega",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Collega monorepo: apps/* (Next.js web, Nest.js API) over packages/* (domain, application, infrastructure, design-system). See AGENTS.md.",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.20.0",
    "pnpm": ">=12.3.4"
  },
  "scripts": {
    "start": "node tools/local/start.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "dev": "pnpm start",
    "format": "biome format --write .",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --filter=!collega-e2e",
    "test:e2e": "turbo run test --filter=collega-e2e",
    "shots": "pnpm --filter @collega/demo-shots capture",
    "deck": "pnpm --filter @collega/demo-shots deck",
    "check": "pnpm run lint && turbo run typecheck test build --filter=!collega-e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "26.4.1",
    "turbo": "2.10.12",
    "typescript": "7.0.2"
  }
}
