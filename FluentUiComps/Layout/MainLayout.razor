@inherits LayoutComponentBase
<FluentDesignSystemProvider AccentBaseColor="#0f6cbd" BaseLayerLuminance="0.95f">
    <div class="shell">
        <aside class="sidebar">
            <NavMenu />
        </aside>
        <main class="content-pane">
            <header class="topbar">
                <div>
                    <h2>Sprint UI Comparison</h2>
                    <p>Fluent UI versions of the Jira sprint planning experience</p>
                </div>
            </header>
            <article class="body">
                @Body
            </article>
        </main>
    </div>
</FluentDesignSystemProvider>

<style>
    .shell {
        min-height: 100vh;
        display: grid;
        grid-template-columns: 280px 1fr;
        background: linear-gradient(120deg, #f8fbff, #f4f7fb);
    }
    .sidebar {
        border-right: 1px solid #dce7f2;
        background: #ffffff;
        padding: 16px;
    }
    .content-pane {
        display: flex;
        flex-direction: column;
    }
    .topbar {
        padding: 18px 24px;
        border-bottom: 1px solid #dce7f2;
        background: rgba(255,255,255,0.9);
        backdrop-filter: blur(12px);
    }
    .topbar h2 { margin: 0; font-size: 1.15rem; }
    .topbar p { margin: 4px 0 0; color: #50657a; }
    .body { padding: 20px; }
    @@media (max-width: 900px) {
        .shell { grid-template-columns: 1fr; }
        .sidebar { border-right: none; border-bottom: 1px solid #dce7f2; }
    }
</style>
