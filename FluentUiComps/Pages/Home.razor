@page "/"

<PageTitle>Fluent Sprint UI Comparison</PageTitle>

<div style="display: grid; gap: 16px;">
    <FluentCard Style="padding: 20px;">
        <h1 style="margin: 0 0 8px;">Fluent UI sprint planning concepts</h1>
        <p style="margin: 0; color: #50657a;">Three distinct versions of the Jira sprint planning experience built with Fluent UI components and layout primitives.</p>
    </FluentCard>

    <div style="display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));">
        <FluentCard Style="padding: 16px;">
            <h3 style="margin-top:0;">Version One</h3>
            <p>Operational and metric-first, with a crisp focus on commitment, blockers, and burndown health.</p>
            <NavLink href="version-one"><FluentButton>Open</FluentButton></NavLink>
        </FluentCard>
        <FluentCard Style="padding: 16px;">
            <h3 style="margin-top:0;">Version Two</h3>
            <p>Board-centric and editorial, emphasizing backlog movement, flow states, and sprint clarity.</p>
            <NavLink href="version-two"><FluentButton>Open</FluentButton></NavLink>
        </FluentCard>
        <FluentCard Style="padding: 16px;">
            <h3 style="margin-top:0;">Version Three</h3>
            <p>Analytical and timeline-driven, designed for governance, checkpointing, and risk review.</p>
            <NavLink href="version-three"><FluentButton>Open</FluentButton></NavLink>
        </FluentCard>
    </div>
</div>
