@page "/version-two"

<PageTitle>Version Two</PageTitle>

<div style="display: grid; gap: 16px;">
    <FluentCard Style="padding: 20px; background: linear-gradient(135deg, #fffaf1, #ffffff);">
        <div style="display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;">
            <div>
                <h2 style="margin: 0 0 6px;">Planning Canvas</h2>
                <p style="margin: 0; color: #50657a;">Board-first concept for backlog movement, flow states, and sprint clarity.</p>
            </div>
            <FluentBadge>Board-first</FluentBadge>
        </div>
    </FluentCard>

    <div style="display: grid; gap: 12px; grid-template-columns: repeat(4, minmax(220px, 1fr));">
        <FluentCard Style="padding: 12px; min-height: 320px;">
            <h4>To Do</h4>
            <FluentCard Style="padding: 10px; margin-bottom: 8px; border-left: 3px solid #0f6cbd;">
                <strong>SP-245 Confirmation email fallback</strong>
                <div style="color: #50657a; font-size: 0.86rem; margin-top: 6px;">Task • 2 pts • Rae</div>
            </FluentCard>
            <FluentCard Style="padding: 10px; border-left: 3px solid #0f6cbd;">
                <strong>SP-248 Approval summary UX</strong>
                <div style="color: #50657a; font-size: 0.86rem; margin-top: 6px;">Story • 5 pts • Eli</div>
            </FluentCard>
        </FluentCard>
        <FluentCard Style="padding: 12px; min-height: 320px;">
            <h4>In Progress</h4>
            <FluentCard Style="padding: 10px; margin-bottom: 8px; border-left: 3px solid #ff8c00;">
                <strong>SP-221 Duplicate signer bug</strong>
                <div style="color: #50657a; font-size: 0.86rem; margin-top: 6px;">Bug • 3 pts • T. Ho</div>
            </FluentCard>
        </FluentCard>
        <FluentCard Style="padding: 12px; min-height: 320px;">
            <h4>In Review</h4>
            <FluentCard Style="padding: 10px; border-left: 3px solid #0f6cbd;">
                <strong>SP-218 API approval route</strong>
                <div style="color: #50657a; font-size: 0.86rem; margin-top: 6px;">Story • 8 pts • A. King</div>
            </FluentCard>
        </FluentCard>
        <FluentCard Style="padding: 12px; min-height: 320px;">
            <h4>Done</h4>
            <FluentCard Style="padding: 10px; border-left: 3px solid #137333;">
                <strong>SP-240 PDF rejection rule</strong>
                <div style="color: #50657a; font-size: 0.86rem; margin-top: 6px;">Story • 5 pts • P. Long</div>
            </FluentCard>
        </FluentCard>
    </div>

    <div style="display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));">
        <FluentCard Style="padding: 14px;">
            <h4 style="margin-top: 0;">Flow cues</h4>
            <ul style="margin: 8px 0 0 16px; color: #50657a;">
                <li>Scope-added items are labeled and tracked separately</li>
                <li>Blocked issue ownership is explicit</li>
                <li>Daily updates remain visible in the active lane</li>
            </ul>
        </FluentCard>
        <FluentCard Style="padding: 14px;">
            <h4 style="margin-top: 0;">Sprint closure checklist</h4>
            <ul style="margin: 8px 0 0 16px; color: #50657a;">
                <li>Completed and incomplete scope captured</li>
                <li>Carryover and velocity recorded</li>
                <li>Reporting published within 24 hours</li>
            </ul>
        </FluentCard>
    </div>
</div>
