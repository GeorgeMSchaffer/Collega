@page "/version-three"

<PageTitle>Version Three</PageTitle>

<div style="display: grid; gap: 16px;">
    <FluentCard Style="padding: 20px; background: linear-gradient(135deg, #f2f7ff, #ffffff);">
        <div style="display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;">
            <div>
                <h2 style="margin: 0 0 6px;">Timeline Radar</h2>
                <p style="margin: 0; color: #50657a;">Governance-oriented concept focused on checkpoints, risk, and audit-ready delivery signals.</p>
            </div>
            <FluentBadge>Governance</FluentBadge>
        </div>
    </FluentCard>

    <div style="display: grid; gap: 16px; grid-template-columns: 1.1fr 0.9fr;">
        <FluentCard Style="padding: 16px;">
            <h3 style="margin-top: 0;">Sprint timeline</h3>
            <div style="display: grid; gap: 10px;">
                <FluentCard Style="padding: 10px; border-left: 3px solid #0f6cbd;">
                    <strong>Planning complete</strong><br />Stories and bugs estimated; customer-facing tasks tagged.
                </FluentCard>
                <FluentCard Style="padding: 10px; border-left: 3px solid #0f6cbd;">
                    <strong>Execution watch</strong><br />Daily standups, live status updates, and burndown review.
                </FluentCard>
                <FluentCard Style="padding: 10px; border-left: 3px solid #ff8c00;">
                    <strong>Blocker protocol</strong><br />Flag or label marks blocked and owner response is tracked.
                </FluentCard>
                <FluentCard Style="padding: 10px; border-left: 3px solid #137333;">
                    <strong>Closure package</strong><br />Reliability, carryover, velocity, completed, and incomplete work.
                </FluentCard>
            </div>
        </FluentCard>
        <FluentCard Style="padding: 16px;">
            <h3 style="margin-top: 0;">Delivery radar</h3>
            <div style="display: grid; gap: 10px;">
                <div style="display: grid; grid-template-columns: 120px 1fr 44px; align-items: center; gap: 8px;">
                    <span>Predictability</span>
                    <FluentProgressRing Style="width: 100%;" Value="88" />
                    <strong>88</strong>
                </div>
                <div style="display: grid; grid-template-columns: 120px 1fr 44px; align-items: center; gap: 8px;">
                    <span>Flow health</span>
                    <FluentProgressRing Style="width: 100%;" Value="74" />
                    <strong>74</strong>
                </div>
                <div style="display: grid; grid-template-columns: 120px 1fr 44px; align-items: center; gap: 8px;">
                    <span>Blocker risk</span>
                    <FluentProgressRing Style="width: 100%;" Value="42" />
                    <strong>42</strong>
                </div>
            </div>
            <h4 style="margin-bottom: 8px;">Support metrics</h4>
            <ul style="margin: 0 0 0 16px; color: #50657a;">
                <li>Reliability: 87%</li>
                <li>Carryover: 13%</li>
                <li>Blocked median: 0.8 day</li>
            </ul>
        </FluentCard>
    </div>
</div>
