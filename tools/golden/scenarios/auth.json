{
  "name": "auth",
  "description": "The worked example. Auth and View As across four roles plus anonymous, with the refusal and validation cases that make authorization behaviour rather than decoration. Run `scaffold` for the other controllers and fill them in this shape.",
  "bind": {},
  "steps": [
    {
      "id": "login.orgadmin",
      "endpoint": "POST /auth/login",
      "as": "anonymous",
      "kind": "success",
      "expect": 200,
      "body": {
        "email": "{{orgAdminEmail}}",
        "password": "{{orgAdminPassword}}"
      },
      "unstable": [
        "body.expiresInSeconds"
      ],
      "note": "The token needs no unstable declaration \u2014 it is redacted, so its presence stays pinned. What matters here is requiresPasswordChange and the user summary around it."
    },
    {
      "id": "login.wrong-password",
      "endpoint": "POST /auth/login",
      "as": "anonymous",
      "kind": "denied",
      "expect": 401,
      "body": {
        "email": "{{orgAdminEmail}}",
        "password": "not-the-password"
      },
      "note": "Must not distinguish a bad password from an unknown email \u2014 see SPEC/20-feature-auth."
    },
    {
      "id": "login.missing-email",
      "endpoint": "POST /auth/login",
      "as": "anonymous",
      "kind": "invalid",
      "expect": 400,
      "body": {
        "password": "irrelevant"
      }
    },
    {
      "id": "me.siteadmin",
      "endpoint": "GET /auth/me",
      "as": "SiteAdmin",
      "kind": "success",
      "expect": 200
    },
    {
      "id": "me.orgadmin",
      "endpoint": "GET /auth/me",
      "as": "OrgAdmin",
      "kind": "success",
      "expect": 200
    },
    {
      "id": "me.user",
      "endpoint": "GET /auth/me",
      "as": "User",
      "kind": "success",
      "expect": 200
    },
    {
      "id": "me.readonly",
      "endpoint": "GET /auth/me",
      "as": "ReadOnly",
      "kind": "success",
      "expect": 200
    },
    {
      "id": "me.anonymous",
      "endpoint": "GET /auth/me",
      "as": "anonymous",
      "kind": "denied",
      "expect": 401
    },
    {
      "id": "me.update",
      "endpoint": "PUT /auth/me",
      "as": "User",
      "kind": "success",
      "expect": 200,
      "body": {
        "firstName": "Golden",
        "lastName": "Capture"
      },
      "note": "Mutating: the corpus is order-dependent and both capture and replay start from a fresh seed."
    },
    {
      "id": "me.update.invalid",
      "endpoint": "PUT /auth/me",
      "as": "User",
      "kind": "invalid",
      "expect": 400,
      "body": {
        "firstName": "",
        "lastName": "Capture"
      }
    },
    {
      "id": "viewas.candidates.siteadmin",
      "endpoint": "GET /auth/view-as/candidates",
      "as": "SiteAdmin",
      "kind": "success",
      "expect": 200,
      "bind": {
        "targetUserId": "$.body[0].userId"
      },
      "note": "Binds the first candidate for the start step below."
    },
    {
      "id": "viewas.candidates.user",
      "endpoint": "GET /auth/view-as/candidates",
      "as": "User",
      "kind": "denied",
      "expect": 403,
      "note": "A member cannot act as anyone. Rule 25, SPEC/20-feature-view-as.md."
    },
    {
      "id": "viewas.start",
      "endpoint": "POST /auth/view-as",
      "as": "SiteAdmin",
      "kind": "success",
      "expect": 200,
      "body": {
        "targetUserId": "{{targetUserId}}"
      },
      "unstable": [
        "body.startedAtUtc",
        "body.expiresAtUtc"
      ],
      "note": "Both identities come back inline so the banner needs no follow-up GET /auth/me."
    },
    {
      "id": "viewas.start.missing-target",
      "endpoint": "POST /auth/view-as",
      "as": "SiteAdmin",
      "kind": "invalid",
      "expect": 400,
      "body": {},
      "note": "A missing target is 400, not the 404 an empty Guid used to produce."
    },
    {
      "id": "viewas.end",
      "endpoint": "DELETE /auth/view-as",
      "as": "SiteAdmin",
      "kind": "success",
      "expect": 204,
      "note": "Ends the session started above; leave it last so later scenarios are not impersonating."
    },
    {
      "id": "viewas.start.anonymous",
      "endpoint": "POST /auth/view-as",
      "as": "anonymous",
      "kind": "denied",
      "expect": 401,
      "body": {
        "targetUserId": "{{targetUserId}}"
      }
    }
  ]
}
