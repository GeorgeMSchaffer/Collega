{
  "name": "organizations",
  "description": "Organization administration \u2014 the Site Admin's bootstrap surface.",
  "bind": {},
  "steps": [
    {
      "id": "org",
      "endpoint": "GET /auth/me",
      "as": "OrgAdmin",
      "kind": "success",
      "expect": 200,
      "note": "Binds this organization for the steps below; ids are per-seed.",
      "bind": {
        "orgId": "$.body.organizationId"
      }
    },
    {
      "id": "list.siteadmin",
      "endpoint": "GET /organizations",
      "as": "SiteAdmin",
      "kind": "success",
      "expect": 200,
      "note": "Only a Site Admin sees across organizations."
    },
    {
      "id": "list.orgadmin",
      "endpoint": "GET /organizations",
      "as": "OrgAdmin",
      "kind": "denied",
      "expect": 403,
      "note": "Only a Site Admin sees across organizations."
    },
    {
      "id": "list.user",
      "endpoint": "GET /organizations",
      "as": "User",
      "kind": "denied",
      "expect": 403,
      "note": "Only a Site Admin sees across organizations."
    },
    {
      "id": "list.readonly",
      "endpoint": "GET /organizations",
      "as": "ReadOnly",
      "kind": "denied",
      "expect": 403,
      "note": "Only a Site Admin sees across organizations."
    },
    {
      "id": "list.anonymous",
      "endpoint": "GET /organizations",
      "as": "anonymous",
      "kind": "denied",
      "expect": 401,
      "note": "Only a Site Admin sees across organizations."
    },
    {
      "id": "create.orgadmin",
      "endpoint": "POST /organizations",
      "as": "OrgAdmin",
      "kind": "denied",
      "expect": 403,
      "body": {
        "title": "Zz Golden Capture Org",
        "description": "Created by the golden capture."
      },
      "note": "Refusals first, so exactly one organization is created. Named to sort last."
    },
    {
      "id": "create.user",
      "endpoint": "POST /organizations",
      "as": "User",
      "kind": "denied",
      "expect": 403,
      "body": {
        "title": "Zz Golden Capture Org",
        "description": "Created by the golden capture."
      },
      "note": "Refusals first, so exactly one organization is created. Named to sort last."
    },
    {
      "id": "create.readonly",
      "endpoint": "POST /organizations",
      "as": "ReadOnly",
      "kind": "denied",
      "expect": 403,
      "body": {
        "title": "Zz Golden Capture Org",
        "description": "Created by the golden capture."
      },
      "note": "Refusals first, so exactly one organization is created. Named to sort last."
    },
    {
      "id": "create.anonymous",
      "endpoint": "POST /organizations",
      "as": "anonymous",
      "kind": "denied",
      "expect": 401,
      "body": {
        "title": "Zz Golden Capture Org",
        "description": "Created by the golden capture."
      },
      "note": "Refusals first, so exactly one organization is created. Named to sort last."
    },
    {
      "id": "create.siteadmin",
      "endpoint": "POST /organizations",
      "as": "SiteAdmin",
      "kind": "success",
      "expect": 201,
      "body": {
        "title": "Zz Golden Capture Org",
        "description": "Created by the golden capture."
      },
      "note": "Refusals first, so exactly one organization is created. Named to sort last.",
      "bind": {
        "newOrgId": "$.body.organizationId"
      }
    },
    {
      "id": "get.siteadmin",
      "endpoint": "GET /organizations/{organizationId}",
      "as": "SiteAdmin",
      "kind": "success",
      "expect": 200,
      "path": "/organizations/{{orgId}}",
      "note": "Administrators only \u2014 the record carries the invite code, which is why the corpus redacts it."
    },
    {
      "id": "get.orgadmin",
      "endpoint": "GET /organizations/{organizationId}",
      "as": "OrgAdmin",
      "kind": "success",
      "expect": 200,
      "path": "/organizations/{{orgId}}",
      "note": "Administrators only \u2014 the record carries the invite code, which is why the corpus redacts it.",
      "bind": {
        "inviteCode": "$.body.inviteCode"
      }
    },
    {
      "id": "get.user",
      "endpoint": "GET /organizations/{organizationId}",
      "as": "User",
      "kind": "denied",
      "expect": 403,
      "path": "/organizations/{{orgId}}",
      "note": "Administrators only \u2014 the record carries the invite code, which is why the corpus redacts it."
    },
    {
      "id": "get.readonly",
      "endpoint": "GET /organizations/{organizationId}",
      "as": "ReadOnly",
      "kind": "denied",
      "expect": 403,
      "path": "/organizations/{{orgId}}",
      "note": "Administrators only \u2014 the record carries the invite code, which is why the corpus redacts it."
