      "kind": "denied",
      "expect": 401,
      "path": "/organizations/{{newOrgId}}",
      "body": {
        "title": "Zz Golden Capture Org Renamed",
        "description": "Edited by the golden capture."
      },
      "note": "Against the organization this scenario created, never a seeded one."
    },
    {
      "id": "update.siteadmin",
      "endpoint": "PUT /organizations/{organizationId}",
      "as": "SiteAdmin",
      "kind": "success",
      "expect": 200,
      "path": "/organizations/{{newOrgId}}",
      "body": {
        "title": "Zz Golden Capture Org Renamed",
