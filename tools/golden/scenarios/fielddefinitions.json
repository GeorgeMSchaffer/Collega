{
  "name": "fielddefinitions",
  "description": "User-defined fields: the definition catalog and its options.",
  "bind": {},
  "steps": [
    {
      "id": "org",
      "endpoint": "GET /auth/me",
      "as": "OrgAdmin",
      "kind": "success",
      "expect": 200,
      "note": "Binds this organization for the steps below; ids are per-seed.",
      "bind": {
        "orgId": "$.body.organizationId"
      }
    },
    {
      "id": "list.siteadmin",
      "endpoint": "GET /organizations/{organizationId}/field-definitions",
      "as": "SiteAdmin",
      "kind": "success",
      "expect": 200,
      "path": "/organizations/{{orgId}}/field-definitions"
    },
    {
      "id": "list.orgadmin",
      "endpoint": "GET /organizations/{organizationId}/field-definitions",
      "as": "OrgAdmin",
      "kind": "success",
      "expect": 200,
      "path": "/organizations/{{orgId}}/field-definitions",
      "bind": {
        "fieldIds": "$.body[*].fieldDefinitionId"
      }
    },
    {
      "id": "list.user",
      "endpoint": "GET /organizations/{organizationId}/field-definitions",
      "as": "User",
      "kind": "success",
      "expect": 200,
      "path": "/organizations/{{orgId}}/field-definitions"
    },
    {
      "id": "list.readonly",
      "endpoint": "GET /organizations/{organizationId}/field-definitions",
      "as": "ReadOnly",
      "kind": "success",
      "expect": 200,
      "path": "/organizations/{{orgId}}/field-definitions"
    },
    {
      "id": "list.anonymous",
      "endpoint": "GET /organizations/{organizationId}/field-definitions",
      "as": "anonymous",
      "kind": "denied",
      "expect": 401,
      "path": "/organizations/{{orgId}}/field-definitions"
    },
    {
      "id": "create.siteadmin",
      "endpoint": "POST /organizations/{organizationId}/field-definitions",
      "as": "SiteAdmin",
      "kind": "denied",
      "expect": 403,
      "path": "/organizations/{{orgId}}/field-definitions",
      "body": {
        "name": "Golden Capture Field",
        "fieldType": "Text",
        "isRequired": false
      }
    },
    {
      "id": "create.orgadmin",
      "endpoint": "POST /organizations/{organizationId}/field-definitions",
      "as": "OrgAdmin",
      "kind": "success",
      "expect": 201,
      "path": "/organizations/{{orgId}}/field-definitions",
      "body": {
        "name": "Golden Capture Field",
        "fieldType": "Text",
        "isRequired": false
      },
      "bind": {
        "newFieldId": "$.body.fieldDefinitionId"
      }
    },
    {
      "id": "create.user",
      "endpoint": "POST /organizations/{organizationId}/field-definitions",
      "as": "User",
      "kind": "denied",
      "expect": 403,
      "path": "/organizations/{{orgId}}/field-definitions",
      "body": {
        "name": "Golden Capture Field",
        "fieldType": "Text",
        "isRequired": false
      }
    },
    {
      "id": "create.readonly",
      "endpoint": "POST /organizations/{organizationId}/field-definitions",
      "as": "ReadOnly",
      "kind": "denied",
      "expect": 403,
      "path": "/organizations/{{orgId}}/field-definitions",
      "body": {
        "name": "Golden Capture Field",
        "fieldType": "Text",
        "isRequired": false
      }
    },
    {
      "id": "create.anonymous",
      "endpoint": "POST /organizations/{organizationId}/field-definitions",
      "as": "anonymous",
      "kind": "denied",
      "expect": 401,
      "path": "/organizations/{{orgId}}/field-definitions",
      "body": {
        "name": "Golden Capture Field",
        "fieldType": "Text",
        "isRequired": false
      }
    },
    {
      "id": "get.siteadmin",
      "endpoint": "GET /organizations/{organizationId}/field-definitions/{id}",
      "as": "SiteAdmin",
      "kind": "success",
      "expect": 200,
      "path": "/organizations/{{orgId}}/field-definitions/{{newFieldId}}"
    },
    {
      "id": "get.orgadmin",
      "endpoint": "GET /organizations/{organizationId}/field-definitions/{id}",
      "as": "OrgAdmin",
      "kind": "success",
      "expect": 200,
      "path": "/organizations/{{orgId}}/field-definitions/{{newFieldId}}"
    },
    {
      "id": "get.user",
      "endpoint": "GET /organizations/{organizationId}/field-definitions/{id}",
      "as": "User",
      "kind": "success",
      "expect": 200,
      "path": "/organizations/{{orgId}}/field-definitions/{{newFieldId}}"
    },
    {
      "id": "get.readonly",
      "endpoint": "GET /organizations/{organizationId}/field-definitions/{id}",
      "as": "ReadOnly",
      "kind": "success",
      "expect": 200,
      "path": "/organizations/{{orgId}}/field-definitions/{{newFieldId}}"
    },
    {
      "id": "get.anonymous",
      "endpoint": "GET /organizations/{organizationId}/field-definitions/{id}",
      "as": "anonymous",
      "kind": "denied",
      "expect": 401,
      "path": "/organizations/{{orgId}}/field-definitions/{{newFieldId}}"
    },
    {
      "id": "update.siteadmin",
      "endpoint": "PUT /organizations/{organizationId}/field-definitions/{id}",
      "as": "SiteAdmin",
      "kind": "denied",
      "expect": 403,
      "path": "/organizations/{{orgId}}/field-definitions/{{newFieldId}}",
      "body": {
        "name": "Golden Capture Field Renamed",
        "fieldType": "Text",
        "isRequired": true
      }
    },
    {
      "id": "update.orgadmin",
      "endpoint": "PUT /organizations/{organizationId}/field-definitions/{id}",
      "as": "OrgAdmin",
      "kind": "success",
      "expect": 200,
      "path": "/organizations/{{orgId}}/field-definitions/{{newFieldId}}",
      "body": {
        "name": "Golden Capture Field Renamed",
        "fieldType": "Text",
        "isRequired": true
      }
    },
    {
      "id": "update.user",
      "endpoint": "PUT /organizations/{organizationId}/field-definitions/{id}",
      "as": "User",
      "kind": "denied",
      "expect": 403,
      "path": "/organizations/{{orgId}}/field-definitions/{{newFieldId}}",
      "body": {
        "name": "Golden Capture Field Renamed",
        "fieldType": "Text",
        "isRequired": true
      }
    },
    {
      "id": "update.readonly",
      "endpoint": "PUT /organizations/{organizationId}/field-definitions/{id}",
      "as": "ReadOnly",
      "kind": "denied",
      "expect": 403,
      "path": "/organizations/{{orgId}}/field-definitions/{{newFieldId}}",
      "body": {
        "name": "Golden Capture Field Renamed",
        "fieldType": "Text",
        "isRequired": true
      }
    },
    {
      "id": "update.anonymous",
      "endpoint": "PUT /organizations/{organizationId}/field-definitions/{id}",
      "as": "anonymous",
      "kind": "denied",
      "expect": 401,
      "path": "/organizations/{{orgId}}/field-definitions/{{newFieldId}}",
      "body": {
        "name": "Golden Capture Field Renamed",
        "fieldType": "Text",
        "isRequired": true
      }
    },
    {
      "id": "relist",
      "endpoint": "GET /organizations/{organizationId}/field-definitions",
      "as": "OrgAdmin",
      "kind": "success",
      "expect": 200,
      "path": "/organizations/{{orgId}}/field-definitions",
      "note": "Re-read after the create, so the reorder is over a non-empty set.",
      "bind": {
        "fieldIds": "$.body[*].fieldDefinitionId"
      }
    },
    {
      "id": "reorder.siteadmin",
      "endpoint": "PUT /organizations/{organizationId}/field-definitions/reorder",
      "as": "SiteAdmin",
      "kind": "denied",
      "expect": 403,
      "path": "/organizations/{{orgId}}/field-definitions/reorder",
      "body": {
        "orderedIds": "{{fieldIds}}"
      }
    },
    {
      "id": "reorder.orgadmin",
      "endpoint": "PUT /organizations/{organizationId}/field-definitions/reorder",
      "as": "OrgAdmin",
      "kind": "success",
      "expect": 204,
      "path": "/organizations/{{orgId}}/field-definitions/reorder",
      "body": {
        "orderedIds": "{{fieldIds}}"
      }
    },
    {
      "id": "reorder.user",
      "endpoint": "PUT /organizations/{organizationId}/field-definitions/reorder",
      "as": "User",
      "kind": "denied",
      "expect": 403,
      "path": "/organizations/{{orgId}}/field-definitions/reorder",
      "body": {
        "orderedIds": "{{fieldIds}}"
      }
    },
    {
      "id": "reorder.readonly",
      "endpoint": "PUT /organizations/{organizationId}/field-definitions/reorder",
      "as": "ReadOnly",
      "kind": "denied",
      "expect": 403,
      "path": "/organizations/{{orgId}}/field-definitions/reorder",
      "body": {
        "orderedIds": "{{fieldIds}}"
      }
    },
    {
      "id": "reorder.anonymous",
      "endpoint": "PUT /organizations/{organizationId}/field-definitions/reorder",
      "as": "anonymous",
      "kind": "denied",
      "expect": 401,
      "path": "/organizations/{{orgId}}/field-definitions/reorder",
      "body": {
        "orderedIds": "{{fieldIds}}"
      }
    },
    {
      "id": "delete.siteadmin",
      "endpoint": "DELETE /organizations/{organizationId}/field-definitions/{id}",
      "as": "SiteAdmin",
      "kind": "denied",
      "expect": 403,
      "path": "/organizations/{{orgId}}/field-definitions/{{newFieldId}}"
    },
    {
      "id": "delete.orgadmin",
      "endpoint": "DELETE /organizations/{organizationId}/field-definitions/{id}",
      "as": "OrgAdmin",
      "kind": "success",
      "expect": 204,
      "path": "/organizations/{{orgId}}/field-definitions/{{newFieldId}}"
    },
    {
      "id": "delete.user",
      "endpoint": "DELETE /organizations/{organizationId}/field-definitions/{id}",
      "as": "User",
      "kind": "denied",
      "expect": 403,
      "path": "/organizations/{{orgId}}/field-definitions/{{newFieldId}}"
    },
    {
      "id": "delete.readonly",
      "endpoint": "DELETE /organizations/{organizationId}/field-definitions/{id}",
      "as": "ReadOnly",
      "kind": "denied",
      "expect": 403,
      "path": "/organizations/{{orgId}}/field-definitions/{{newFieldId}}"
    },
    {
      "id": "delete.anonymous",
      "endpoint": "DELETE /organizations/{organizationId}/field-definitions/{id}",
      "as": "anonymous",
      "kind": "denied",
      "expect": 401,
      "path": "/organizations/{{orgId}}/field-definitions/{{newFieldId}}"
    }
  ]
}
