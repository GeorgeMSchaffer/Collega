# Editor and OS noise
~$*
*~
.DS_Store
**/.DS_Store

# Local Docker environment (holds the Postgres password)
.env

# Node dependencies, anywhere in the tree.
# This is a pnpm workspace (apps/*, packages/*), so every workspace member gets
# its own node_modules alongside the root one. No leading slash means this matches
# at any depth, which the previous path-by-path rules did not.
# If a vendored dependency ever genuinely must be committed, negate it explicitly
# with a `!` rule rather than deleting this one.
node_modules/

# Turborepo local task cache and logs
.turbo/

# TypeScript incremental build state. Next writes one per app; it is machine-local.
*.tsbuildinfo

# TypeScript workspace build output. Every apps/* and packages/* project compiles to
# dist/ via `tsc -p tsconfig.json`; Next.js writes .next/.
dist/
.next/

# Prisma's generated client. Regenerated from schema.prisma by `pnpm db:generate`;
# committing it means a stale client can disagree with the schema without anyone noticing.
packages/infrastructure/src/generated/

# Biome writes these beside the file it is checking and does not always clean up; the
# boundaries suite runs it inside apps/* and packages/*, so they land in a layer.
_tmp_*

# Scratch dirs tools/boundaries writes inside each layer to probe the lint rules. They are
# cleaned up on exit, but an interrupted run leaks them - and they must live inside the layer
# for biome.json's override globs to match, so they cannot go anywhere tidier.
.boundary-*/

# Transient Claude Code agent worktrees (embedded git repos, never committed)
.claude/worktrees/
.claude/settings.local.json

# graphify derived artifacts (regenerate with `graphify update .`)
graphify-out/
*.graphify-bak

# design-sync build output
ds-bundle/

# Playwright MCP scratch output
.playwright-mcp/

# Local secrets — never commit
.env.local

# Comp Q build toolchain (SPEC/mockups/_build/tw); compiled CSS is inlined into the comps
SPEC/mockups/_build/tw/input.css
SPEC/mockups/_build/tw/out.css
SPEC/mockups/_build/__pycache__

# npm lockfile. This is a pnpm workspace (pnpm-lock.yaml is the tracked lockfile);
# a stray package-lock.json from an accidental `npm install` desyncs the two.
package-lock.json

# design-sync (claude.ai/design) build output and staged scripts
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# `tools/demo-shots` output. Both are generated by one command, and `deck.html` references the
# images by relative path, so committing either without the other leaves a broken page. Eleven
# screenshots is roughly 3.8 MB per capture, and git would keep every capture forever.
demo/screenshots/
demo/deck.html
