## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# .NET build results. Anchored to the .NET tree on purpose: upstream Dotnet.gitignore leaves
# these unanchored, which silently untracks any Node package that ships a bin/, obj/ or logs/
# directory anywhere in the repo.
src/**/[Dd]ebug/
src/**/[Dd]ebugPublic/
src/**/[Rr]elease/
src/**/[Rr]eleases/
src/**/x64/
src/**/x86/
src/**/[Ww][Ii][Nn]32/
src/**/[Aa][Rr][Mm]/
src/**/[Aa][Rr][Mm]64/
src/**/bld/
src/**/[Bb]in/
src/**/[Oo]bj/
src/**/[Ll]og/
src/**/[Ll]ogs/
tests/**/[Dd]ebug/
tests/**/[Dd]ebugPublic/
tests/**/[Rr]elease/
tests/**/[Rr]eleases/
tests/**/x64/
tests/**/x86/
tests/**/[Ww][Ii][Nn]32/
tests/**/[Aa][Rr][Mm]/
tests/**/[Aa][Rr][Mm]64/
tests/**/bld/
tests/**/[Bb]in/
tests/**/[Oo]bj/
tests/**/[Ll]og/
tests/**/[Ll]ogs/
# The one .csproj outside src/ and tests/. Named rather than globbed as tools/**, which
# would put the unanchored-bin/ hazard back over tools/golden.
tools/Collega.AiPlayground/[Bb]in/
tools/Collega.AiPlayground/[Oo]bj/

# Node / TypeScript build results
node_modules/
dist/
.next/
.turbo/
# Anchored to where test output actually lands, not bare: an unanchored `coverage/`
# matches any directory of that name anywhere, and it silently swallowed the route at
# apps/web/app/api/mock/coverage — `git add` skipped it without a word, so the endpoint
# worked in its author's worktree and existed nowhere else. Same trap as the unanchored
# [Bb]in/ patterns above.
/coverage/
apps/*/coverage/
packages/*/coverage/
*.tsbuildinfo
.eslintcache

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Local Docker environment (contains SA password)
.env
# macOS Finder metadata (anywhere in the tree)
.DS_Store
**/.DS_Store

# Transient Claude Code agent worktrees (embedded git repos, never committed)
.claude/worktrees/
/e2e/node_modules

# Local deploy staging dirs from SPEC/50-azure-deployment.md §5.3 and §6.2. CI publishes to the
# same names, but running those steps by hand drops a full build output at the repo root.
/publish/
/client-publish/
/collega-api.zip

# Filled-in deployment inputs for deploy/azure/provision.sh — holds the database,
# Site Admin and AI credentials. Only the .example copy is tracked.
/deploy/azure/provision.env

# graphify derived artifacts (regenerate with `graphify update .`)
graphify-out/
*.graphify-bak

# design-sync build output
ds-bundle/

# Playwright MCP scratch output
.playwright-mcp/

# Local secrets — never commit
.env.local

# Comp Q build toolchain (SPEC/mockups/_build/tw); compiled CSS is inlined into the comps
SPEC/mockups/_build/tw/node_modules
SPEC/mockups/_build/tw/input.css
SPEC/mockups/_build/tw/out.css
SPEC/mockups/_build/__pycache__

# Golden harness: typecheck-only dependency, the harness itself runs on bare Node
tools/golden/node_modules

# Proxy CA certificates are environment-specific (see docker/proxy-ca/README.md)
docker/proxy-ca/*.crt
