{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "db:generate"
      ],
      "outputs": [
        "dist/**",
        "out/**"
      ]
    },
    "@collega/web#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build",
        "db:generate"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "collega-e2e#test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "playwright-report/**",
        "test-results/**"
      ],
      "cache": false,
      "passThroughEnv": [
        "CI",
        "PLAYWRIGHT_BROWSERS_PATH",
        "PLAYWRIGHT_CHROMIUM_PATH"
      ]
    },
    "db:generate": {
      "outputs": [
        "src/generated/**"
      ],
      "inputs": [
        "prisma/schema.prisma"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "^build",
        "db:generate"
      ]
    },
    "@collega/boundaries#test": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "outputs": []
    },
    "@collega/infrastructure#test": {
      "dependsOn": [
        "^build",
        "db:generate"
      ],
      "env": [
        "DATABASE_URL"
      ],
      "outputs": []
    }
  }
}
