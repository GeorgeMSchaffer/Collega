{
  "name": "@collega/design-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Tokens and primitives from comp P, on Tailwind v4 + shadcn/ui. The only package apps/web may import.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./globals.css": "./src/globals.css",
    "./*": {
      "types": "./dist/*/index.d.ts",
      "default": "./dist/*/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "react": "19.2.8",
    "typescript": "7.0.2",
    "vitest": "3.2.4"
  }
}
