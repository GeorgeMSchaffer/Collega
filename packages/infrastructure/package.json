{
  "name": "@collega/infrastructure",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Prisma client, repositories and external integrations. Implements application and domain abstractions.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "default": "./dist/*/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@collega/domain": "workspace:*",
    "@collega/application": "workspace:*"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "3.2.4"
  }
}
