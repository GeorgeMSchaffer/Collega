{
  "name": "@collega/infrastructure",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Prisma client, repositories and external integrations. Implements application and domain abstractions.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "default": "./dist/*/index.js"
    }
  },
  "scripts": {
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/generated','dist/generated',{recursive:true})\"",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "db:pull": "prisma db pull --schema prisma/schema.prisma",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "node prisma/seed/index.ts",
    "db:check-enums": "node prisma/check-enums.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@collega/application": "workspace:*",
    "@collega/domain": "workspace:*",
    "@prisma/client": "^6.19.3",
    "csv-parse": "^7.0.2",
    "jsonwebtoken": "^9.0.3",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "prisma": "^6.19.3",
    "typescript": "7.0.2",
    "vitest": "3.2.4"
  }
}
