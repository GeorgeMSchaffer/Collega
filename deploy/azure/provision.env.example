# Copy to provision.env (gitignored) and fill in. Consumed by provision.sh.
# Everything here is a deployment input; treat the filled-in copy as a secret file.

# --- naming and location -------------------------------------------------
LOC=eastus                  # App Service + PostgreSQL region (keep them together)
SWA_LOC=eastus2             # Static Web Apps supports only a few regions; eastus is NOT one
RG=collega-rg

PG_SERVER=collega-pg-0001   # globally unique -> <PG_SERVER>.postgres.database.azure.com
PG_DB=collega
PG_ADMIN=collegaadmin

API_PLAN=collega-plan
API_APP=collega-api-0001    # globally unique -> https://<API_APP>.azurewebsites.net
API_SKU=B1                  # B1 (~$13/mo) or F1 (free, non-production)

SWA_NAME=collega-web

# --- secrets -------------------------------------------------------------
PG_PASSWORD='CHANGE-ME'                 # 8+ chars, upper/lower/digit/symbol
SITEADMIN_EMAIL='admin@yourdomain.com'  # seed Site Admin login
SITEADMIN_PASSWORD='CHANGE-ME'          # forced to change on first login

# Optional. Absent is supported: AI idea assist runs dark without it.
ANTHROPIC_API_KEY=''
