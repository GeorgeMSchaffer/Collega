<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <p role="alert">Sorry, there's nothing at this address.</p>
        </LayoutView>
    </NotFound>
</Router>

@*
    Fluent UI Blazor design theme + providers, mounted once at the app root so they
    apply across both MainLayout and AuthLayout. CustomColor pins Fluent's accent to
    the locked comp's indigo (#5b5fc7); component-level look is finished in app.css.
    The providers give later CRUD pages a working substrate (toasts, dialogs,
    tooltips, message bars, and un-clipped menu/popover rendering).
*@
<FluentDesignTheme Mode="DesignThemeModes.Light" CustomColor="#5b5fc7" StorageName="collega-theme" />
<FluentToastProvider />
<FluentDialogProvider />
<FluentTooltipProvider />
<FluentMessageBarProvider />
<FluentMenuProvider />
