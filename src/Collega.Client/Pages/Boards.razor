@page "/boards"
@attribute [Authorize]
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>Boards · Collega</PageTitle>

@*
    Board list (B2). Boards the signed-in user's organization can access; selecting one opens its
    swim lanes / list view at /board/{id}. Configuration (create/edit) is Org-Admin-only and lives
    under /settings/boards.
*@
<div class="pagehead">
    <div class="crumbs">Boards</div>
    <h1>Boards</h1>
    <p class="sub" style="margin-bottom:18px">Boards you can access. Selecting a board opens its swim lanes.</p>
</div>
<div class="body">
    @if (_loading)
    {
        <div class="loading"><FluentProgressRing /> <span>Loading…</span></div>
    }
    else if (_error is not null)
    {
        <div class="autherror" role="alert">@_error</div>
    }
    else if (_boards.Count == 0)
    {
        <div class="placeholder"><p>No boards yet. An organization admin can create boards under Settings.</p></div>
    }
    else
    {
        <div class="card">
            <table>
                <thead>
                    <tr><th>Board</th><th>Swimlanes</th><th>User status moves</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var b in _boards)
                    {
                        <tr>
                            <td><a href="@($"/board/{b.BoardId}")"><strong>@b.Name</strong></a></td>
                            <td>@b.SwimlaneCount</td>
                            <td>
                                @if (b.AllowUserStatusUpdate)
                                {
                                    <span class="pill ok">Allowed</span>
                                }
                                else
                                {
                                    <span class="pill neutral">Admins only</span>
                                }
                            </td>
                            <td><a class="btn subtle" href="@($"/board/{b.BoardId}")">Open</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private List<BoardListItemDto> _boards = new();
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        string? organizationId = null;
        if (AuthStateTask is not null)
        {
            organizationId = (await AuthStateTask).User.FindFirst("organizationId")?.Value;
        }

        if (string.IsNullOrEmpty(organizationId))
        {
            _error = "Your account isn't associated with an organization.";
            _loading = false;
            return;
        }

        var result = await Api.GetBoardsAsync(organizationId!);
        if (result.Succeeded)
        {
            _boards = result.Value!.OrderBy(b => b.Name).ToList();
        }
        else
        {
            _error = result.Error;
        }

        _loading = false;
    }
}
