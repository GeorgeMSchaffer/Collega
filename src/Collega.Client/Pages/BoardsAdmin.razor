@page "/settings/boards"
@page "/settings/organizations/{OrganizationId}/boards"
@attribute [Authorize(Roles = "OrgAdmin,SiteAdmin")]
@inject ApiClient Api

<PageTitle>Boards · Collega</PageTitle>

@*
    Organization board configuration (T043). Org Admin manages the boards that organize ideas into
    status swimlanes. List here; create/edit (incl. swimlane subset + order) is on BoardEdit.
*@
<div class="pagehead">
    <div class="crumbs"><a href="/settings">Settings</a> / Boards</div>
    <h1>Boards</h1>
    <p class="sub" style="margin-bottom:18px">Configure the boards your organization uses to track ideas.</p>
</div>

<div class="body">
    @if (_loading)
    {
        <div class="loading"><FluentProgressRing /> <span>Loading…</span></div>
    }
    else if (_error is not null)
    {
        <div class="autherror" role="alert">@_error</div>
    }
    else
    {
        <div class="backrow">
            <BackButton />
        </div>
        <div class="cmdbar">
            <ListToolbar TItem="BoardListItemDto" State="_list" Region="ToolbarRegion.Search" Placeholder="Search boards…" OnChanged="StateHasChanged" />
            @if (CanMutate)
            {
                <a class="btn primary" href="@($"{BoardEditBase}/new")" style="margin-left:auto">Add New</a>
            }
        </div>
        <div class="card">
            <table>
                <thead>
                    <tr><th>Board</th><th>Swimlanes</th><th>User status moves</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var b in _list.PageItems)
                    {
                        <tr>
                            <td><strong>@b.Name</strong></td>
                            <td>@b.SwimlaneCount</td>
                            <td>
                                @if (b.AllowUserStatusUpdate)
                                {
                                    <span class="pill ok">Allowed</span>
                                }
                                else
                                {
                                    <span class="pill neutral">Admins only</span>
                                }
                            </td>
                            <td>
                                @if (CanMutate)
                                {
                                    <a class="btn subtle" href="@($"{BoardEditBase}/{b.BoardId}")">Edit</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <ListToolbar TItem="BoardListItemDto" State="_list" Region="ToolbarRegion.Pager" OnChanged="StateHasChanged" />
        @if (_boards.Count == 0)
        {
            <div class="placeholder"><p>No boards yet.</p></div>
        }
        else if (_list.FilteredCount == 0)
        {
            <div class="placeholder"><p>No boards match your search.</p></div>
        }
    }
</div>

@code {
    // Present on the Site-Admin org-scoped route; absent on the Org Admin route (org from the claim).
    [Parameter] public string? OrganizationId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private List<BoardListItemDto> _boards = new();
    private bool _loading = true;
    private string? _error;
    private bool _isSiteAdmin;

    // Site Admin has no direct org-content mutation path: View As is the only one
    // (SPEC/20-feature-client-ui.md -> "Site Admin org-content mutation model"). Boards are org
    // content, so Add New and the per-row Edit link are both withheld — on BOTH routes, since a
    // Site Admin reaches this page via the org-scoped one.
    private bool CanMutate => !_isSiteAdmin;

    private readonly ListState<BoardListItemDto> _list = new()
    {
        SearchText = b => $"{b.Name} {b.SwimlaneCount} swimlanes {(b.AllowUserStatusUpdate ? "Allowed" : "Admins only")}",
    };

    // New/Edit links carry the org when Site-Admin-scoped so BoardEdit targets the right organization.
    private string BoardEditBase => string.IsNullOrEmpty(OrganizationId)
        ? "/settings/boards"
        : $"/settings/organizations/{OrganizationId}/boards";

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            _isSiteAdmin = (await AuthStateTask).User.IsInRole("SiteAdmin");
        }

        string? organizationId = !string.IsNullOrEmpty(OrganizationId)
            ? OrganizationId
            : AuthStateTask is not null ? (await AuthStateTask).User.FindFirst("organizationId")?.Value : null;

        if (string.IsNullOrEmpty(organizationId))
        {
            _error = "Your account isn't associated with an organization.";
            _loading = false;
            return;
        }

        var result = await Api.GetBoardsAsync(organizationId!);
        if (result.Succeeded)
        {
            _boards = result.Value!;
            _list.SetItems(_boards);
        }
        else
        {
            _error = result.Error;
        }

        _loading = false;
    }
}
