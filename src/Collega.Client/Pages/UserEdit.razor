@page "/settings/users/new"
@page "/settings/users/{UserId}"
@attribute [Authorize(Roles = "OrgAdmin")]
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>@(_isNew ? "New user" : "Edit user") · Collega</PageTitle>

@*
    Create / edit a user within the signed-in Org Admin's organization. One component serves both
    /settings/users/new and /settings/users/{id}. New users get an initial password and are forced
    to change it on first login (server behavior). Editing a password is a separate reset action.
*@
<div class="pagehead">
    <div class="crumbs"><a href="/settings">Settings</a> / @(_isNew ? "New user" : "Edit user")</div>
    <h1>@(_isNew ? "New user" : "Edit user")</h1>
</div>

<div class="body">
    @if (_loading)
    {
        <div class="loading"><FluentProgressRing /> <span>Loading…</span></div>
    }
    else
    {
        <div class="card formcard">
            @if (_error is not null)
            {
                <div class="autherror" role="alert">@_error</div>
            }

            <EditForm Model="_model" OnValidSubmit="Save">
                <div class="formrow">
                    <div class="field">
                        <label for="first">First name</label>
                        <FluentTextField id="first" @bind-Value="_model.FirstName" Disabled="_busy" Style="width:100%" />
                    </div>
                    <div class="field">
                        <label for="last">Last name</label>
                        <FluentTextField id="last" @bind-Value="_model.LastName" Disabled="_busy" Style="width:100%" />
                    </div>
                </div>
                <div class="field">
                    <label for="email">Email</label>
                    <FluentTextField id="email" @bind-Value="_model.Email" TextFieldType="TextFieldType.Email" Disabled="_busy" Style="width:100%" />
                </div>
                <div class="formrow">
                    <div class="field">
                        <label for="role">Role</label>
                        <FluentSelect TOption="string" id="role" @bind-Value="_model.Role" Disabled="_busy" Style="width:100%">
                            <FluentOption TOption="string" Value="@("OrgAdmin")">Org Admin</FluentOption>
                            <FluentOption TOption="string" Value="@("User")">User</FluentOption>
                            <FluentOption TOption="string" Value="@("ReadOnly")">Read Only</FluentOption>
                        </FluentSelect>
                    </div>
                    <div class="field">
                        <label for="status">Status</label>
                        <FluentSelect TOption="string" id="status" @bind-Value="_model.Status" Disabled="_busy" Style="width:100%">
                            <FluentOption TOption="string" Value="@("Active")">Active</FluentOption>
                            <FluentOption TOption="string" Value="@("Inactive")">Inactive</FluentOption>
                        </FluentSelect>
                    </div>
                </div>
                @if (_isNew)
                {
                    <div class="field">
                        <label for="pw">Initial password</label>
                        <FluentTextField id="pw" @bind-Value="_model.InitialPassword" TextFieldType="TextFieldType.Password" Disabled="_busy" Style="width:100%" />
                    </div>
                }

                <div class="btnrow">
                    <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Disabled="_busy">
                        @(_busy ? "Saving…" : _isNew ? "Create user" : "Save changes")
                    </FluentButton>
                    <a class="btn" href="/settings">Cancel</a>
                </div>
            </EditForm>
        </div>
    }
</div>

@code {
    [Parameter] public string? UserId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private sealed class FormModel
    {
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public string Email { get; set; } = "";
        public string Role { get; set; } = "User";
        public string Status { get; set; } = "Active";
        public string InitialPassword { get; set; } = "";
    }

    private readonly FormModel _model = new();
    private bool _isNew => string.IsNullOrEmpty(UserId);
    private string? _organizationId;
    private bool _loading;
    private bool _busy;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            _organizationId = (await AuthStateTask).User.FindFirst("organizationId")?.Value;
        }

        if (_isNew)
        {
            return;
        }

        _loading = true;
        var result = await Api.GetUserAsync(UserId!);
        if (result.Succeeded)
        {
            var u = result.Value!;
            _model.FirstName = u.FirstName;
            _model.LastName = u.LastName;
            _model.Email = u.Email;
            _model.Role = u.Role;
            _model.Status = u.Status;
        }
        else
        {
            _error = result.Error;
        }

        _loading = false;
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_model.FirstName) || string.IsNullOrWhiteSpace(_model.LastName) || string.IsNullOrWhiteSpace(_model.Email))
        {
            _error = "First name, last name, and email are required.";
            return;
        }

        if (_isNew && string.IsNullOrWhiteSpace(_model.InitialPassword))
        {
            _error = "An initial password is required for a new user.";
            return;
        }

        _busy = true;
        _error = null;

        bool succeeded;
        string? error;
        if (_isNew)
        {
            if (string.IsNullOrEmpty(_organizationId))
            {
                _error = "Your account isn't associated with an organization.";
                _busy = false;
                return;
            }

            var body = new CreateUserRequestDto(
                _model.FirstName.Trim(), _model.LastName.Trim(), _model.Email.Trim(),
                _model.Role, _model.InitialPassword, _model.Status);
            var r = await Api.CreateUserAsync(_organizationId!, body);
            (succeeded, error) = (r.Succeeded, r.Error);
        }
        else
        {
            var body = new UpdateUserRequestDto(
                _model.FirstName.Trim(), _model.LastName.Trim(), _model.Email.Trim(),
                _model.Role, _model.Status);
            var r = await Api.UpdateUserAsync(UserId!, body);
            (succeeded, error) = (r.Succeeded, r.Error);
        }

        if (succeeded)
        {
            Nav.NavigateTo("/settings");
            return;
        }

        _error = error ?? "Save failed.";
        _busy = false;
    }
}
