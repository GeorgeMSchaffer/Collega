@page "/ideas"
@page "/ideas/{IdeaId}"
@attribute [Authorize]
@implements IDisposable
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>Ideas · Collega</PageTitle>

@*
    Global, cross-board idea list (comp-c-review-07-ideas-list.html). Server-side search + paging via
    GET /organizations/{orgId}/ideas; the All / Created by me / Assigned to me chips map to the scope
    filter. The Idea Type and Idea Status dropdowns filter the loaded page client-side (the list endpoint
    exposes no type/status query params, SPEC/30-Contracts.md), a known limitation over server paging.

    Idea Detail opens in the shared right slide-in IdeaDrawer, and + New idea in the centered
    IdeaCreateModal (SPEC/20-feature-client-ui.md → "Idea Detail Surface", locked 2026-08-10). Drawer open
    state is URL-addressable: /ideas/{id} (bare route) and /ideas?idea={id} both open the drawer; closing
    drops the param.
*@
<div class="pagehead">
    <h1>Ideas</h1>
    <p class="sub" style="margin-bottom:18px">Every idea you created or are assigned to, across all boards.</p>
</div>

<div class="body">
    @if (_noOrg)
    {
        <div class="placeholder">
            <h3>No organization</h3>
            <p>Your account isn't associated with an organization.</p>
        </div>
    }
    else
    {
        @if (!_isSiteAdmin)
        {
            <div class="chipbar">
                <button class="chip @(_scope == "all" ? "on" : null)" @onclick='() => SetScope("all")'>All</button>
                <button class="chip @(_scope == "created" ? "on" : null)" @onclick='() => SetScope("created")'>Created by me</button>
                <button class="chip @(_scope == "assigned" ? "on" : null)" @onclick='() => SetScope("assigned")'>Assigned to me</button>
            </div>
        }
        <div class="cmdbar">
            <input type="text" aria-label="Search ideas by title and text fields" placeholder="Search title & text fields…" value="@_search" @onchange="OnSearchChanged" style="width:280px" />
            @if (!string.IsNullOrWhiteSpace(_search))
            {
                <button class="btn subtle" @onclick="ClearSearch">Clear</button>
            }
            @if (!_isSiteAdmin)
            {
                <div class="listfilters">
                    <select aria-label="Filter by idea type" value="@_typeFilter" @onchange="OnTypeFilterChanged">
                        <option value="">All types</option>
                        @foreach (var t in _ideaTypeNames)
                        {
                            <option value="@t">@t</option>
                        }
                    </select>
                    <select aria-label="Filter by status" value="@_statusFilter" @onchange="OnStatusFilterChanged">
                        <option value="">All statuses</option>
                        @foreach (var s in _statusList)
                        {
                            <option value="@s.StatusId">@s.Name</option>
                        }
                    </select>
                    <input class="tagfilter" type="text" aria-label="Filter by tag" placeholder="Tag…" value="@_tagFilter" @onchange="OnTagFilterChanged" />
                    <select aria-label="Filter by user (created or assigned)" value="@_userFilter" @onchange="OnUserFilterChanged">
                        <option value="">Any user</option>
                        @foreach (var u in _orgUsers)
                        {
                            <option value="@u.UserId">@u.DisplayName</option>
                        }
                    </select>
                </div>
            }
            @if (_fieldDefs.Count > 0)
            {
                <button class="btn subtle" @onclick="() => _showFilters = !_showFilters">
                    @(_showFilters ? "Hide field filters" : "Field filters")@(ActiveFilterCount > 0 ? $" ({ActiveFilterCount})" : "")
                </button>
            }
            @* Site Admins have no organization (and no board picker context here), so idea creation is
               scoped to org members. Read Only cannot create. *@
            @if (!_isReadOnly && !_isSiteAdmin)
            {
                <button class="btn primary" style="margin-left:auto" @onclick="OpenCreate">Add New</button>
            }
        </div>

        @if (_showFilters && _fieldDefs.Count > 0)
        {
            <div class="card" style="margin-bottom:14px">
                <div class="udf-filterbar">
                    @foreach (var f in _fieldDefs)
                    {
                        var st = _fieldFilters[f.FieldDefinitionId];
                        <div class="filt">
                            <label>@f.Name</label>
                            @switch (f.FieldType)
                            {
                                case "Number":
                                    <div class="rangerow">
                                        <input type="number" step="any" placeholder="min" @bind="st.Min" />
                                        <span>–</span>
                                        <input type="number" step="any" placeholder="max" @bind="st.Max" />
                                    </div>
                                    break;
                                case "Date":
                                    <div class="rangerow">
                                        <input type="date" value="@st.From" @onchange="e => st.From = e.Value?.ToString()" />
                                        <span>–</span>
                                        <input type="date" value="@st.To" @onchange="e => st.To = e.Value?.ToString()" />
                                    </div>
                                    break;
                                case "Boolean":
                                    <select @bind="st.Bool">
                                        <option value="">Any</option>
                                        <option value="true">Yes</option>
                                        <option value="false">No</option>
                                    </select>
                                    break;
                                case "Dropdown":
                                case "MultiSelect":
                                    <select @bind="st.Option">
                                        <option value="">Any</option>
                                        @foreach (var o in f.Options.OrderBy(o => o.DisplayOrder))
                                        {
                                            <option value="@o.OptionId">@o.Label</option>
                                        }
                                    </select>
                                    break;
                                default:
                                    <input type="text" placeholder="contains…" @bind="st.Text" />
                                    break;
                            }
                        </div>
                    }
                </div>
                <div class="btnrow" style="margin-top:10px">
                    <button class="btn primary" @onclick="ApplyFilters">Apply filters</button>
                    @if (ActiveFilterCount > 0)
                    {
                        <button class="btn subtle" @onclick="ClearFilters">Clear filters</button>
                    }
                </div>
            </div>
        }

        @if (_loading)
        {
            <div class="loading"><FluentProgressRing /> <span>Loading…</span></div>
        }
        else if (_error is not null)
        {
            <div class="autherror" role="alert">@_error</div>
        }
        else if (FilteredItems.Count == 0)
        {
            <div class="emptystate">
                <h3>No ideas match this filter</h3>
                <p>Try a different filter, or clear the search.</p>
            </div>
        }
        else
        {
            <div class="card">
                <table>
                    <thead>
                        @if (_isSiteAdmin)
                        {
                            <tr><th>Title</th><th>Organization</th><th>Idea Type</th><th>Created By</th><th>Assigned To</th><th>Status</th><th>Created</th><th></th></tr>
                        }
                        else
                        {
                            <tr>
                                <th class="sortable @SortClass("title")" @onclick='() => Sort("title")' aria-sort="@AriaSort("title")">Title<span class="sortind">@SortIndicator("title")</span></th>
                                <th>Idea Type</th>
                                <th class="sortable @SortClass("createdBy")" @onclick='() => Sort("createdBy")' aria-sort="@AriaSort("createdBy")">Created By<span class="sortind">@SortIndicator("createdBy")</span></th>
                                <th class="sortable @SortClass("assignedTo")" @onclick='() => Sort("assignedTo")' aria-sort="@AriaSort("assignedTo")">Assigned To<span class="sortind">@SortIndicator("assignedTo")</span></th>
                                <th class="sortable @SortClass("status")" @onclick='() => Sort("status")' aria-sort="@AriaSort("status")">Status<span class="sortind">@SortIndicator("status")</span></th>
                                <th class="sortable @SortClass("createdAt")" @onclick='() => Sort("createdAt")' aria-sort="@AriaSort("createdAt")">Created<span class="sortind">@SortIndicator("createdAt")</span></th>
                                <th></th>
                            </tr>
                        }
                    </thead>
                    <tbody>
                        @foreach (var idea in FilteredItems)
                        {
                            <tr class="@(idea.IdeaId == _openIdeaId ? "selected" : null)">
                                <td>
                                    @* The title opens the same drawer as the row's Details button. A
                                       real <button> rather than a click handler on the <div> so it is
                                       reachable by keyboard and announced as an action. *@
                                    <button type="button" class="t" @onclick="() => OpenDrawer(idea.IdeaId)">@idea.Title</button>
                                    <div class="board">@BoardName(idea.BoardId)</div>
                                </td>
                                @if (_isSiteAdmin)
                                {
                                    <td>@OrganizationName(idea.BoardId)</td>
                                }
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(idea.IdeaTypeName))
                                    {
                                        <TypeBadge Name="@idea.IdeaTypeName" ColorHex="@idea.IdeaTypeColorHex" Icon="@idea.IdeaTypeIcon" />
                                    }
                                    else
                                    {
                                        <span class="muted">—</span>
                                    }
                                </td>
                                <td>@AuthorName(idea.AuthorUserId)</td>
                                <td>
                                    @if (idea.Assignees.Count == 0)
                                    {
                                        <span class="muted">—</span>
                                    }
                                    else
                                    {
                                        @string.Join(", ", idea.Assignees.Select(a => a.DisplayName))
                                    }
                                </td>
                                <td><span class="statusdot"><span class="d" style="background:@StatusColor(idea.StatusId)"></span>@idea.StatusName</span></td>
                                <td>@idea.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")</td>
                                <td><button class="btn subtle" @onclick="() => OpenDrawer(idea.IdeaId)">Details</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="pager">
                <span class="info">Showing @RangeStart–@RangeEnd of @_total</span>
                <span class="sizesel">
                    Rows per page
                    <select aria-label="Rows per page" value="@_pageSize" @onchange="OnPageSizeChanged">
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="250">250</option>
                    </select>
                </span>
                <span class="navbtns">
                    <button @onclick="PrevPage" disabled="@(_page <= 1)">‹ Previous</button>
                    <button @onclick="NextPage" disabled="@(_page >= TotalPages)">Next ›</button>
                </span>
            </div>
        }
    }
</div>

<IdeaDrawer IdeaId="@_openIdeaId" OnClose="CloseDrawer" OnChanged="OnDrawerChanged" />
<IdeaBrainstormModal Open="_showBrainstorm" BoardId="@_assistBoardId" OrganizationId="@_organizationId"
                     OnCancel="CloseBrainstorm" OnComplete="OnBrainstormComplete" />
<IdeaCreateModal Open="_showCreate" BoardId="@_createBoardId" InitialDraft="@_seedDraft" OnCancel="CloseCreate" OnCreated="OnIdeaCreated" />

@code {
    [Parameter] public string? IdeaId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private string? _organizationId;
    private bool _noOrg;
    private bool _isSiteAdmin;
    private bool _isReadOnly;
    private readonly List<string> _siteAdminOrganizationIds = new();

    private readonly List<IdeaListItemDto> _items = new();
    private int _total;
    private int _page = 1;
    private int _pageSize = 25;
    private string _scope = "all";
    private string _search = "";

    private bool _loading = true;
    private string? _error;

    // Idea Type + Status dropdown filters (T-UI-2). Applied client-side over the current page since the
    // org ideas list endpoint has no type/status query params (SPEC/30-Contracts.md).
    private IReadOnlyList<string> _ideaTypeNames = Array.Empty<string>();
    private IReadOnlyList<StatusItemDto> _statusList = Array.Empty<StatusItemDto>();
    private string _typeFilter = "";
    private string _statusFilter = "";

    // Server-side tag / user-association filters and column sort (Sprint 3, SPEC/30-Contracts.md org
    // ideas route). tag = normalized tag name; user = a member's UserId (authored OR assigned).
    private string _tagFilter = "";
    private string _userFilter = "";
    private string _sortBy = "createdAt";
    private string _sortDirection = "desc";
    private IReadOnlyList<(string UserId, string DisplayName)> _orgUsers = Array.Empty<(string, string)>();

    // Drawer + create modal state.
    private string? _openIdeaId;
    private bool _showBrainstorm;

    // Page-load snapshot of AI assist availability (rule 32a). Optimistic default: see LoadAiAvailabilityAsync.
    private bool _aiAvailable = true;
    private bool _showCreate;
    private string? _createBoardId;
    private string? _assistBoardId;
    private IdeaDraftDto? _seedDraft;

    private IReadOnlyList<FieldDefinitionDto> _fieldDefs = Array.Empty<FieldDefinitionDto>();
    private readonly Dictionary<string, FieldFilterState> _fieldFilters = new();
    private bool _showFilters;

    private sealed class FieldFilterState
    {
        public string? Text { get; set; }
        public string? Min { get; set; }
        public string? Max { get; set; }
        public string? From { get; set; }
        public string? To { get; set; }
        public string? Bool { get; set; }
        public string? Option { get; set; }
    }

    private readonly Dictionary<string, string> _boardNames = new();
    private readonly Dictionary<string, string> _boardOrganizationIds = new();
    private readonly Dictionary<string, string> _organizationNames = new();
    private readonly Dictionary<string, string> _authorNames = new();
    private readonly Dictionary<string, string> _statusColors = new();

    private List<IdeaListItemDto> FilteredItems => _items
        .Where(i => string.IsNullOrEmpty(_typeFilter) || string.Equals(i.IdeaTypeName, _typeFilter, StringComparison.OrdinalIgnoreCase))
        .Where(i => string.IsNullOrEmpty(_statusFilter) || i.StatusId == _statusFilter)
        .ToList();

    private int TotalPages => _pageSize > 0 ? Math.Max(1, (int)Math.Ceiling(_total / (double)_pageSize)) : 1;
    private int RangeStart => _total == 0 ? 0 : ((_page - 1) * _pageSize) + 1;
    private int RangeEnd => Math.Min(_page * _pageSize, _total);

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;

        if (AuthStateTask is not null)
        {
            var user = (await AuthStateTask).User;
            _organizationId = user.FindFirst("organizationId")?.Value;
            _isSiteAdmin = user.IsInRole("SiteAdmin");
            _isReadOnly = user.IsInRole("ReadOnly");
        }

        await LoadAiAvailabilityAsync();

        if (_isSiteAdmin)
        {
            await InitializeSiteAdminAsync();
            SyncOpenIdeaFromUrl();
            return;
        }

        if (string.IsNullOrEmpty(_organizationId))
        {
            _noOrg = true;
            _loading = false;
            return;
        }

        var boards = await Api.GetBoardsAsync(_organizationId!);
        if (boards.Succeeded)
        {
            foreach (var b in boards.Value!)
            {
                _boardNames[b.BoardId] = b.Name;
            }
        }

        var statuses = await Api.GetStatusesAsync(_organizationId!);
        if (statuses.Succeeded)
        {
            _statusList = statuses.Value!;
            foreach (var s in statuses.Value!)
            {
                _statusColors[s.StatusId] = s.Color;
            }
        }

        var types = await Api.GetIdeaTypesAsync(_organizationId!);
        if (types.Succeeded)
        {
            _ideaTypeNames = types.Value!.Where(t => !t.IsDeleted).OrderBy(t => t.SortOrder).Select(t => t.Name).ToList();
        }

        var users = await Api.GetOrganizationUsersAsync(_organizationId!);
        if (users.Succeeded)
        {
            foreach (var u in users.Value!.Items)
            {
                _authorNames[u.UserId] = $"{u.FirstName} {u.LastName}".Trim();
            }
            _orgUsers = users.Value!.Items
                .Select(u => (u.UserId, DisplayName: string.IsNullOrWhiteSpace($"{u.FirstName} {u.LastName}".Trim()) ? u.Email : $"{u.FirstName} {u.LastName}".Trim()))
                .OrderBy(u => u.DisplayName, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }

        var fields = await Api.GetActiveFieldDefinitionsAsync(_organizationId!);
        if (fields.Succeeded)
        {
            _fieldDefs = fields.Value!;
            foreach (var f in _fieldDefs)
            {
                _fieldFilters[f.FieldDefinitionId] = new FieldFilterState();
            }
        }

        await LoadAsync();
        SyncOpenIdeaFromUrl();
    }

    protected override void OnParametersSet() => SyncOpenIdeaFromUrl();

    private async Task InitializeSiteAdminAsync()
    {
        var organizations = await Api.GetAllOrganizationsAsync();
        if (!organizations.Succeeded)
        {
            _error = organizations.Error;
            _loading = false;
            return;
        }

        foreach (var organization in organizations.Value!.Where(organization => !organization.IsArchived))
        {
            _siteAdminOrganizationIds.Add(organization.OrganizationId);
            _organizationNames[organization.OrganizationId] = organization.Title;

            var boards = await Api.GetBoardsAsync(organization.OrganizationId);
            if (boards.Succeeded)
            {
                foreach (var board in boards.Value!)
                {
                    _boardNames[board.BoardId] = board.Name;
                    _boardOrganizationIds[board.BoardId] = organization.OrganizationId;
                }
            }

            var statuses = await Api.GetStatusesAsync(organization.OrganizationId);
            if (statuses.Succeeded)
            {
                foreach (var status in statuses.Value!)
                {
                    _statusColors[status.StatusId] = status.Color;
                }
            }

            var users = await Api.GetAllOrganizationUsersAsync(organization.OrganizationId);
            if (users.Succeeded)
            {
                foreach (var user in users.Value!)
                {
                    _authorNames[user.UserId] = $"{user.FirstName} {user.LastName}".Trim();
                }
            }
        }

        await LoadAsync();
    }

    private Dictionary<string, string> BuildFieldFilters()
    {
        var result = new Dictionary<string, string>();
        foreach (var f in _fieldDefs)
        {
            if (!_fieldFilters.TryGetValue(f.FieldDefinitionId, out var st))
            {
                continue;
            }

            string? encoded = f.FieldType switch
            {
                "Number" => string.IsNullOrWhiteSpace(st.Min) && string.IsNullOrWhiteSpace(st.Max)
                    ? null : $"{st.Min?.Trim()}:{st.Max?.Trim()}",
                "Date" => string.IsNullOrWhiteSpace(st.From) && string.IsNullOrWhiteSpace(st.To)
                    ? null : $"{st.From?.Trim()}:{st.To?.Trim()}",
                "Boolean" => string.IsNullOrWhiteSpace(st.Bool) ? null : st.Bool,
                "Dropdown" or "MultiSelect" => string.IsNullOrWhiteSpace(st.Option) ? null : st.Option,
                _ => string.IsNullOrWhiteSpace(st.Text) ? null : st.Text!.Trim(),
            };

            if (encoded is not null)
            {
                result[f.FieldDefinitionId] = encoded;
            }
        }
        return result;
    }

    private int ActiveFilterCount => BuildFieldFilters().Count;

    private async Task ApplyFilters()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task ClearFilters()
    {
        foreach (var st in _fieldFilters.Values)
        {
            st.Text = st.Min = st.Max = st.From = st.To = st.Bool = st.Option = null;
        }
        _page = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        _items.Clear();
        if (_isSiteAdmin)
        {
            var results = await Task.WhenAll(_siteAdminOrganizationIds.Select(organizationId => Api.GetAllOrganizationIdeasAsync(organizationId, _search)));
            var failure = results.FirstOrDefault(result => !result.Succeeded);
            if (failure is not null)
            {
                _error = failure.Error;
            }
            else
            {
                var allItems = results.SelectMany(result => result.Value!).OrderByDescending(idea => idea.CreatedAtUtc).ToList();
                _total = allItems.Count;
                _items.AddRange(allItems.Skip((_page - 1) * _pageSize).Take(_pageSize));
            }

            _loading = false;
            return;
        }

        var result = await Api.GetOrganizationIdeasAsync(
            _organizationId!, _scope, _search, _page, _pageSize, BuildFieldFilters(),
            _tagFilter, _userFilter, _sortBy, _sortDirection);
        if (result.Succeeded)
        {
            _items.AddRange(result.Value!.Items);
            _total = result.Value!.TotalCount;
        }
        else
        {
            _error = result.Error;
        }

        _loading = false;
    }

    private async Task SetScope(string scope)
    {
        if (_scope == scope)
        {
            return;
        }
        _scope = scope;
        _page = 1;
        await LoadAsync();
    }

    private void OnTypeFilterChanged(ChangeEventArgs e) => _typeFilter = e.Value?.ToString() ?? "";

    private void OnStatusFilterChanged(ChangeEventArgs e) => _statusFilter = e.Value?.ToString() ?? "";

    private async Task OnTagFilterChanged(ChangeEventArgs e)
    {
        var next = (e.Value?.ToString() ?? "").Trim();
        if (next == _tagFilter)
        {
            return;
        }
        _tagFilter = next;
        _page = 1;
        await LoadAsync();
    }

    private async Task OnUserFilterChanged(ChangeEventArgs e)
    {
        var next = e.Value?.ToString() ?? "";
        if (next == _userFilter)
        {
            return;
        }
        _userFilter = next;
        _page = 1;
        await LoadAsync();
    }

    // Column-header sort: clicking the active column flips direction, a new column starts ascending.
    // Keys map to the server sortBy values (SPEC/30-Contracts.md org ideas route).
    private async Task Sort(string key)
    {
        if (_sortBy == key)
        {
            _sortDirection = _sortDirection == "asc" ? "desc" : "asc";
        }
        else
        {
            _sortBy = key;
            _sortDirection = "asc";
        }
        _page = 1;
        await LoadAsync();
    }

    private string SortClass(string key) => _sortBy == key ? "sorted" : "";

    private string SortIndicator(string key) =>
        _sortBy != key ? "" : (_sortDirection == "asc" ? "▲" : "▼");

    private string AriaSort(string key) =>
        _sortBy != key ? "none" : (_sortDirection == "asc" ? "ascending" : "descending");

    private async Task OnSearchChanged(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _page = 1;
        await LoadAsync();
    }

    private async Task ClearSearch()
    {
        _search = "";
        _page = 1;
        await LoadAsync();
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size) && size > 0)
        {
            _pageSize = size;
            _page = 1;
            await LoadAsync();
        }
    }

    private async Task PrevPage()
    {
        if (_page > 1)
        {
            _page--;
            await LoadAsync();
        }
    }

    private async Task NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
            await LoadAsync();
        }
    }

    // ---- Drawer + create modal wiring ----

    private void OpenDrawer(string ideaId) =>
        Nav.NavigateTo($"/ideas?idea={Uri.EscapeDataString(ideaId)}");

    private void CloseDrawer() => Nav.NavigateTo("/ideas");

    private async Task OnDrawerChanged(IdeaDetailDto _)
    {
        await LoadAsync();
        StateHasChanged();
    }

    // "Add New" opens the brainstorm chat first; its draft pre-fills the create form. When the
    // assistant is known to be down we skip straight to the form instead of opening a scripted chat
    // the user has to escape from (rule 32a); a mid-session outage is caught by the modal's
    // first-turn bailout (rule 32b), since _aiAvailable is only a page-load snapshot.
    private void OpenCreate()
    {
        _createBoardId = null; // global list: the create surface shows a board picker
        _seedDraft = null;

        if (!_aiAvailable)
        {
            _showCreate = true;
            return;
        }

        // The assist endpoint is board-scoped for authorization and attribution, but retrieval is
        // organization-scoped — so from the global list any board the caller can see yields the same
        // catalog. No board at all means the chat stays scripted, which is a supported state.
        _assistBoardId = _boardNames.Keys.FirstOrDefault();
        _showBrainstorm = true;
    }

    /// <summary>
    /// One cached read per page load (rule 32a) so "Add New" costs no extra round trip. A failed probe
    /// is treated as available: the chat's own 503 path still degrades correctly, whereas assuming
    /// unavailable would silently withhold a working feature over one flaky request.
    /// </summary>
    private async Task LoadAiAvailabilityAsync()
    {
        var result = await Api.GetAiAssistAvailabilityAsync();
        _aiAvailable = !result.Succeeded || (result.Value?.Available ?? true);
    }

    private void CloseBrainstorm() => _showBrainstorm = false;

    private void OnBrainstormComplete(IdeaDraftDto draft)
    {
        _seedDraft = draft;
        _showBrainstorm = false;
        _showCreate = true;
    }

    private void CloseCreate() => _showCreate = false;

    private async Task OnIdeaCreated(IdeaDetailDto? _)
    {
        _showCreate = false;
        await LoadAsync();
        StateHasChanged();
    }

    private void SyncOpenIdeaFromUrl()
    {
        var next = IdeaId ?? GetQueryIdea();
        if (next != _openIdeaId)
        {
            _openIdeaId = next;
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        var previous = _openIdeaId;
        SyncOpenIdeaFromUrl();
        if (previous != _openIdeaId)
        {
            StateHasChanged();
        }
    }

    private string? GetQueryIdea()
    {
        var query = Nav.ToAbsoluteUri(Nav.Uri).Query;
        if (string.IsNullOrEmpty(query))
        {
            return null;
        }
        foreach (var part in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var kv = part.Split('=', 2);
            if (kv.Length == 2 && kv[0].Equals("idea", StringComparison.OrdinalIgnoreCase))
            {
                return Uri.UnescapeDataString(kv[1]);
            }
        }
        return null;
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    private string BoardName(string boardId) =>
        _boardNames.TryGetValue(boardId, out var name) ? name : "";

    private string AuthorName(string userId) =>
        _authorNames.TryGetValue(userId, out var name) && !string.IsNullOrWhiteSpace(name) ? name : "Member";

    private string StatusColor(string statusId) =>
        _statusColors.TryGetValue(statusId, out var color) ? color : "#64748B";

    private string OrganizationName(string boardId) =>
        _boardOrganizationIds.TryGetValue(boardId, out var organizationId)
            && _organizationNames.TryGetValue(organizationId, out var name) ? name : "Organization";
}
