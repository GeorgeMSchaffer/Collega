@page "/change-password"
@layout AuthLayout
@attribute [Authorize]
@inject NavigationManager Nav
@inject ApiClient Api
@inject CollegaAuthStateProvider AuthState

<PageTitle>Change password · Collega</PageTitle>

@*
    Forced first-login password change (auth requirement: the seeded Site Admin and any
    temporary-password account must change it before doing anything else). Calls
    POST /api/v1/auth/change-password; a successful change rotates the security stamp and
    invalidates the current token, so the user is signed out and returned to sign in.
*@
<div class="authwrap">
    <div class="authcard">
        <div class="brand">
            <span class="mark">CG</span>
            <span class="name">Collega</span>
        </div>
        <h1 style="font-size:22px;margin-bottom:6px">Change your password</h1>
        <p class="sub">For security, choose a new password before continuing.</p>

        @if (_error is not null)
        {
            <div class="autherror" role="alert">@_error</div>
        }

        <EditForm Model="this" OnValidSubmit="Submit">
            <div class="field">
                <label for="current">Current password</label>
                <FluentTextField id="current" @bind-Value="_current" TextFieldType="TextFieldType.Password" Disabled="_busy" Style="width:100%" />
            </div>
            <div class="field">
                <label for="new">New password</label>
                <FluentTextField id="new" @bind-Value="_new" TextFieldType="TextFieldType.Password" Disabled="_busy" Style="width:100%" />
            </div>
            <div class="field">
                <label for="confirm">Confirm new password</label>
                <FluentTextField id="confirm" @bind-Value="_confirm" TextFieldType="TextFieldType.Password" Disabled="_busy" Style="width:100%" />
            </div>
            <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Class="authbtn" Disabled="_busy">
                @(_busy ? "Saving…" : "Update password")
            </FluentButton>
        </EditForm>
    </div>
</div>

@code {
    private string? _current;
    private string? _new;
    private string? _confirm;
    private string? _error;
    private bool _busy;

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_current) || string.IsNullOrWhiteSpace(_new))
        {
            _error = "Enter your current and new password.";
            return;
        }

        if (_new != _confirm)
        {
            _error = "The new password and confirmation don't match.";
            return;
        }

        _busy = true;
        _error = null;

        var result = await Api.ChangePasswordAsync(_current!, _new!);
        if (!result.Succeeded)
        {
            _error = result.StatusCode == 401 ? "Your current password is incorrect." : result.Error;
            _busy = false;
            return;
        }

        // The change rotated the security stamp, so the current token is now invalid — sign out and
        // have the user authenticate again with their new password.
        await AuthState.MarkSignedOutAsync();
        Nav.NavigateTo("/login?passwordChanged=true");
    }
}
