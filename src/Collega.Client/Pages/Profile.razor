@page "/settings/profile"
@attribute [Authorize]
@inject NavigationManager Nav
@inject ApiClient Api
@inject CollegaAuthStateProvider AuthState

<PageTitle>Profile · Collega</PageTitle>

<div class="pagehead">
    <div class="crumbs"><a href="/settings">Settings</a> / Profile</div>
    <h1>My Profile</h1>
    <p class="sub" style="margin-bottom:18px">Edit your name and change your password. Email and role are read-only.</p>
</div>
<div class="body">
    @if (_loading)
    {
        <p class="sub">Loading profile...</p>
    }
    else
    {
        <section class="settings-section" aria-labelledby="profile-portrait-heading">
            <h2 id="profile-portrait-heading">Portrait</h2>
            <p class="sub">Upload a GIF, JPEG, or PNG. It is resized to a small thumbnail and shown in place of your initials throughout Collega.</p>

            @if (_portraitMessage is not null)
            {
                <div class="@(_portraitSucceeded ? "authnote" : "autherror")" role="@(_portraitSucceeded ? "status" : "alert")">@_portraitMessage</div>
            }

            <div class="portrait-row">
                <span class="avatar portrait-preview @(HasPortrait ? "has-portrait" : null)" aria-hidden="true">
                    @if (HasPortrait)
                    {
                        <img class="portrait" src="@_portrait" alt="Your portrait" />
                    }
                    else
                    {
                        @Initials
                    }
                </span>
                <div class="portrait-actions">
                    <label class="portrait-upload">
                        <InputFile OnChange="OnPortraitSelectedAsync" accept="image/gif,image/jpeg,image/png" disabled="@_savingPortrait" />
                    </label>
                    @if (HasPortrait)
                    {
                        <FluentButton Appearance="Appearance.Stealth" OnClick="RemovePortraitAsync" Disabled="_savingPortrait">Remove portrait</FluentButton>
                    }
                </div>
            </div>
        </section>

        <section class="settings-section" aria-labelledby="profile-details-heading">
            <h2 id="profile-details-heading">Profile details</h2>
            <p class="sub">Your name appears throughout Collega.</p>

            @if (_profileMessage is not null)
            {
                <div class="@(_profileSucceeded ? "authnote" : "autherror")" role="@(_profileSucceeded ? "status" : "alert")">@_profileMessage</div>
            }

            <EditForm Model="this" OnValidSubmit="SaveProfileAsync" class="settings-form">
                @* Enter submits from here, not from the Fluent button below — see .enter-submit in app.css. *@
                <button type="submit" class="enter-submit" tabindex="-1" aria-hidden="true" disabled="@_savingProfile"></button>
                <div class="field-row">
                    <div class="field">
                        <label for="first-name">First name</label>
                        <FluentTextField id="first-name" AriaLabel="First name" @bind-Value="_firstName" Disabled="_savingProfile" Style="width:100%" />
                    </div>
                    <div class="field">
                        <label for="last-name">Last name</label>
                        <FluentTextField id="last-name" AriaLabel="Last name" @bind-Value="_lastName" Disabled="_savingProfile" Style="width:100%" />
                    </div>
                </div>
                <div class="field-row">
                    <div class="field">
                        <label for="profile-email">Email</label>
                        @* Read-only, but still the username: it is the only account name on the page, so a
                           password manager needs it to know which credential the change-password form below
                           belongs to. *@
                        <FluentTextField id="profile-email" AriaLabel="Email" AutoComplete="username" Value="@_email" ReadOnly="true" Style="width:100%" />
                    </div>
                    <div class="field">
                        <label for="profile-role">Role</label>
                        <FluentTextField id="profile-role" AriaLabel="Role" Value="@_role" ReadOnly="true" Style="width:100%" />
                    </div>
                </div>
                <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Disabled="_savingProfile">
                    @(_savingProfile ? "Saving..." : "Save profile")
                </FluentButton>
            </EditForm>
        </section>

        <section class="settings-section" aria-labelledby="change-password-heading">
            <h2 id="change-password-heading">Change password</h2>
            <p class="sub">After changing your password, sign in again with the new one.</p>

            @if (_passwordError is not null)
            {
                <div class="autherror" role="alert">@_passwordError</div>
            }

            <EditForm Model="this" OnValidSubmit="ChangePasswordAsync" class="settings-form">
                @* Enter submits from here, not from the Fluent button below — see .enter-submit in app.css. *@
                <button type="submit" class="enter-submit" tabindex="-1" aria-hidden="true" disabled="@_savingPassword"></button>
                <div class="field">
                    <label for="current-password">Current password</label>
                    <PasswordField Id="current-password" @bind-Value="_currentPassword" Disabled="_savingPassword" AutoComplete="current-password" />
                </div>
                <div class="field-row">
                    <div class="field">
                        <label for="new-password">New password</label>
                        <PasswordField Id="new-password" @bind-Value="_newPassword" Disabled="_savingPassword" AutoComplete="new-password" />
                    </div>
                    <div class="field">
                        <label for="confirm-password">Confirm new password</label>
                        <PasswordField Id="confirm-password" @bind-Value="_confirmPassword" Disabled="_savingPassword" AutoComplete="new-password" />
                    </div>
                </div>
                <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Disabled="_savingPassword">
                    @(_savingPassword ? "Changing..." : "Change password")
                </FluentButton>
            </EditForm>
        </section>
    }
</div>

@code {
    private bool _loading = true;
    private bool _savingProfile;
    private bool _savingPassword;
    private bool _profileSucceeded;
    private string? _firstName;
    private string? _lastName;
    private string? _email;
    private string? _role;
    private string? _profileMessage;
    private string? _currentPassword;
    private string? _newPassword;
    private string? _confirmPassword;
    private string? _passwordError;
    private string? _portrait;
    private bool _savingPortrait;
    private bool _portraitSucceeded;
    private string? _portraitMessage;

    // Cap the source upload before it reaches the server; the server still re-decodes and resizes.
    private const long MaxPortraitUploadBytes = 8 * 1024 * 1024;

    private bool HasPortrait => !string.IsNullOrEmpty(_portrait);

    private string Initials
    {
        get
        {
            var name = $"{_firstName} {_lastName}".Trim();
            if (string.IsNullOrWhiteSpace(name))
            {
                return "?";
            }

            var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            return parts.Length == 1
                ? parts[0][..1].ToUpperInvariant()
                : (parts[0][..1] + parts[^1][..1]).ToUpperInvariant();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetCurrentUserAsync();
        if (!result.Succeeded)
        {
            _profileMessage = result.Error;
            _loading = false;
            return;
        }

        ApplyUser(result.Value!);
        _loading = false;
    }

    private async Task SaveProfileAsync()
    {
        if (string.IsNullOrWhiteSpace(_firstName) || string.IsNullOrWhiteSpace(_lastName))
        {
            _profileSucceeded = false;
            _profileMessage = "Enter your first and last name.";
            return;
        }

        _savingProfile = true;
        _profileMessage = null;
        var result = await Api.UpdateCurrentUserAsync(_firstName.Trim(), _lastName.Trim());
        _savingProfile = false;
        if (!result.Succeeded)
        {
            _profileSucceeded = false;
            _profileMessage = result.Error;
            return;
        }

        ApplyUser(result.Value!);
        await AuthState.RefreshUserAsync(result.Value!);
        _profileSucceeded = true;
        _profileMessage = "Your profile was updated.";
    }

    private async Task ChangePasswordAsync()
    {
        if (string.IsNullOrWhiteSpace(_currentPassword) || string.IsNullOrWhiteSpace(_newPassword))
        {
            _passwordError = "Enter your current and new password.";
            return;
        }

        if (_newPassword != _confirmPassword)
        {
            _passwordError = "The new password and confirmation don't match.";
            return;
        }

        _savingPassword = true;
        _passwordError = null;
        var result = await Api.ChangePasswordAsync(_currentPassword, _newPassword);
        if (!result.Succeeded)
        {
            _passwordError = result.StatusCode == 401 ? "Your current password is incorrect." : result.Error;
            _savingPassword = false;
            return;
        }

        await AuthState.MarkSignedOutAsync();
        Nav.NavigateTo("/login?passwordChanged=true", replace: true);
    }

    private async Task OnPortraitSelectedAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null)
        {
            return;
        }

        _portraitMessage = null;
        _savingPortrait = true;
        try
        {
            byte[] bytes;
            using (var stream = file.OpenReadStream(MaxPortraitUploadBytes))
            using (var memory = new MemoryStream())
            {
                await stream.CopyToAsync(memory);
                bytes = memory.ToArray();
            }

            var result = await Api.UpdatePortraitAsync(bytes);
            if (!result.Succeeded)
            {
                _portraitSucceeded = false;
                _portraitMessage = result.Error ?? "That image couldn't be uploaded.";
                return;
            }

            ApplyUser(result.Value!);
            await AuthState.RefreshUserAsync(result.Value!);
            _portraitSucceeded = true;
            _portraitMessage = "Your portrait was updated.";
        }
        catch (IOException)
        {
            _portraitSucceeded = false;
            _portraitMessage = $"That file is too large. Choose an image under {MaxPortraitUploadBytes / (1024 * 1024)} MB.";
        }
        finally
        {
            _savingPortrait = false;
        }
    }

    private async Task RemovePortraitAsync()
    {
        _portraitMessage = null;
        _savingPortrait = true;
        var result = await Api.RemovePortraitAsync();
        _savingPortrait = false;
        if (!result.Succeeded)
        {
            _portraitSucceeded = false;
            _portraitMessage = result.Error ?? "The portrait couldn't be removed.";
            return;
        }

        ApplyUser(result.Value!);
        await AuthState.RefreshUserAsync(result.Value!);
        _portraitSucceeded = true;
        _portraitMessage = "Your portrait was removed.";
    }

    private void ApplyUser(UserSummaryDto user)
    {
        _firstName = user.FirstName;
        _lastName = user.LastName;
        _email = user.Email;
        _role = user.Role;
        _portrait = user.PortraitDataUrl;
    }
}
