@page "/settings/statuses"
@page "/settings/organizations/{OrganizationId}/statuses"
@attribute [Authorize(Roles = "OrgAdmin,SiteAdmin")]
@inject ApiClient Api

<PageTitle>Statuses · Collega</PageTitle>

@*
    Organization status configuration (T043). Org Admin manages the status catalog used by boards'
    swimlanes and idea cards: name, color, and catalog sort order. The API enforces the two-active
    floor and the board-reference delete guard; this page mirrors the floor client-side (Delete is
    disabled at two active) and surfaces any server rejection inline.

    List + Drawer (Sprint 2): the list owns selection and manual reorder; a row's Details action opens
    the shared DrawerShell (status detail with an Edit toggle → inline form + footer), and Add New opens
    the shared CreateModalShell. The Site-Admin cross-org view stays read-only with per-org Manage links.
*@
<div class="pagehead">
    <div class="crumbs"><a href="/settings">Settings</a> / Statuses</div>
    <h1>@(_siteAdminGlobal ? "All statuses" : "Statuses")</h1>
    <p class="sub" style="margin-bottom:18px">@(_siteAdminGlobal ? "Workflow statuses across every organization." : "Configure the statuses your boards group ideas by.")</p>
</div>

<div class="body">
    @if (_loading)
    {
        <div class="loading"><FluentProgressRing /> <span>Loading…</span></div>
    }
    else
    {
        <div class="backrow">
            <BackButton />
        </div>
        <div class="cmdbar">
            <ListToolbar TItem="StatusItemDto" State="_list" Region="ToolbarRegion.Search" Placeholder="Search statuses…" OnChanged="StateHasChanged" />
            @if (!_siteAdminGlobal)
            {
                <button class="btn primary" @onclick="StartCreate" disabled="@_overlayOpen" style="margin-left:auto">Add New</button>
            }
        </div>

        @if (_error is not null)
        {
            <div class="autherror" role="alert">@_error</div>
        }

        @if (CanReorder)
        {
            <p class="reorder-hint"><span class="grip"><FluentIcon Value="@(new Icons.Regular.Size20.ReOrderDotsVertical())" aria-hidden="true" /></span> Drag the handle to reorder statuses. Boards and idea cards list statuses in this order.</p>
        }
        else if (!_siteAdminGlobal && _statuses.Count > 1 && !_overlayOpen && !_list.ShowsAllInOrder)
        {
            <p class="reorder-hint">Clear the search and show all statuses on one page to reorder them.</p>
        }

        <div class="card">
            <table>
                <thead>
                    <tr>@if (!_siteAdminGlobal) { <th></th> }<th>Status</th>@if (_siteAdminGlobal) { <th>Organization</th> }<th>Color</th><th>Sort order</th><th></th></tr>
                </thead>
                <tbody>
                    @{ var pageStatuses = _list.PageItems; }
                    @for (var i = 0; i < pageStatuses.Count; i++)
                    {
                        var index = i;
                        var s = pageStatuses[index];
                        <tr class="@RowClass(index)"
                            draggable="@(CanReorder ? "true" : null)"
                            @ondragstart="() => OnDragStart(index)"
                            @ondragover:preventDefault="true"
                            @ondragenter="() => OnDragEnter(index)"
                            @ondrop="() => OnDropAsync(index)"
                            @ondragend="OnDragEnd">
                            @if (!_siteAdminGlobal)
                            {
                                <td class="drag-handle" title="@(CanReorder ? "Drag to reorder" : "Add another status to enable reordering")" aria-hidden="true"><FluentIcon Value="@(new Icons.Regular.Size20.ReOrderDotsVertical())" aria-hidden="true" /></td>
                            }
                            <td>
                                <span class="swatch" style="background:@s.Color"></span>
                                <strong>@s.Name</strong>
                            </td>
                            @if (_siteAdminGlobal)
                            {
                                <td>@OrganizationName(s.OrganizationId)</td>
                            }
                            <td><code>@s.Color</code></td>
                            <td>@s.SortOrder</td>
                            <td class="rowactions">
                                @if (_siteAdminGlobal)
                                {
                                    <a class="btn subtle" href="@($"/settings/organizations/{s.OrganizationId}/statuses")">Manage</a>
                                }
                                else
                                {
                                    <button class="btn subtle" @onclick="() => OpenDetail(s)" disabled="@_overlayOpen">Details</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <ListToolbar TItem="StatusItemDto" State="_list" Region="ToolbarRegion.Pager" OnChanged="StateHasChanged" />
        @if (_statuses.Count == 0)
        {
            <div class="placeholder"><p>No statuses yet.</p></div>
        }
        else if (_list.FilteredCount == 0)
        {
            <div class="placeholder"><p>No statuses match your search.</p></div>
        }
    }
</div>

@* ---- Detail / edit drawer (org-scoped view only) ---- *@
<DrawerShell IsOpen="@(_selected is not null)" OnClose="CloseDrawer"
             Eyebrow="Status" Title="@_selected?.Name"
             FooterContent="@(_drawerEditing ? RenderEditFooter : null)">
    @if (_selected is not null)
    {
        @if (_drawerError is not null)
        {
            <div class="autherror" role="alert">@_drawerError</div>
        }

        @if (!_drawerEditing)
        {
            <div class="detailhead">
                <span class="status"><span class="dot" style="background:@_selected.Color"></span>@_selected.Name</span>
                <button class="btn" @onclick="StartDrawerEdit">Edit status</button>
            </div>

            <div class="facts">
                <div class="fact">
                    <div class="k">Color</div>
                    <div class="v"><span class="swatch" style="background:@_selected.Color"></span><code>@_selected.Color</code></div>
                </div>
                <div class="fact">
                    <div class="k">Sort order</div>
                    <div class="v">@_selected.SortOrder</div>
                </div>
            </div>

            <div class="dangerzone">
                <button class="btn danger" @onclick="DeleteSelected"
                        disabled="@(_busy || _statuses.Count <= 2)"
                        title="@(_statuses.Count <= 2 ? "An organization must keep at least two active statuses." : null)">
                    @(_busy ? "Deleting…" : "Delete status")
                </button>
                @if (_statuses.Count <= 2)
                {
                    <span class="floorhint">An organization must keep at least two active statuses.</span>
                }
            </div>
        }
        else
        {
            <div class="field">
                <label for="edit-name">Name</label>
                <FluentTextField id="edit-name" @bind-Value="_form.Name" Disabled="_busy" Style="width:100%" />
            </div>
            <div class="formrow">
                <div class="field">
                    <label for="edit-color">Color</label>
                    <div class="btnrow">
                        <input type="color" id="edit-color" @bind="_form.Color" disabled="@_busy" style="width:44px;height:32px;padding:0;border:1px solid var(--line);border-radius:4px;background:none" />
                        <code>@_form.Color</code>
                    </div>
                </div>
                <div class="field">
                    <label for="edit-sort">Sort order</label>
                    <input type="number" id="edit-sort" @bind="_form.SortOrder" disabled="@_busy" style="width:100px" />
                </div>
            </div>
        }
    }
</DrawerShell>

@* ---- Create modal (org-scoped view only) ---- *@
<CreateModalShell IsOpen="_showCreate" OnClose="CloseCreate" Eyebrow="New status" Title="Create a status"
                  FooterContent="RenderCreateFooter">
    @if (_createError is not null)
    {
        <div class="autherror" role="alert">@_createError</div>
    }
    <div class="field">
        <label for="create-name">Name</label>
        <FluentTextField id="create-name" @bind-Value="_form.Name" Disabled="_busy" Style="width:100%" />
    </div>
    <div class="formrow">
        <div class="field">
            <label for="create-color">Color</label>
            <div class="btnrow">
                <input type="color" id="create-color" @bind="_form.Color" disabled="@_busy" style="width:44px;height:32px;padding:0;border:1px solid var(--line);border-radius:4px;background:none" />
                <code>@_form.Color</code>
            </div>
        </div>
        <div class="field">
            <label for="create-sort">Sort order</label>
            <input type="number" id="create-sort" @bind="_form.SortOrder" disabled="@_busy" style="width:100px" />
        </div>
    </div>
</CreateModalShell>

@code {
    // Present on the Site-Admin org-scoped route; absent on the Org Admin route (org from the claim).
    [Parameter] public string? OrganizationId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private sealed class FormModel
    {
        public string Name { get; set; } = "";
        public string Color { get; set; } = "#64748B";
        public int SortOrder { get; set; }
    }

    private string? _organizationId;
    private bool _siteAdminGlobal;
    private readonly Dictionary<string, string> _organizationNames = new();
    private List<StatusItemDto> _statuses = new();
    private ListState<StatusItemDto> _list = null!;
    private bool _loading = true;
    private bool _busy;
    private FormModel _form = new();
    private string? _error;

    // Drawer (detail + edit) + create-modal state.
    private StatusItemDto? _selected;
    private bool _drawerEditing;
    private bool _showCreate;
    private string? _drawerError;
    private string? _createError;

    // Drag-reorder state (per-org view only). _dragIndex is the row being dragged; _dragOverIndex is
    // the row currently under the cursor, used to show the insertion indicator.
    private int? _dragIndex;
    private int? _dragOverIndex;

    // A drawer or create modal covers the list; reorder and Add New are gated while one is open.
    private bool _overlayOpen => _selected is not null || _showCreate;

    // Reordering is a per-org action; it's meaningless in the Site-Admin cross-org list, while an overlay
    // is open, or with a single row. The active-status floor (2) already keeps the org list from shrinking
    // below reorderable size.
    private bool CanReorder => !_siteAdminGlobal && !_overlayOpen && _statuses.Count > 1 && _list.ShowsAllInOrder;

    // Edit-mode action bar; passed as the drawer footer only while editing.
    private RenderFragment RenderEditFooter => @<text>
        <button class="btn" @onclick="CancelDrawerEdit" disabled="@_busy">Cancel</button>
        <button class="btn primary" @onclick="SaveEdit" disabled="@_busy">@(_busy ? "Saving…" : "Save")</button>
    </text>;

    // Create-modal action bar, passed as the modal footer.
    private RenderFragment RenderCreateFooter => @<text>
        <button class="btn" @onclick="CloseCreate" disabled="@_busy">Cancel</button>
        <button class="btn primary" @onclick="SaveCreate" disabled="@_busy">@(_busy ? "Creating…" : "Create")</button>
    </text>;

    protected override async Task OnInitializedAsync()
    {
        _list = new ListState<StatusItemDto>
        {
            SearchText = s => $"{s.Name} {OrganizationName(s.OrganizationId)} {s.Color} {s.SortOrder}",
        };

        if (!string.IsNullOrEmpty(OrganizationId))
        {
            _organizationId = OrganizationId;
        }
        else if (AuthStateTask is not null)
        {
            var user = (await AuthStateTask).User;
            _organizationId = user.FindFirst("organizationId")?.Value;
            _siteAdminGlobal = user.IsInRole("SiteAdmin") && string.IsNullOrEmpty(OrganizationId);
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        if (_siteAdminGlobal)
        {
            await LoadGlobalAsync();
            _loading = false;
            return;
        }

        if (string.IsNullOrEmpty(_organizationId))
        {
            _error = "Your account isn't associated with an organization.";
            _loading = false;
            return;
        }

        var result = await Api.GetStatusesAsync(_organizationId!);
        if (result.Succeeded)
        {
            _statuses = result.Value!.OrderBy(s => s.SortOrder).ToList();
            _list.SetItems(_statuses);
        }
        else
        {
            _error = result.Error;
        }

        _loading = false;
    }

    private async Task LoadGlobalAsync()
    {
        var organizations = await Api.GetAllOrganizationsAsync();
        if (!organizations.Succeeded)
        {
            _error = organizations.Error;
            return;
        }

        var activeOrganizations = organizations.Value!.Where(organization => !organization.IsArchived).ToList();
        foreach (var organization in activeOrganizations)
        {
            _organizationNames[organization.OrganizationId] = organization.Title;
        }

        var results = await Task.WhenAll(activeOrganizations.Select(organization => Api.GetStatusesAsync(organization.OrganizationId)));
        var failure = results.FirstOrDefault(result => !result.Succeeded);
        if (failure is not null)
        {
            _error = failure.Error;
            return;
        }

        _statuses = results.SelectMany(result => result.Value!).OrderBy(status => OrganizationName(status.OrganizationId)).ThenBy(status => status.SortOrder).ToList();
        _list.SetItems(_statuses);
    }

    private string OrganizationName(string organizationId) =>
        _organizationNames.TryGetValue(organizationId, out var name) ? name : "Organization";

    // ---- Create modal ----

    private void StartCreate()
    {
        var nextSort = _statuses.Count == 0 ? 10 : _statuses.Max(s => s.SortOrder) + 10;
        _form = new FormModel { SortOrder = nextSort };
        _createError = null;
        _showCreate = true;
    }

    private void CloseCreate()
    {
        if (_busy)
        {
            return;
        }
        _showCreate = false;
        _createError = null;
    }

    private async Task SaveCreate()
    {
        if (string.IsNullOrWhiteSpace(_form.Name))
        {
            _createError = "A status name is required.";
            return;
        }

        _busy = true;
        _createError = null;

        var body = new SaveStatusRequestDto(_form.Name.Trim(), _form.Color, _form.SortOrder);
        var result = await Api.CreateStatusAsync(_organizationId!, body);
        _busy = false;

        if (result.Succeeded)
        {
            _showCreate = false;
            await LoadAsync();
            return;
        }

        _createError = result.Error ?? "Save failed.";
    }

    // ---- Detail / edit drawer ----

    private void OpenDetail(StatusItemDto s)
    {
        _selected = s;
        _drawerEditing = false;
        _drawerError = null;
    }

    private void StartDrawerEdit()
    {
        if (_selected is null)
        {
            return;
        }
        _form = new FormModel { Name = _selected.Name, Color = _selected.Color, SortOrder = _selected.SortOrder };
        _drawerError = null;
        _drawerEditing = true;
    }

    private void CancelDrawerEdit()
    {
        _drawerEditing = false;
        _drawerError = null;
    }

    private void CloseDrawer()
    {
        if (_busy)
        {
            return;
        }
        _selected = null;
        _drawerEditing = false;
        _drawerError = null;
    }

    private async Task SaveEdit()
    {
        if (_selected is null)
        {
            return;
        }
        if (string.IsNullOrWhiteSpace(_form.Name))
        {
            _drawerError = "A status name is required.";
            return;
        }

        _busy = true;
        _drawerError = null;

        var body = new SaveStatusRequestDto(_form.Name.Trim(), _form.Color, _form.SortOrder);
        var result = await Api.UpdateStatusAsync(_selected.StatusId, body);
        _busy = false;

        if (result.Succeeded)
        {
            var selectedId = _selected.StatusId;
            await LoadAsync();
            // Re-resolve the selected row from the reloaded list so the detail view shows saved values.
            _selected = _statuses.FirstOrDefault(s => s.StatusId == selectedId);
            _drawerEditing = false;
            return;
        }

        _drawerError = result.Error ?? "Save failed.";
    }

    private async Task DeleteSelected()
    {
        if (_selected is null)
        {
            return;
        }

        _busy = true;
        _drawerError = null;
        var result = await Api.DeleteStatusAsync(_selected.StatusId);
        _busy = false;

        if (result.Succeeded)
        {
            _selected = null;
            _drawerEditing = false;
            await LoadAsync();
        }
        else
        {
            _drawerError = result.Error;
        }
    }

    // ---- Drag reorder (list) ----

    private string RowClass(int index)
    {
        if (!CanReorder)
        {
            return string.Empty;
        }

        var classes = "reorderable";
        if (_dragIndex == index)
        {
            classes += " dragging";
        }
        else if (_dragOverIndex == index)
        {
            classes += " drag-over";
        }

        return classes;
    }

    private void OnDragStart(int index)
    {
        if (!CanReorder)
        {
            return;
        }

        _dragIndex = index;
        _dragOverIndex = index;
    }

    private void OnDragEnter(int index)
    {
        if (_dragIndex is not null)
        {
            _dragOverIndex = index;
        }
    }

    private void OnDragEnd()
    {
        _dragIndex = null;
        _dragOverIndex = null;
    }

    private async Task OnDropAsync(int index)
    {
        var from = _dragIndex;
        _dragIndex = null;
        _dragOverIndex = null;

        if (from is null || from == index || !CanReorder)
        {
            return;
        }

        // Optimistic local reorder: drop lands the row at the target slot (below the target when moving
        // down, above it when moving up). Persist the new id order; on failure, revert by reloading.
        var moved = _statuses[from.Value];
        _statuses.RemoveAt(from.Value);
        var insertAt = Math.Clamp(index, 0, _statuses.Count);
        _statuses.Insert(insertAt, moved);

        _error = null;
        var body = new ReorderStatusesRequestDto(_statuses.Select(s => s.StatusId).ToList());
        var result = await Api.ReorderStatusesAsync(_organizationId!, body);
        if (result.Succeeded)
        {
            await LoadAsync();
        }
        else
        {
            _error = result.Error ?? "Reorder failed.";
            await LoadAsync();
        }
    }
}
