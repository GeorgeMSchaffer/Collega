@page "/board/{BoardId}"
@attribute [Authorize]
@implements IDisposable
@inject ApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(_board?.Name ?? "Board") · Collega</PageTitle>

@*
    Board detail (B2). Two views over one board's ideas — Swim Lanes (Kanban columns, one per
    status swimlane, default) and List (status-grouped rows) — per the locked Comp C "Flat" comp
    (SPEC/mockups/comp-c-review-06-lockin-v5-final.html). Drag-to-move between lanes posts a status
    change (optimistic, rolled back on failure) when the board allows user moves or the viewer is an
    admin. Business rules live in the API; this component only renders and dispatches calls.
*@
<div class="pagehead">
    <div class="crumbs"><a href="/boards">Boards</a> / @(_board?.Name ?? "…")</div>
    <div class="row">
        <div class="grow">
            <h1>@(_board?.Name ?? "Board")</h1>
            <p class="sub" style="margin-bottom:6px">Ideas organized by status. Drag cards between lanes to move them@(_canMove ? "." : " (moves are restricted to admins on this board).")</p>
        </div>
        @if (_boards.Count > 1)
        {
            <div class="field" style="margin-bottom:14px;min-width:220px">
                <label for="boardpick">Board</label>
                <select id="boardpick" value="@BoardId" @onchange="OnBoardPicked" style="width:100%">
                    @foreach (var b in _boards)
                    {
                        <option value="@b.BoardId">@b.Name</option>
                    }
                </select>
            </div>
        }
        <BackButton />
        @if (CanMutate)
        {
            <button class="btn primary" style="margin-bottom:14px" @onclick="OpenCreate">+ New idea</button>
        }
    </div>
    <div class="viewswitch">
        <a class="@(_view == View.List ? "on" : null)" @onclick="() => _view = View.List" role="button" tabindex="0">List</a>
        <a class="@(_view == View.Swim ? "on" : null)" @onclick="() => _view = View.Swim" role="button" tabindex="0">Swim Lanes</a>
    </div>
</div>

<div class="body">
    @if (_loading)
    {
        <div class="loading"><FluentProgressRing /> <span>Loading…</span></div>
    }
    else if (_error is not null)
    {
        <div class="autherror" role="alert">@_error</div>
    }
    else if (_board is null)
    {
        <div class="placeholder"><p>Board not found.</p></div>
    }
    else
    {
        @if (_moveError is not null)
        {
            <div class="autherror" role="alert">@_moveError</div>
        }

        <div class="cmdbar">
            <input type="text" placeholder="Search title, tag, assignee…" value="@_filter" @oninput="OnFilterInput" style="width:260px" />
            @if (!string.IsNullOrWhiteSpace(_filter))
            {
                <button class="btn subtle" @onclick="() => _filter = string.Empty">Clear</button>
            }
            <span style="margin-left:auto"></span>
            <button class="btn subtle" @onclick="ExportCsv" disabled="@_exporting">@(_exporting ? "Exporting…" : "Export CSV")</button>
            @if (CanMutate)
            {
                <button class="btn subtle" @onclick="() => _showImport = !_showImport">@(_showImport ? "Hide import" : "Import CSV")</button>
            }
        </div>

        @if (_showImport && CanMutate)
        {
            <div class="card formcard" style="margin-bottom:14px">
                <h3 style="font-family: var(--font-sans);font-size:16px;margin-bottom:8px">Import ideas from CSV</h3>
                <p class="sub" style="margin-bottom:10px">
                    Columns: Title, Description, Priority, Idea Type, Business Impact, Status (optional), Due Date (optional), Tags (optional).
                    Idea Type and Business Impact must match an active option by name. Each row creates a new idea. Tip: export first for the exact format.
                </p>
                @if (_importError is not null)
                {
                    <div class="autherror" role="alert">@_importError</div>
                }
                <InputFile OnChange="OnImportFileSelected" accept=".csv" disabled="@_importing" />
                @if (_importing)
                {
                    <div class="loading" style="margin-top:8px"><FluentProgressRing /> <span>Importing…</span></div>
                }
                @if (_importResult is not null)
                {
                    <div class="authnote" role="status" style="margin-top:10px">
                        Imported @_importResult.CreatedCount idea(s)@(_importResult.RejectedCount > 0 ? $", {_importResult.RejectedCount} rejected." : ".")
                    </div>
                    @if (_importResult.RejectedCount > 0)
                    {
                        <div class="card" style="margin-top:8px">
                            <table>
                                <thead><tr><th>Row</th><th>Title</th><th>Problem</th></tr></thead>
                                <tbody>
                                    @foreach (var r in _importResult.Rows.Where(r => r.Outcome == "Rejected"))
                                    {
                                        <tr><td>@r.RowNumber</td><td>@r.Title</td><td>@r.Error</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </div>
        }

        @if (OrderedLanes.Count == 0)
        {
            <div class="placeholder"><p>This board has no swimlanes yet.</p></div>
        }
        else if (_view == View.Swim)
        {
            <div class="klanes">
                @foreach (var sw in OrderedLanes)
                {
                    var lane = sw;
                    var laneIdeas = IdeasFor(lane.StatusId);
                    <div class="klane @(_dragOverStatusId == lane.StatusId ? "dragover" : null)"
                         style="@LaneStyle(lane)"
                         @ondragover:preventDefault="true"
                         @ondragover="() => _dragOverStatusId = lane.StatusId"
                         @ondragleave="() => _dragOverStatusId = null"
                         @ondrop="() => OnDrop(lane.StatusId)">
                        <h3><span class="dot" style="background:@lane.StatusColor"></span><span class="grow">@lane.StatusName</span><span class="cnt">@laneIdeas.Count</span></h3>
                        @if (laneIdeas.Count == 0)
                        {
                            <div class="emptylane">No ideas</div>
                        }
                        else
                        {
                            @foreach (var idea in laneIdeas)
                            {
                                var i = idea;
                                <div class="kcard @(_draggedIdeaId == i.IdeaId ? "dragging" : null)"
                                     style="@CardStyle(lane)"
                                     draggable="@(_canMove ? "true" : "false")"
                                     @ondragstart="() => _draggedIdeaId = i.IdeaId"
                                     @ondragend="() => { _draggedIdeaId = null; _dragOverStatusId = null; }">
                                    <div class="top">
                                        @if (_canMove)
                                        {
                                            <span class="grip" title="Drag to move" role="img" aria-label="Drag to move idea"><FluentIcon Value="@(new Icons.Regular.Size20.ReOrderDotsVertical())" /></span>
                                        }
                                        <span class="t" role="button" tabindex="0" @onclick="() => OpenIdea(i.IdeaId)">@i.Title</span>
                                        @if (!string.IsNullOrWhiteSpace(i.IdeaTypeName))
                                        {
                                            <TypeBadge Name="@i.IdeaTypeName" ColorHex="@i.IdeaTypeColorHex" Icon="@i.IdeaTypeIcon" IconOnly="true" />
                                        }
                                        <span class="prio-chip @PrioClass(i.Priority)">@PrioLabel(i.Priority)</span>
                                    </div>
                                    @if (i.TagNames.Count > 0)
                                    {
                                        <div class="meta2">
                                            @foreach (var tag in i.TagNames.Take(3))
                                            {
                                                <span class="tag">@tag</span>
                                            }
                                            @if (i.TagNames.Count > 3)
                                            {
                                                <span class="tag more">+@(i.TagNames.Count - 3)</span>
                                            }
                                        </div>
                                    }
                                    <div class="meta">
                                        @if (i.Assignees.Count > 0)
                                        {
                                            <span class="avatarstack">
                                                @foreach (var a in i.Assignees.Take(3))
                                                {
                                                    <span class="avatar s @(!string.IsNullOrEmpty(a.PortraitDataUrl) ? "has-portrait" : null)" title="@a.DisplayName">@if (!string.IsNullOrEmpty(a.PortraitDataUrl)){<img class="portrait" src="@a.PortraitDataUrl" alt="@a.DisplayName" />}else{@Initials(a)}</span>
                                                }
                                                @if (i.Assignees.Count > 3)
                                                {
                                                    <span class="avatar s more">+@(i.Assignees.Count - 3)</span>
                                                }
                                            </span>
                                        }
                                        <span class="age">@Age(i.CreatedAtUtc)</span>
                                        <span class="spacer"></span>
                                        @if (i.CommentCount > 0)
                                        {
                                            <span class="cmt-inline" role="img" aria-label="@($"{i.CommentCount} comment{(i.CommentCount == 1 ? "" : "s")}")"><FluentIcon Value="@(new Icons.Regular.Size20.Comment())" /> @i.CommentCount</span>
                                        }
                                        <span class="up @(i.HasUpvoted ? "mine" : null)" role="img" aria-label="@($"{i.UpvoteCount} upvote{(i.UpvoteCount == 1 ? "" : "s")}")"><FluentIcon Value="@(new Icons.Regular.Size20.CaretUp())" /> @i.UpvoteCount</span>
                                    </div>
                                </div>
                            }
                        }
                        @if (CanMutate)
                        {
                            <button class="btn subtle" style="width:100%" @onclick="OpenCreate">+ Add idea</button>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            @foreach (var sw in OrderedLanes)
            {
                var lane = sw;
                var laneIdeas = IdeasFor(lane.StatusId);
                <div class="lanesec">
                    <h2><span class="dot" style="background:@lane.StatusColor"></span>@lane.StatusName <span class="cnt">@laneIdeas.Count @(laneIdeas.Count == 1 ? "idea" : "ideas")</span></h2>
                    @if (laneIdeas.Count == 0)
                    {
                        <div class="placeholder" style="padding:20px"><p style="margin:0">No ideas in this status.</p></div>
                    }
                    else
                    {
                        <div class="card">
                            @foreach (var idea in laneIdeas)
                            {
                                var i = idea;
                                <div class="rowcard" style="@CardStyle(lane)" role="button" tabindex="0" @onclick="() => OpenIdea(i.IdeaId)">
                                    <span class="prio @PrioClass(i.Priority)" title="@PrioLabel(i.Priority) priority"></span>
                                    <span class="t">@i.Title</span>
                                    @if (!string.IsNullOrWhiteSpace(i.IdeaTypeName))
                                    {
                                        <TypeBadge Name="@i.IdeaTypeName" ColorHex="@i.IdeaTypeColorHex" Icon="@i.IdeaTypeIcon" IconOnly="true" />
                                    }
                                    @foreach (var tag in i.TagNames.Take(2))
                                    {
                                        <span class="tag">@tag</span>
                                    }
                                    @if (i.TagNames.Count > 2)
                                    {
                                        <span class="tag more">+@(i.TagNames.Count - 2)</span>
                                    }
                                    @if (i.Assignees.Count > 0)
                                    {
                                        <span class="avatarstack">
                                            @foreach (var a in i.Assignees.Take(3))
                                            {
                                                <span class="avatar s" title="@a.DisplayName">@Initials(a)</span>
                                            }
                                            @if (i.Assignees.Count > 3)
                                            {
                                                <span class="avatar s more">+@(i.Assignees.Count - 3)</span>
                                            }
                                        </span>
                                    }
                                    <span class="age">@Age(i.CreatedAtUtc)</span>
                                    @if (i.CommentCount > 0)
                                    {
                                        <span class="cmt-inline" role="img" aria-label="@($"{i.CommentCount} comment{(i.CommentCount == 1 ? "" : "s")}")"><FluentIcon Value="@(new Icons.Regular.Size20.Comment())" /> @i.CommentCount</span>
                                    }
                                    <span class="up @(i.HasUpvoted ? "mine" : null)" role="img" aria-label="@($"{i.UpvoteCount} upvote{(i.UpvoteCount == 1 ? "" : "s")}")"><FluentIcon Value="@(new Icons.Regular.Size20.CaretUp())" /> @i.UpvoteCount</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        }

        @if (_ideas.Count == 0)
        {
            <div class="placeholder"><p>No ideas on this board yet.@(CanMutate ? " Use “New idea” to add the first one." : "")</p></div>
        }
    }
</div>

<IdeaDrawer IdeaId="@_openIdeaId" OnClose="CloseDrawer" OnChanged="OnDrawerChanged" />
<IdeaCreateModal Open="_showCreate" BoardId="@BoardId" OnCancel="CloseCreate" OnCreated="OnIdeaCreated" />

@code {
    [Parameter] public string BoardId { get; set; } = string.Empty;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private enum View { Swim, List }

    private BoardDetailDto? _board;
    private List<IdeaListItemDto> _ideas = new();
    private List<BoardListItemDto> _boards = new();
    private View _view = View.Swim;
    private string _filter = string.Empty;

    private string? _organizationId;
    private string _role = string.Empty;
    private bool _isAdmin => string.Equals(_role, "OrgAdmin", StringComparison.OrdinalIgnoreCase)
        || string.Equals(_role, "SiteAdmin", StringComparison.OrdinalIgnoreCase);
    private bool _isReadOnly => string.Equals(_role, "ReadOnly", StringComparison.OrdinalIgnoreCase);
    private bool _isSiteAdmin => string.Equals(_role, "SiteAdmin", StringComparison.OrdinalIgnoreCase);

    // Ideas are org content, and a Site Admin's only path to mutating it is View As
    // (SPEC/20-feature-client-ui.md -> "Site Admin org-content mutation model"). Ideas.razor
    // already withholds idea creation from Site Admin for this reason; this board view reached
    // the same content through a different door. Read Only is excluded as before.
    private bool CanMutate => !_isReadOnly && !_isSiteAdmin;
    private bool _canMove => _board is not null && (_board.AllowUserStatusUpdate || _isAdmin) && CanMutate;

    private bool _loading = true;
    private string? _error;
    private string? _moveError;
    private string? _loadedBoardId;

    // Idea detail drawer + create modal (SPEC/20-feature-client-ui.md → "Idea Detail Surface", locked
    // 2026-08-10). The drawer's open state is URL-addressable via ?idea={id} over /board/{BoardId}; the
    // create action opens the shared centered IdeaCreateModal, which loads its own board/org context.
    private string? _openIdeaId;
    private bool _showCreate;

    // CSV export/import (T059/T060)
    private bool _exporting;
    private bool _showImport;
    private bool _importing;
    private string? _importError;
    private IdeaImportResultDto? _importResult;

    // Drag state
    private string? _draggedIdeaId;
    private string? _dragOverStatusId;

    private IReadOnlyList<SwimlaneDetailDto> OrderedLanes =>
        _board is null ? Array.Empty<SwimlaneDetailDto>() : _board.Swimlanes.OrderBy(s => s.Order).ToList();

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;

        if (AuthStateTask is not null)
        {
            var user = (await AuthStateTask).User;
            _organizationId = user.FindFirst("organizationId")?.Value;
            _role = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? string.Empty;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(BoardId) && BoardId != _loadedBoardId)
        {
            await LoadAsync();
        }

        // The drawer's open idea rides on the ?idea= query param over the same /board/{BoardId} route,
        // so a change there re-runs OnParametersSet without reloading the board.
        SyncOpenIdeaFromUrl();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _moveError = null;
        StateHasChanged();

        var boardResult = await Api.GetBoardAsync(BoardId);
        if (!boardResult.Succeeded)
        {
            _error = boardResult.Error;
            _board = null;
            _loading = false;
            _loadedBoardId = BoardId;
            return;
        }
        _board = boardResult.Value;
        if (!string.Equals(_organizationId, _board.OrganizationId, StringComparison.OrdinalIgnoreCase))
        {
            _boards.Clear();
        }
        _organizationId = _board.OrganizationId;

        var ideasResult = await Api.GetBoardIdeasAsync(BoardId);
        if (ideasResult.Succeeded)
        {
            _ideas = ideasResult.Value!.Items.ToList();
        }
        else
        {
            _error = ideasResult.Error;
        }

        // Board picker options (best-effort; a failure here just hides the picker). Idea Type / Business
        // Impact / custom-field options for creating an idea now load inside the IdeaCreateModal.
        if (_boards.Count == 0 && !string.IsNullOrEmpty(_organizationId))
        {
            var boardsResult = await Api.GetBoardsAsync(_organizationId!);
            if (boardsResult.Succeeded)
            {
                _boards = boardsResult.Value!.OrderBy(b => b.Name).ToList();
            }
        }

        _loadedBoardId = BoardId;
        _loading = false;

        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "collega.lastBoardId", BoardId);
        }
        catch (JSException)
        {
            // Persisting the last board is a convenience only; ignore storage failures.
        }
    }

    private void OnBoardPicked(ChangeEventArgs e)
    {
        var id = e.Value?.ToString();
        if (!string.IsNullOrEmpty(id) && id != BoardId)
        {
            Nav.NavigateTo($"/board/{id}");
        }
    }

    private void OnFilterInput(ChangeEventArgs e) => _filter = e.Value?.ToString() ?? string.Empty;

    private List<IdeaListItemDto> IdeasFor(string statusId)
    {
        var f = _filter?.Trim();
        return _ideas
            .Where(i => i.StatusId == statusId)
            .Where(i => string.IsNullOrEmpty(f) || Matches(i, f!))
            .OrderByDescending(i => i.UpvoteCount)
            .ToList();
    }

    private static bool Matches(IdeaListItemDto i, string f)
    {
        if (i.Title.Contains(f, StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }
        if (i.TagNames.Any(t => t.Contains(f, StringComparison.OrdinalIgnoreCase)))
        {
            return true;
        }
        return i.Assignees.Any(a => a.DisplayName.Contains(f, StringComparison.OrdinalIgnoreCase));
    }

    // ---- Idea detail drawer + create modal wiring ----

    // Every idea entry point (List rows and Swim Lane cards) opens the shared drawer over the board by
    // pushing ?idea={id} onto the current /board/{BoardId} route; closing drops the param.
    private void OpenIdea(string ideaId) =>
        Nav.NavigateTo($"/board/{BoardId}?idea={Uri.EscapeDataString(ideaId)}");

    private void CloseDrawer() => Nav.NavigateTo($"/board/{BoardId}");

    // Fired after any drawer mutation (save / status move / upvote / delete). Re-fetch the board's ideas so
    // a status move re-lanes the card behind the still-open drawer, and a delete drops it from its lane.
    private async Task OnDrawerChanged(IdeaDetailDto _)
    {
        var ideasResult = await Api.GetBoardIdeasAsync(BoardId);
        if (ideasResult.Succeeded)
        {
            _ideas = ideasResult.Value!.Items.ToList();
        }
        StateHasChanged();
    }

    private void OpenCreate() => _showCreate = true;

    private void CloseCreate() => _showCreate = false;

    // Create returns to the board on success (no auto-open drawer); reload so the new card appears in its
    // lane with server-resolved fields.
    private async Task OnIdeaCreated(IdeaDetailDto? _)
    {
        _showCreate = false;
        var ideasResult = await Api.GetBoardIdeasAsync(BoardId);
        if (ideasResult.Succeeded)
        {
            _ideas = ideasResult.Value!.Items.ToList();
        }
        StateHasChanged();
    }

    private void SyncOpenIdeaFromUrl()
    {
        var next = GetQueryIdea();
        if (next != _openIdeaId)
        {
            _openIdeaId = next;
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        var previous = _openIdeaId;
        SyncOpenIdeaFromUrl();
        if (previous != _openIdeaId)
        {
            StateHasChanged();
        }
    }

    private string? GetQueryIdea()
    {
        var query = Nav.ToAbsoluteUri(Nav.Uri).Query;
        if (string.IsNullOrEmpty(query))
        {
            return null;
        }
        foreach (var part in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var kv = part.Split('=', 2);
            if (kv.Length == 2 && kv[0].Equals("idea", StringComparison.OrdinalIgnoreCase))
            {
                return Uri.UnescapeDataString(kv[1]);
            }
        }
        return null;
    }

    private async Task ExportCsv()
    {
        _exporting = true;
        _moveError = null;
        var result = await Api.ExportBoardIdeasCsvAsync(BoardId);
        _exporting = false;

        if (!result.Succeeded || result.Value is null)
        {
            _moveError = result.Error ?? "Export failed.";
            return;
        }

        var base64 = Convert.ToBase64String(result.Value);
        await JS.InvokeVoidAsync("collegaDownloadFile", $"{(_board?.Name ?? "ideas")}.csv", "text/csv", base64);
    }

    private async Task OnImportFileSelected(InputFileChangeEventArgs e)
    {
        _importing = true;
        _importError = null;
        _importResult = null;

        try
        {
            var file = e.File;
            // Ideas CSVs are small; 5 MB is a generous ceiling that also guards against a huge upload.
            await using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            buffer.Position = 0;

            var result = await Api.ImportBoardIdeasAsync(BoardId, buffer, file.Name);
            if (!result.Succeeded || result.Value is null)
            {
                _importError = result.Error ?? "Import failed.";
            }
            else
            {
                _importResult = result.Value;
                // Refresh the board so newly imported ideas appear.
                var ideasResult = await Api.GetBoardIdeasAsync(BoardId);
                if (ideasResult.Succeeded)
                {
                    _ideas = ideasResult.Value!.Items.ToList();
                }
            }
        }
        catch (Exception ex)
        {
            _importError = $"Couldn't read the file. {ex.Message}";
        }
        finally
        {
            _importing = false;
        }
    }

    private async Task OnDrop(string targetStatusId)
    {
        var draggedId = _draggedIdeaId;
        _dragOverStatusId = null;
        _draggedIdeaId = null;

        if (!_canMove || string.IsNullOrEmpty(draggedId))
        {
            return;
        }

        var idea = _ideas.FirstOrDefault(i => i.IdeaId == draggedId);
        if (idea is null || idea.StatusId == targetStatusId)
        {
            return;
        }

        var targetLane = OrderedLanes.FirstOrDefault(s => s.StatusId == targetStatusId);
        if (targetLane is null)
        {
            return;
        }

        // Optimistic move: swap the record in place, then reconcile with the server.
        var previous = idea;
        var index = _ideas.IndexOf(idea);
        _ideas[index] = idea with { StatusId = targetLane.StatusId, StatusName = targetLane.StatusName };
        _moveError = null;
        StateHasChanged();

        var result = await Api.ChangeIdeaStatusAsync(draggedId, new ChangeIdeaStatusRequestDto(targetStatusId));
        if (!result.Succeeded)
        {
            _ideas[index] = previous; // rollback
            _moveError = result.Error ?? "Moving the idea failed.";
        }
    }

    private static string PrioClass(string priority) => (priority ?? string.Empty).Trim().ToLowerInvariant() switch
    {
        "critical" => "critical",
        "high" => "high",
        "medium" or "med" => "med",
        "low" => "low",
        _ => "med",
    };

    private static string PrioLabel(string priority)
    {
        if (string.IsNullOrWhiteSpace(priority))
        {
            return "—";
        }
        var p = priority.Trim();
        return char.ToUpperInvariant(p[0]) + p[1..].ToLowerInvariant();
    }

    private static string Initials(IdeaAssigneeDto a)
    {
        var first = string.IsNullOrEmpty(a.FirstName) ? "" : a.FirstName[..1];
        var last = string.IsNullOrEmpty(a.LastName) ? "" : a.LastName[..1];
        var combined = (first + last).ToUpperInvariant();
        if (!string.IsNullOrEmpty(combined))
        {
            return combined;
        }
        return string.IsNullOrEmpty(a.DisplayName) ? "?" : a.DisplayName[..1].ToUpperInvariant();
    }

    private static string Age(DateTime createdUtc)
    {
        var days = (int)Math.Floor((DateTime.UtcNow - createdUtc).TotalDays);
        if (days <= 0)
        {
            return "today";
        }
        return days == 1 ? "1d" : $"{days}d";
    }

    private static string LaneStyle(SwimlaneDetailDto lane) => $"--lc-deep:{lane.StatusColor}";

    private static string CardStyle(SwimlaneDetailDto lane) => $"--lc-deep:{lane.StatusColor}";

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
