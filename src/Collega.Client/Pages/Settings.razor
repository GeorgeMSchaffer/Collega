@page "/settings/organizations"
@attribute [Authorize(Roles = "SiteAdmin")]
@inject ApiClient Api

<PageTitle>Organizations · Collega</PageTitle>

@*
    Dedicated Site Admin organization list. Organization-specific management routes are reached
    from each row; the Settings landing page is owned by SettingsHub.
*@
<div class="pagehead">
    <div class="crumbs"><a href="/settings">Settings</a> / Organizations</div>
    <h1>Organizations</h1>
    <p class="sub" style="margin-bottom:18px">@_subtitle</p>
</div>

<div class="body">
    @if (_loading)
    {
        <div class="loading"><FluentProgressRing /> <span>Loading…</span></div>
    }
    else if (_error is not null)
    {
        <div class="autherror" role="alert">@_error</div>
    }
    else
    {
        <div class="cmdbar"><BackButton /><a class="btn primary" href="/settings/organizations/new">New organization</a></div>
        <div class="card">
            <table>
                <thead>
                    <tr><th>Organization</th><th>Location</th><th>Invite code</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var org in _organizations)
                    {
                        <tr>
                            <td>
                                <div class="row" style="align-items:center;gap:8px">
                                    @if (!string.IsNullOrEmpty(org.LogoThumbnailUrl))
                                    {
                                        <img src="@org.LogoThumbnailUrl" alt="" style="height:24px;max-height:24px" />
                                    }
                                    <strong>@org.Title</strong>
                                </div>
                            </td>
                            <td>@Location(org.City, org.State)</td>
                            <td><code>@org.InviteCode</code></td>
                            <td>
                                @if (org.IsArchived)
                                {
                                    <span class="pill neutral">Archived</span>
                                }
                                else
                                {
                                    <span class="pill ok">Active</span>
                                }
                            </td>
                            <td class="rowactions">
                                <a class="btn subtle" href="@($"/settings/organizations/{org.OrganizationId}/users")">Users</a>
                                <a class="btn subtle" href="@($"/settings/organizations/{org.OrganizationId}/statuses")">Statuses</a>
                                <a class="btn subtle" href="@($"/settings/organizations/{org.OrganizationId}/fields")">Fields</a>
                                <a class="btn subtle" href="@($"/settings/organizations/{org.OrganizationId}")">Edit</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (_organizations.Count == 0)
        {
            <div class="placeholder"><p>No organizations yet.</p></div>
        }
    }
</div>

@code {
    private string _subtitle = "";
    private bool _loading = true;
    private string? _error;
    private IReadOnlyList<OrganizationListItemDto> _organizations = Array.Empty<OrganizationListItemDto>();

    protected override async Task OnInitializedAsync()
    {
        _subtitle = "Manage organizations across the platform.";
        var result = await Api.GetAllOrganizationsAsync();
        if (result.Succeeded)
        {
            _organizations = result.Value!;
        }
        else
        {
            _error = result.Error;
        }

        _loading = false;
    }

    private static string Location(string? city, string? state) =>
        string.Join(", ", new[] { city, state }.Where(s => !string.IsNullOrWhiteSpace(s)));
}
