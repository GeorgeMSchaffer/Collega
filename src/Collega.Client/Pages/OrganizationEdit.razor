@page "/settings/organizations/new"
@page "/settings/organizations/{OrganizationId}"
@attribute [Authorize(Roles = "SiteAdmin")]
@inject ApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(_isNew ? "New organization" : "Edit organization") · Collega</PageTitle>

@*
    Create / edit an organization (Site Admin only — enforced by [Authorize(Roles)] and by the API).
    One component serves both routes: /settings/organizations/new and /settings/organizations/{id}.
*@
<div class="pagehead">
    <div class="crumbs"><a href="/settings">Settings</a> / @(_isNew ? "New organization" : "Edit organization")</div>
    <h1>@(_isNew ? "New organization" : "Edit organization")</h1>
</div>

<div class="body">
    @if (_loading)
    {
        <div class="loading"><FluentProgressRing /> <span>Loading…</span></div>
    }
    else
    {
        <div class="card formcard">
            @if (_error is not null)
            {
                <div class="autherror" role="alert">@_error</div>
            }

            <EditForm Model="_model" OnValidSubmit="Save">
                <div class="field">
                    <label for="title">Title</label>
                    <FluentTextField id="title" @bind-Value="_model.Title" Disabled="_busy" Style="width:100%" />
                </div>
                <div class="field">
                    <label for="description">Description</label>
                    <FluentTextArea id="description" @bind-Value="_model.Description" Disabled="_busy" Rows="3" Style="width:100%" />
                </div>
                <div class="field">
                    <label for="address">Address</label>
                    <FluentTextField id="address" @bind-Value="_model.Address" Disabled="_busy" Style="width:100%" />
                </div>
                <div class="formrow">
                    <div class="field">
                        <label for="city">City</label>
                        <FluentTextField id="city" @bind-Value="_model.City" Disabled="_busy" Style="width:100%" />
                    </div>
                    <div class="field">
                        <label for="state">State</label>
                        <FluentTextField id="state" @bind-Value="_model.State" Disabled="_busy" Style="width:100%" />
                    </div>
                    <div class="field">
                        <label for="zip">Zip</label>
                        <FluentTextField id="zip" @bind-Value="_model.Zip" Disabled="_busy" Style="width:100%" />
                    </div>
                    <div class="field">
                        <label for="phone">Phone</label>
                        <FluentTextField id="phone" @bind-Value="_model.Phone" Disabled="_busy" Style="width:100%" />
                    </div>
                </div>
                <div class="formrow">
                    <div class="field">
                        <label for="contactfirst">Primary contact first name</label>
                        <FluentTextField id="contactfirst" @bind-Value="_model.PrimaryContactFirstName" Disabled="_busy" Style="width:100%" />
                    </div>
                    <div class="field">
                        <label for="contactlast">Primary contact last name</label>
                        <FluentTextField id="contactlast" @bind-Value="_model.PrimaryContactLastName" Disabled="_busy" Style="width:100%" />
                    </div>
                </div>

                <div class="btnrow">
                    <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Disabled="_busy">
                        @(_busy ? "Saving…" : _isNew ? "Create organization" : "Save changes")
                    </FluentButton>
                    <a class="btn" href="/settings">Cancel</a>
                </div>
            </EditForm>
        </div>

        @if (!_isNew)
        {
            <div class="card formcard" style="margin-top:16px">
                <h3 style="font-family:Georgia,serif;font-size:16px;margin-bottom:6px">Invite code</h3>
                <p class="sub" style="margin-bottom:10px">New members join this organization by self-registering with this code. Regenerating it invalidates the old one.</p>
                @if (_regenError is not null)
                {
                    <div class="autherror" role="alert">@_regenError</div>
                }
                <div class="row" style="align-items:center;gap:10px">
                    <code style="font-size:16px;letter-spacing:.08em;background:#f3f2f1;padding:6px 12px;border-radius:var(--radius-btn)">@_inviteCode</code>
                    <button class="btn subtle" @onclick="RegenerateCode" disabled="@_regenerating">@(_regenerating ? "Regenerating…" : "Regenerate")</button>
                </div>
            </div>

            <div class="card formcard" style="margin-top:16px">
                <h3 style="font-family:Georgia,serif;font-size:16px;margin-bottom:6px">Logo</h3>
                <p class="sub" style="margin-bottom:10px">Upload a logo (resized to 150px tall). Shown on the organization list.</p>
                @if (_logoError is not null)
                {
                    <div class="autherror" role="alert">@_logoError</div>
                }
                <div class="row" style="align-items:center;gap:14px">
                    @if (!string.IsNullOrEmpty(_logoThumbnail))
                    {
                        <img src="@_logoThumbnail" alt="Organization logo" style="height:@(_logoHeight ?? 48)px;max-height:150px;border:1px solid var(--line);border-radius:var(--radius-btn)" />
                    }
                    else
                    {
                        <span class="sub">No logo yet.</span>
                    }
                    <InputFile OnChange="OnLogoSelected" accept="image/*" disabled="@_logoBusy" />
                    @if (!string.IsNullOrEmpty(_logoThumbnail))
                    {
                        <button class="btn subtle" @onclick="RemoveLogo" disabled="@_logoBusy">Remove</button>
                    }
                </div>
            </div>

            <div class="card formcard" style="margin-top:16px">
                <h3 style="font-family:Georgia,serif;font-size:16px;margin-bottom:6px">Archive organization</h3>
                <p class="sub" style="margin-bottom:10px">Archiving hides the organization without deleting its data.</p>
                @if (_archiveError is not null)
                {
                    <div class="autherror" role="alert">@_archiveError</div>
                }
                @if (_confirmArchive)
                {
                    <div class="row" style="align-items:center;gap:10px">
                        <span>Archive this organization?</span>
                        <button class="btn danger" @onclick="ArchiveOrg" disabled="@_archiving">@(_archiving ? "Archiving…" : "Yes, archive")</button>
                        <button class="btn subtle" @onclick="() => _confirmArchive = false" disabled="@_archiving">Cancel</button>
                    </div>
                }
                else
                {
                    <button class="btn danger" @onclick="() => _confirmArchive = true">Archive</button>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public string? OrganizationId { get; set; }

    private sealed class FormModel
    {
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string? Address { get; set; }
        public string? City { get; set; }
        public string? State { get; set; }
        public string? Zip { get; set; }
        public string? Phone { get; set; }
        public string? PrimaryContactFirstName { get; set; }
        public string? PrimaryContactLastName { get; set; }
    }

    private readonly FormModel _model = new();
    private bool _isNew => string.IsNullOrEmpty(OrganizationId);
    private bool _loading;
    private bool _busy;
    private string? _error;
    private string? _inviteCode;
    private bool _regenerating;
    private string? _regenError;
    private string? _logoThumbnail;
    private int? _logoHeight;
    private bool _logoBusy;
    private string? _logoError;
    private bool _confirmArchive;
    private bool _archiving;
    private string? _archiveError;

    private sealed record LogoResizeResult(string DataUri, int Height);

    protected override async Task OnInitializedAsync()
    {
        if (_isNew)
        {
            return;
        }

        _loading = true;
        var result = await Api.GetOrganizationAsync(OrganizationId!);
        if (result.Succeeded)
        {
            var o = result.Value!;
            _model.Title = o.Title;
            _model.Description = o.Description;
            _model.Address = o.Address;
            _model.City = o.City;
            _model.State = o.State;
            _model.Zip = o.Zip;
            _model.Phone = o.Phone;
            _model.PrimaryContactFirstName = o.PrimaryContactFirstName;
            _model.PrimaryContactLastName = o.PrimaryContactLastName;
            _inviteCode = o.InviteCode;
            _logoThumbnail = o.LogoThumbnailUrl;
            _logoHeight = o.LogoHeightPx;
        }
        else
        {
            _error = result.Error;
        }

        _loading = false;
    }

    private async Task RegenerateCode()
    {
        _regenerating = true;
        _regenError = null;
        var result = await Api.RegenerateInviteCodeAsync(OrganizationId!);
        _regenerating = false;

        if (result.Succeeded && result.Value is not null)
        {
            _inviteCode = result.Value.InviteCode;
        }
        else
        {
            _regenError = result.Error ?? "Couldn't regenerate the invite code.";
        }
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_model.Title) || string.IsNullOrWhiteSpace(_model.Description))
        {
            _error = "Title and description are required.";
            return;
        }

        _busy = true;
        _error = null;

        var body = new SaveOrganizationRequestDto(
            Title: _model.Title.Trim(),
            Description: _model.Description.Trim(),
            Address: _model.Address,
            City: _model.City,
            State: _model.State,
            Zip: _model.Zip,
            Phone: _model.Phone,
            PrimaryContactFirstName: _model.PrimaryContactFirstName,
            PrimaryContactLastName: _model.PrimaryContactLastName);

        bool succeeded;
        string? error;
        if (_isNew)
        {
            var r = await Api.CreateOrganizationAsync(body);
            (succeeded, error) = (r.Succeeded, r.Error);
        }
        else
        {
            var r = await Api.UpdateOrganizationAsync(OrganizationId!, body);
            (succeeded, error) = (r.Succeeded, r.Error);
        }

        if (succeeded)
        {
            Nav.NavigateTo("/settings");
            return;
        }

        _error = error ?? "Save failed.";
        _busy = false;
    }

    private async Task OnLogoSelected(InputFileChangeEventArgs e)
    {
        _logoBusy = true;
        _logoError = null;

        try
        {
            var file = e.File;
            // Cap the raw upload (resizing happens client-side; a small thumbnail is stored).
            await using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            var sourceUri = $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer.ToArray())}";

            var resized = await JS.InvokeAsync<LogoResizeResult>("collegaResizeImage", sourceUri, 150);
            var result = await Api.SetOrganizationLogoAsync(OrganizationId!, new SetLogoRequestDto(resized.DataUri, resized.Height));
            if (result.Succeeded && result.Value is not null)
            {
                _logoThumbnail = result.Value.LogoThumbnailUrl;
                _logoHeight = result.Value.LogoHeightPx;
            }
            else
            {
                _logoError = result.Error ?? "Couldn't save the logo.";
            }
        }
        catch (Exception ex)
        {
            _logoError = $"Couldn't process the image. {ex.Message}";
        }
        finally
        {
            _logoBusy = false;
        }
    }

    private async Task RemoveLogo()
    {
        _logoBusy = true;
        _logoError = null;
        var result = await Api.ClearOrganizationLogoAsync(OrganizationId!);
        _logoBusy = false;

        if (result.Succeeded)
        {
            _logoThumbnail = null;
            _logoHeight = null;
        }
        else
        {
            _logoError = result.Error ?? "Couldn't remove the logo.";
        }
    }

    private async Task ArchiveOrg()
    {
        _archiving = true;
        _archiveError = null;
        var result = await Api.ArchiveOrganizationAsync(OrganizationId!);
        _archiving = false;

        if (result.Succeeded)
        {
            Nav.NavigateTo("/settings");
        }
        else
        {
            _archiveError = result.Error ?? "Couldn't archive the organization.";
            _confirmArchive = false;
        }
    }
}
