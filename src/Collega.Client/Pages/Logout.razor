@page "/logout"
@layout AuthLayout
@inject NavigationManager Nav
@inject CollegaAuthStateProvider AuthState

<PageTitle>Signing out · Collega</PageTitle>

@*
    Clears the persisted session and returns to sign-in. Sign Out in the rail's avatar popover signs
    out in place rather than routing here, so this now serves only a directly entered /logout URL.
    Anonymous + AuthLayout so it doesn't flash the app chrome.
*@
<div class="authwrap">
    <div class="authcard">
        <p class="sub">Signing you out…</p>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await AuthState.MarkSignedOutAsync();
        Nav.NavigateTo("/login", replace: true);
    }
}
