@page "/ideas/{IdeaId}/edit"
@attribute [Authorize]
@using System.Security.Claims
@using System.Text.RegularExpressions
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>@(_idea?.Title ?? "Idea") · Collega</PageTitle>

@*
    Full-page, article-style Idea Detail (per the locked comp comp-c-review-06-lockin-v5-final.html /
    comp-c-review-04-idea-detail.html) — NOT an overlay. Left column: editable title + description and
    the comment thread. Right column ("facts"): status, priority, assignees, tags, upvotes.

    Role gating (SPEC/20-feature-ideas-and-engagement.md): Read Only can VIEW, comment, and upvote but
    cannot edit idea content (title/description/status/tags). User / Org Admin / Site Admin can edit.
    A board's `allowUserStatusUpdate` and role rules are enforced server-side, so a User's rejected
    status move is reverted and the permission message is surfaced (feature-client-ui #5).
    Ideas in a Complete status stay editable.
*@

@if (_loading)
{
    <div class="ideahd">
        <div class="crumbs"><a href="/ideas">Ideas</a> / Idea</div>
    </div>
    <div class="body"><div class="loading"><FluentProgressRing /> <span>Loading idea…</span></div></div>
}
else if (_idea is null)
{
    <div class="ideahd">
        <div class="crumbs"><a href="/ideas">Ideas</a> / Not found</div>
        <h1>Idea unavailable</h1>
    </div>
    <div class="body">
        <div class="autherror" role="alert">@(_error ?? "This idea could not be loaded.")</div>
        <a class="btn" href="/ideas">Back to ideas</a>
    </div>
}
else
{
    <div class="ideahd">
        <div class="crumbs"><a href="/ideas">Ideas</a> / @_idea.Title</div>
        <div class="kicker">@_idea.StatusName · @_idea.Priority priority</div>
        <div class="titlerow">
            <h1>@_idea.Title</h1>
            <button class="up @(_idea.HasUpvoted ? "mine" : "")"
                    @onclick="ToggleUpvote" disabled="@_upvoting"
                    title="@(_idea.HasUpvoted ? "Remove your upvote" : "Upvote this idea")">
                ▲ @(_idea.HasUpvoted ? "Upvoted" : "Upvote") · @_idea.UpvoteCount
            </button>
        </div>
    </div>

    <div class="ideabody">
        <div class="maincol">
            @if (_actionError is not null)
            {
                <div class="autherror" role="alert">@_actionError</div>
            }
            @if (_saveMessage is not null)
            {
                <div class="authnote" role="status">@_saveMessage</div>
            }

            @if (_canEdit)
            {
                <label class="fieldlabel" for="idea-title">Title <span class="charlim">@_title.Length / 150</span></label>
                <input id="idea-title" type="text" class="titleinput" maxlength="150"
                       @bind="_title" @bind:event="oninput" disabled="@_savingIdea" />

                <label class="fieldlabel" for="idea-desc">Description <span class="charlim">@_description.Length / 4000</span></label>
                <textarea id="idea-desc" class="prose descinput" maxlength="4000"
                          @bind="_description" @bind:event="oninput" disabled="@_savingIdea"></textarea>

                @if (_resolvedFields.Count > 0)
                {
                    <h2 class="fieldlabel" style="margin-top:20px">Custom fields</h2>
                    <IdeaFieldInputs Fields="_resolvedFields" Values="_fieldValues" Disabled="_savingIdea" OnChanged="StateHasChanged" />
                }
                @if (ArchivedValues.Count > 0)
                {
                    <div class="archived-fields">
                        @foreach (var av in ArchivedValues)
                        {
                            <div class="rofield archived">
                                <span class="lbl">@av.FieldName <span class="archtag">archived</span></span>
                                <span class="val muted">@ArchivedDisplay(av)</span>
                            </div>
                        }
                        <p class="hint">These fields aren't on this idea's type. Their values are preserved and shown muted — never dropped, same as a soft-deleted field.</p>
                    </div>
                }

                <div class="btnrow savebtnrow">
                    <button class="btn primary" @onclick="SaveIdea" disabled="@(_savingIdea || !HasIdeaChanges)">
                        @(_savingIdea ? "Saving…" : "Save changes")
                    </button>
                    @if (HasIdeaChanges)
                    {
                        <button class="btn subtle" @onclick="ResetIdeaEdits" disabled="@_savingIdea">Discard</button>
                    }
                </div>
            }
            else
            {
                <h1 class="readtitle">@_idea.Title</h1>
                <p class="prose readdesc">@_idea.Description</p>
            }

            <h2 class="discussion">Discussion <span class="count">@_comments.Count comment@(_comments.Count == 1 ? "" : "s")</span></h2>

            @if (_commentsError is not null)
            {
                <div class="autherror" role="alert">@_commentsError</div>
            }

            @if (_comments.Count == 0)
            {
                <p class="empty">No comments yet. Start the discussion below.</p>
            }
            else
            {
                @foreach (var c in _comments)
                {
                    <div class="comment">
                        <div class="cbyline">
                            <span class="avatar s">@Initials(DisplayNameFor(c.AuthorUserId))</span>
                            <span class="who">@DisplayNameFor(c.AuthorUserId)</span>
                            <span class="when">@FormatWhen(c.CreatedAtUtc)</span>
                        </div>
                        <p class="cbody">@c.Body</p>
                    </div>
                }
            }

            <div class="addcomment">
                <span class="avatar s">@Initials(_currentUserName)</span>
                <div class="addbox">
                    <textarea class="prose" aria-label="Add a comment" maxlength="2000" placeholder="Join the discussion… type someone's email with @@ to notify them"
                              @bind="_newComment" @bind:event="oninput" disabled="@_postingComment"></textarea>
                    <div class="charcount @(_newComment.Length > 2000 ? "over" : "")">@_newComment.Length / 2000</div>
                    <button class="btn primary" @onclick="PostComment"
                            disabled="@(_postingComment || string.IsNullOrWhiteSpace(_newComment) || _newComment.Length > 2000)">
                        @(_postingComment ? "Posting…" : "Post comment")
                    </button>
                </div>
            </div>
        </div>

        <div class="facts">
            <div class="fact">
                <div class="k">Status</div>
                <div class="v">
                    <select aria-label="Idea status" @key="_statusSelectNonce" value="@_idea.StatusId" @onchange="OnStatusChanged" disabled="@(!_canEdit || _changingStatus || _statusOptions.Count == 0)">
                        @if (_statusOptions.Count == 0)
                        {
                            <option value="@_idea.StatusId" selected>@_idea.StatusName</option>
                        }
                        else
                        {
                            @foreach (var s in _statusOptions)
                            {
                                <option value="@s.StatusId">@s.Name</option>
                            }
                        }
                    </select>
                </div>
            </div>
            <div class="fact">
                <div class="k">Priority</div>
                <div class="v"><span class="pill @PriorityPill(_idea.Priority)">@_idea.Priority</span></div>
            </div>
            @if (!string.IsNullOrWhiteSpace(_idea.IdeaTypeName))
            {
                <div class="fact">
                    <div class="k">Idea Type</div>
                    <div class="v">
                        <div class="typerow">
                            <TypeBadge Name="@_idea.IdeaTypeName" ColorHex="@_idea.IdeaTypeColorHex" Icon="@_idea.IdeaTypeIcon" />
                            @if (_canReassign)
                            {
                                <button class="btn subtle sm" @onclick="ToggleReassign" disabled="@_reassigning">Reassign type…</button>
                            }
                        </div>
                        @if (_canReassign)
                        {
                            <p class="hint" style="margin-top:6px">Type is set at creation and immutable for regular users. Reassign is an admin break-glass — values outside the new type's fields are archived, not lost.</p>
                        }
                        @if (_showReassign && _canReassign)
                        {
                            <div class="reassign-box">
                                <label>Reassign to <span class="muted">(admin)</span></label>
                                <select value="@_reassignTargetId" @onchange="OnReassignTargetChanged" disabled="@_reassigning" style="width:100%">
                                    @foreach (var t in _ideaTypes.Where(t => !t.IsDeleted))
                                    {
                                        <option value="@t.IdeaTypeId">@t.Name</option>
                                    }
                                </select>
                                @if (ReassignArchivedNames.Count > 0)
                                {
                                    <div class="flash">
                                        Changing type re-resolves custom fields.
                                        <strong>@string.Join(", ", ReassignArchivedNames)</strong>
                                        @(ReassignArchivedNames.Count == 1 ? "isn't" : "aren't") on the new type — its value@(ReassignArchivedNames.Count == 1 ? "" : "s") will be kept but hidden (archived). This is logged to the audit trail.
                                    </div>
                                }
                                @if (_reassignError is not null)
                                {
                                    <div class="autherror" role="alert" style="margin-top:8px">@_reassignError</div>
                                }
                                <div class="btnrow" style="margin-top:10px">
                                    <button class="btn primary sm" @onclick="ConfirmReassign"
                                            disabled="@(_reassigning || string.IsNullOrEmpty(_reassignTargetId) || _reassignTargetId == _idea.IdeaTypeId)">
                                        @(_reassigning ? "Reassigning…" : "Confirm reassignment")
                                    </button>
                                    <button class="btn subtle sm" @onclick="ToggleReassign" disabled="@_reassigning">Cancel</button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_idea.BusinessImpactName))
            {
                <div class="fact">
                    <div class="k">Business Impact</div>
                    <div class="v"><span class="pill neutral" style="@BusinessImpactStyle(_idea.BusinessImpactColor)">@_idea.BusinessImpactName</span></div>
                </div>
            }
            <div class="fact">
                <div class="k">Assignees</div>
                <div class="v">
                    @if (_idea.Assignees.Count == 0)
                    {
                        <span class="muted">Unassigned</span>
                    }
                    else
                    {
                        <div class="assignees">
                            @foreach (var a in _idea.Assignees)
                            {
                                <span class="assignee"><span class="avatar s">@Initials(a.DisplayName)</span>@a.DisplayName</span>
                            }
                        </div>
                    }
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(_idea.DueDate))
            {
                <div class="fact">
                    <div class="k">Due date</div>
                    <div class="v">@_idea.DueDate</div>
                </div>
            }
            <div class="fact">
                <div class="k">Tags</div>
                <div class="v">
                    @if (_idea.TagNames.Count == 0)
                    {
                        <span class="muted">None</span>
                    }
                    else
                    {
                        <div class="taglist">
                            @foreach (var t in _idea.TagNames)
                            {
                                <span class="pill neutral">@t</span>
                            }
                        </div>
                    }
                </div>
            </div>
            @if (!_canEdit)
            {
                @foreach (var f in _resolvedFields)
                {
                    var display = DisplayFieldValue(f);
                    @if (!string.IsNullOrEmpty(display))
                    {
                        <div class="fact">
                            <div class="k">@f.Name</div>
                            <div class="v">@display</div>
                        </div>
                    }
                }
                @foreach (var av in ArchivedValues)
                {
                    <div class="fact">
                        <div class="k">@av.FieldName <span class="archtag">archived</span></div>
                        <div class="v muted">@ArchivedDisplay(av)</div>
                    </div>
                }
            }
            <div class="fact">
                <div class="k">Upvotes</div>
                <div class="v">@_idea.UpvoteCount @(_idea.UpvoteCount == 1 ? "person" : "people")</div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? IdeaId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private IdeaDetailDto? _idea;
    private readonly List<CommentListItemDto> _comments = new();
    private List<StatusItemDto> _statusOptions = new();
    private readonly Dictionary<string, string> _names = new();

    // Org User-Defined Fields (UDFs). _fieldValues is the editable working copy keyed by field
    // definition id; _originalFieldValues snapshots the loaded values for change detection / discard.
    // _resolvedFields is the subset this idea's TYPE shows (SPEC/20-feature-idea-type-fields.md); values
    // outside it are historical/archived and rendered muted, never edited.
    private IReadOnlyList<FieldDefinitionDto> _fieldDefs = Array.Empty<FieldDefinitionDto>();
    private IReadOnlyList<FieldDefinitionDto> _resolvedFields = Array.Empty<FieldDefinitionDto>();
    private IReadOnlyList<IdeaTypeOptionDto> _ideaTypes = Array.Empty<IdeaTypeOptionDto>();
    private Dictionary<string, string?> _fieldValues = new();
    private Dictionary<string, string?> _originalFieldValues = new();

    // Admin-only "reassign type" break-glass (P1).
    private bool _showReassign;
    private bool _reassigning;
    private string _reassignTargetId = "";
    private string? _reassignError;
    private bool _canReassign =>
        string.Equals(_role, "OrgAdmin", StringComparison.OrdinalIgnoreCase)
        || string.Equals(_role, "SiteAdmin", StringComparison.OrdinalIgnoreCase);

    private string _title = "";
    private string _description = "";
    private string _newComment = "";

    private string _role = "";
    private string? _currentUserId;
    private string _currentUserName = "";
    private string? _organizationId;

    private bool _loading = true;
    private bool _savingIdea;
    private bool _changingStatus;
    private bool _upvoting;
    private bool _postingComment;

    // Bumped when a status change is rejected, to force the <select> to rebuild from _idea.StatusId.
    private int _statusSelectNonce;

    private string? _error;
    private string? _actionError;
    private string? _commentsError;
    private string? _saveMessage;

    private string? _loadedId;

    private bool _canEdit => _role != "ReadOnly" && !string.IsNullOrEmpty(_role);

    private bool HasIdeaChanges =>
        _idea is not null && (_title != _idea.Title || _description != _idea.Description || FieldValuesChanged);

    private bool FieldValuesChanged => _resolvedFields.Any(f =>
        NormFieldValue(_fieldValues.GetValueOrDefault(f.FieldDefinitionId))
        != NormFieldValue(_originalFieldValues.GetValueOrDefault(f.FieldDefinitionId)));

    // The idea's own type option (with its field selection), used to resolve the fields it shows.
    private IdeaTypeOptionDto? SelectedIdeaType =>
        _idea is null ? null : _ideaTypes.FirstOrDefault(t => t.IdeaTypeId == _idea.IdeaTypeId);

    // Historical values whose field is no longer in this idea's resolved set — removed from a Curated
    // type or archived on reassignment. Preserved server-side and shown muted (never dropped).
    private IReadOnlyList<IdeaFieldValueDetailDto> ArchivedValues
    {
        get
        {
            if (_idea?.FieldValues is null)
            {
                return Array.Empty<IdeaFieldValueDetailDto>();
            }
            var resolved = _resolvedFields.Select(f => f.FieldDefinitionId).ToHashSet();
            return _idea.FieldValues
                .Where(v => !string.IsNullOrWhiteSpace(v.Value) && !resolved.Contains(v.FieldDefinitionId))
                .ToList();
        }
    }

    // Field names whose current value would be archived by reassigning to _reassignTargetId — named in the
    // inline confirm so the admin sees exactly what leaves the form.
    private IReadOnlyList<string> ReassignArchivedNames
    {
        get
        {
            if (_idea?.FieldValues is null || string.IsNullOrEmpty(_reassignTargetId))
            {
                return Array.Empty<string>();
            }
            var target = _ideaTypes.FirstOrDefault(t => t.IdeaTypeId == _reassignTargetId);
            var targetResolved = IdeaTypeFieldResolution.Resolve(target, _fieldDefs).Select(f => f.FieldDefinitionId).ToHashSet();
            return _idea.FieldValues
                .Where(v => !string.IsNullOrWhiteSpace(v.Value) && !targetResolved.Contains(v.FieldDefinitionId))
                .Select(v => v.FieldName)
                .ToList();
        }
    }

    private static string NormFieldValue(string? v) => string.IsNullOrWhiteSpace(v) ? "" : v;

    protected override async Task OnParametersSetAsync()
    {
        // Load once per idea id; Blazor may reuse this component when navigating between ideas.
        if (IdeaId is null || IdeaId == _loadedId)
        {
            return;
        }

        _loadedId = IdeaId;
        await LoadAsync(IdeaId);
    }

    private async Task LoadAsync(string ideaId)
    {
        _loading = true;
        _error = null;
        _actionError = null;
        _saveMessage = null;
        _commentsError = null;
        _comments.Clear();
        _names.Clear();

        if (AuthStateTask is not null)
        {
            var user = (await AuthStateTask).User;
            _role = user.FindFirst(ClaimTypes.Role)?.Value ?? "";
            _currentUserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            _currentUserName = user.FindFirst(ClaimTypes.Name)?.Value ?? "";
            _organizationId = user.FindFirst("organizationId")?.Value;
        }

        var result = await Api.GetIdeaAsync(ideaId);
        if (!result.Succeeded || result.Value is null)
        {
            _error = result.Error ?? "This idea could not be loaded.";
            _idea = null;
            _loading = false;
            return;
        }

        SetIdea(result.Value);

        // Board detail supplies the status options for the move-status control. Non-fatal on failure:
        // the select degrades to the current status only.
        var board = await Api.GetBoardAsync(_idea!.BoardId);
        if (board.Succeeded && board.Value is not null)
        {
            _organizationId = board.Value.OrganizationId;
            _statusOptions = board.Value.Swimlanes
                .OrderBy(s => s.Order)
                .Select(s => new StatusItemDto(s.StatusId, board.Value.OrganizationId, s.StatusName, s.StatusColor, s.Order, s.StatusIsDeleted))
                .ToList();
        }

        // Org custom-field schema + idea-type catalog (best-effort; the field pool is cached in the
        // ApiClient). Available to any member so read-only viewers still see values. The idea's type +
        // the pool resolve which fields this idea shows; the rest are historical/archived.
        if (!string.IsNullOrEmpty(_organizationId))
        {
            var fieldsResult = await Api.GetActiveFieldDefinitionsAsync(_organizationId);
            if (fieldsResult.Succeeded)
            {
                _fieldDefs = fieldsResult.Value!;
            }

            var typesResult = await Api.GetIdeaTypesAsync(_organizationId);
            if (typesResult.Succeeded)
            {
                _ideaTypes = typesResult.Value!.OrderBy(t => t.SortOrder).ToList();
            }
        }
        _resolvedFields = IdeaTypeFieldResolution.Resolve(SelectedIdeaType, _fieldDefs);
        SeedFieldValues();

        // Best-effort author name map from the org's users, so comment bylines show real names.
        // Only needed when the idea actually has comments — skip the fetch otherwise.
        if (!string.IsNullOrEmpty(_organizationId) && _idea!.CommentCount > 0)
        {
            var users = await Api.GetAllOrganizationUsersAsync(_organizationId);
            if (users.Succeeded && users.Value is not null)
            {
                foreach (var u in users.Value)
                {
                    _names[u.UserId] = $"{u.FirstName} {u.LastName}".Trim();
                }
            }
        }

        await LoadCommentsAsync(ideaId);

        _loading = false;
    }

    private void SetIdea(IdeaDetailDto idea)
    {
        _idea = idea;
        _title = idea.Title;
        _description = idea.Description;

        // Seed the name map with personas the idea already carries (assignees + resolved mentions).
        foreach (var a in idea.Assignees)
        {
            _names[a.UserId] = a.DisplayName;
        }
        foreach (var m in idea.Mentions)
        {
            _names[m.UserId] = m.DisplayName;
        }
    }

    // Rebuilds the editable UDF working copy (and its change-detection snapshot) from the current
    // idea's resolved field values. Called after load and after each successful save.
    private void SeedFieldValues()
    {
        _fieldValues = new Dictionary<string, string?>();
        _originalFieldValues = new Dictionary<string, string?>();
        if (_idea is null)
        {
            return;
        }

        foreach (var f in _resolvedFields)
        {
            var value = _idea.FieldValues?.FirstOrDefault(v => v.FieldDefinitionId == f.FieldDefinitionId)?.Value;
            _fieldValues[f.FieldDefinitionId] = value;
            _originalFieldValues[f.FieldDefinitionId] = value;
        }
    }

    private async Task LoadCommentsAsync(string ideaId)
    {
        var comments = await Api.GetIdeaCommentsAsync(ideaId);
        _comments.Clear();

        if (comments.Succeeded && comments.Value is not null)
        {
            _comments.AddRange(comments.Value.Items.OrderBy(c => c.CreatedAtUtc));
        }
        else if (_idea is not null)
        {
            // Fall back to the comments embedded on the idea detail.
            _comments.AddRange(_idea.Comments
                .OrderBy(c => c.CreatedAtUtc)
                .Select(c => new CommentListItemDto(c.CommentId, c.IdeaId, c.AuthorUserId, c.Body, c.CreatedAtUtc, c.UpdatedAtUtc)));
            if (!comments.Succeeded)
            {
                _commentsError = comments.Error;
            }
        }
    }

    private async Task SaveIdea()
    {
        if (_idea is null || !_canEdit)
        {
            return;
        }

        var title = _title.Trim();
        if (string.IsNullOrWhiteSpace(title))
        {
            _actionError = "A title is required.";
            return;
        }

        // Mirror the server's required-field guardrail so the user sees it before the round-trip. Only the
        // fields this idea's type resolves are validated (per-type required-ness).
        var missing = _resolvedFields.FirstOrDefault(f => f.IsRequired && string.IsNullOrWhiteSpace(_fieldValues.GetValueOrDefault(f.FieldDefinitionId)));
        if (missing is not null)
        {
            _actionError = $"{missing.Name} is required.";
            return;
        }

        _savingIdea = true;
        _actionError = null;
        _saveMessage = null;

        // Field values reconcile against the idea type's resolved set as the scope, so only those fields
        // are sent (a blank one is sent as null to clear it). Historical/archived values outside the set
        // are preserved untouched server-side because they're not in the reconcile scope.
        var fieldValues = _resolvedFields
            .Select(f => new IdeaFieldValueWriteDto(f.FieldDefinitionId, _fieldValues.GetValueOrDefault(f.FieldDefinitionId)))
            .ToList();

        // Echo the unchanged fields back so they aren't cleared by the full-replace update. Idea Type
        // and Business Impact are required references, so they must be echoed like priority.
        var body = new UpdateIdeaRequestDto(
            title,
            _description,
            _idea.Priority,
            _idea.IdeaTypeId,
            _idea.BusinessImpactId,
            _idea.DueDate,
            _idea.Assignees.Select(a => a.UserId).ToList(),
            _idea.TagNames.ToList(),
            null,
            _resolvedFields.Count > 0 ? fieldValues : null);

        var result = await Api.UpdateIdeaAsync(_idea.IdeaId, body);
        if (result.Succeeded && result.Value is not null)
        {
            SetIdea(result.Value);
            SeedFieldValues();
            _saveMessage = "Changes saved.";
        }
        else
        {
            _actionError = result.Error ?? "Save failed.";
        }

        _savingIdea = false;
    }

    private void ResetIdeaEdits()
    {
        if (_idea is not null)
        {
            _title = _idea.Title;
            _description = _idea.Description;
            _fieldValues = new Dictionary<string, string?>(_originalFieldValues);
            _saveMessage = null;
            _actionError = null;
        }
    }

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        var targetId = e.Value?.ToString();
        if (_idea is null || string.IsNullOrEmpty(targetId) || targetId == _idea.StatusId)
        {
            return;
        }

        _changingStatus = true;
        _actionError = null;
        _saveMessage = null;

        var result = await Api.ChangeIdeaStatusAsync(_idea.IdeaId, new ChangeIdeaStatusRequestDto(targetId));
        if (result.Succeeded)
        {
            var target = _statusOptions.FirstOrDefault(s => s.StatusId == targetId);
            _idea = _idea with { StatusId = targetId, StatusName = target?.Name ?? _idea.StatusName };
            _saveMessage = "Status updated.";
        }
        else
        {
            // Rejected (e.g. board doesn't allow User status moves). Bump the select's @key so Blazor
            // rebuilds it from the unchanged _idea.StatusId — a plain re-render leaves the browser on
            // the rejected option because the bound value attribute didn't change. Surface the message.
            _statusSelectNonce++;
            _actionError = result.Error ?? "Status change failed.";
        }

        _changingStatus = false;
    }

    private async Task ToggleUpvote()
    {
        if (_idea is null)
        {
            return;
        }

        _upvoting = true;
        _actionError = null;

        var result = await Api.ToggleUpvoteAsync(_idea.IdeaId);
        if (result.Succeeded && result.Value is not null)
        {
            _idea = _idea with { HasUpvoted = result.Value.HasUpvoted, UpvoteCount = result.Value.UpvoteCount };
        }
        else
        {
            _actionError = result.Error ?? "Could not update your upvote.";
        }

        _upvoting = false;
    }

    private async Task PostComment()
    {
        if (_idea is null || string.IsNullOrWhiteSpace(_newComment) || _newComment.Length > 2000)
        {
            return;
        }

        _postingComment = true;
        _actionError = null;

        var body = new CreateCommentRequestDto(_newComment, ExtractMentionEmails(_newComment));
        var result = await Api.AddIdeaCommentAsync(_idea.IdeaId, body);
        if (result.Succeeded)
        {
            _newComment = "";
            await LoadCommentsAsync(_idea.IdeaId);
        }
        else
        {
            _actionError = result.Error ?? "Could not post your comment.";
        }

        _postingComment = false;
    }

    private static readonly Regex EmailPattern =
        new(@"[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}", RegexOptions.Compiled);

    /// <summary>Pulls email addresses out of a comment body so they can be sent as @mentions.
    /// Mentioning is by email (SPEC comment rule #5); anything not a valid email is left as plain text.</summary>
    private static List<string>? ExtractMentionEmails(string body)
    {
        var emails = EmailPattern.Matches(body)
            .Select(m => m.Value)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        return emails.Count > 0 ? emails : null;
    }

    private string DisplayNameFor(string userId)
    {
        if (!string.IsNullOrEmpty(userId) && _names.TryGetValue(userId, out var name) && !string.IsNullOrWhiteSpace(name))
        {
            return name;
        }
        return string.Equals(userId, _currentUserId, StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(_currentUserName)
            ? _currentUserName
            : "Member";
    }

    private static string Initials(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "?";
        }
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
        {
            return parts[0][..1].ToUpperInvariant();
        }
        return (parts[0][..1] + parts[^1][..1]).ToUpperInvariant();
    }

    // Resolves a UDF value to human-readable text for the read-only facts panel. Dropdown/MultiSelect
    // values are stored as option ids, so they're mapped back to labels via the field's option list.
    private string? DisplayFieldValue(FieldDefinitionDto f)
    {
        var raw = _fieldValues.GetValueOrDefault(f.FieldDefinitionId);
        if (string.IsNullOrWhiteSpace(raw))
        {
            return null;
        }

        switch (f.FieldType)
        {
            case "Boolean":
                return string.Equals(raw, "true", StringComparison.OrdinalIgnoreCase) ? "Yes" : "No";
            case "Dropdown":
                return f.Options.FirstOrDefault(o => o.OptionId == raw)?.Label ?? raw;
            case "MultiSelect":
                var ids = raw.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                var labels = ids.Select(idv => f.Options.FirstOrDefault(o => o.OptionId == idv)?.Label ?? idv);
                return string.Join(", ", labels);
            default:
                return raw;
        }
    }

    // Best-effort display of a historical/archived value from its detail DTO. Option ids are mapped back
    // to labels via the active field pool when the definition is still around; otherwise shown raw.
    private string ArchivedDisplay(IdeaFieldValueDetailDto av)
    {
        var raw = av.Value ?? "";
        if (string.IsNullOrWhiteSpace(raw))
        {
            return "";
        }

        var f = _fieldDefs.FirstOrDefault(x => x.FieldDefinitionId == av.FieldDefinitionId);
        switch (av.FieldType)
        {
            case "Boolean":
                return string.Equals(raw, "true", StringComparison.OrdinalIgnoreCase) ? "Yes" : "No";
            case "Dropdown":
                return f?.Options.FirstOrDefault(o => o.OptionId == raw)?.Label ?? raw;
            case "MultiSelect":
                var ids = raw.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                return string.Join(", ", ids.Select(idv => f?.Options.FirstOrDefault(o => o.OptionId == idv)?.Label ?? idv));
            default:
                return raw;
        }
    }

    // ---- Admin reassign type (P1) ----
    private void ToggleReassign()
    {
        _showReassign = !_showReassign;
        _reassignError = null;
        if (_showReassign && _idea is not null)
        {
            _reassignTargetId = _idea.IdeaTypeId;
        }
    }

    private void OnReassignTargetChanged(ChangeEventArgs e) => _reassignTargetId = e.Value?.ToString() ?? "";

    private async Task ConfirmReassign()
    {
        if (_idea is null || !_canReassign || string.IsNullOrEmpty(_organizationId) || string.IsNullOrEmpty(_reassignTargetId))
        {
            return;
        }
        if (_reassignTargetId == _idea.IdeaTypeId)
        {
            _reassignError = "Choose a different idea type.";
            return;
        }

        _reassigning = true;
        _reassignError = null;

        var result = await Api.ReassignIdeaTypeAsync(_organizationId!, _idea.IdeaId, new ReassignIdeaTypeRequestDto(_reassignTargetId));
        _reassigning = false;
        if (!result.Succeeded)
        {
            _reassignError = result.Error ?? "Reassigning the idea type failed.";
            return;
        }

        _showReassign = false;
        // Reload so the new type, its re-resolved fields, and any newly-archived values reflect.
        await LoadAsync(_idea.IdeaId);
    }

    // Tints the Business Impact pill with its configured #RRGGBB color (left border + faint fill),
    // mirroring how status/priority colors are applied elsewhere. Blank color falls back to the plain pill.
    private static string BusinessImpactStyle(string? color) =>
        string.IsNullOrWhiteSpace(color) ? string.Empty : $"border-left:3px solid {color};padding-left:8px";

    private static string PriorityPill(string priority) => priority switch
    {
        "Critical" => "err",
        "High" => "warn",
        "Medium" => "info",
        _ => "neutral",
    };

    private static string FormatWhen(DateTime utc) =>
        // API datetimes arrive Kind=Unspecified (EF/SQL Server), so pin them to UTC before converting.
        DateTime.SpecifyKind(utc, DateTimeKind.Utc).ToLocalTime().ToString("MMM d, yyyy · h:mm tt");
}
