@using System.Security.Claims
@using System.Text.RegularExpressions
@using Collega.Client.Services
@inject ApiClient Api

@*
    Right slide-in Idea Detail drawer (SPEC/20-feature-client-ui.md → "Idea Detail Surface", locked
    2026-08-10; comp SPEC/mockups/comp-c-review-09-detail-surfaces.html). Opens in a READ view with an
    Edit action that swaps the body in place. Full parity with the retired full-page IdeaDetail: all
    idea fields incl. UDFs, Idea Type badge (immutable on the normal edit path; admin reassign hatch),
    Business Impact, priority, due date, tags, 0–5 assignees, email @@mentions, status move (live re-slot
    via OnChanged), upvote, chronological comments, and admin-only delete.

    Public contract (consumed by hosts — Ideas list, Board pages):
      IdeaId    : when null, renders nothing (closed).
      OnClose   : the user closed the drawer.
      OnChanged : fired after any mutation (save / status move / upvote / delete) so the host list/board
                  can refresh/re-slot. For delete, OnChanged fires first, then OnClose.
*@

@if (IdeaId is not null)
{
    <div class="surface-backdrop open" @onclick="CloseAsync"></div>
    <aside class="drawer open" role="dialog" aria-modal="true" aria-labelledby="drawer-title"
           tabindex="-1" @onkeydown="OnKeyDown">
        @if (_loading)
        {
            <header class="surface-head">
                <div class="grow"><div class="eyebrow">Idea</div><h2 id="drawer-title">Loading…</h2></div>
                <button class="iconbtn" @onclick="CloseAsync" aria-label="Close">×</button>
            </header>
            <div class="surface-body"><div class="loading"><FluentProgressRing /> <span>Loading idea…</span></div></div>
        }
        else if (_idea is null)
        {
            <header class="surface-head">
                <div class="grow"><div class="eyebrow">Idea</div><h2 id="drawer-title">Idea unavailable</h2></div>
                <button class="iconbtn" @onclick="CloseAsync" aria-label="Close">×</button>
            </header>
            <div class="surface-body">
                <div class="autherror" role="alert">@(_error ?? "This idea could not be loaded.")</div>
            </div>
        }
        else
        {
            <header class="surface-head">
                <div class="grow">
                    <div class="eyebrow" id="drawer-eyebrow">Idea · @_idea.StatusName</div>
                    <h2 id="drawer-title">@_idea.Title</h2>
                    <div class="meta">@BoardName @(_idea.Priority is { Length: > 0 } ? $"· {_idea.Priority} priority" : "")</div>
                </div>
                <button class="iconbtn" @onclick="CloseAsync" aria-label="Close">×</button>
            </header>

            @if (_actionError is not null)
            {
                <div class="drawer-flash"><div class="autherror" role="alert">@_actionError</div></div>
            }
            @if (_saveMessage is not null)
            {
                <div class="drawer-flash"><div class="authnote" role="status">@_saveMessage</div></div>
            }

            @if (!_editing)
            {
                <div class="surface-body" id="drawer-view">
                    <div class="topline">
                        <div class="statuspick">
                            @if (_canEdit && _statusOptions.Count > 0)
                            {
                                <label class="sr-only" for="drawer-status">Move in board</label>
                                <select id="drawer-status" class="statusselect" @key="_statusSelectNonce"
                                        value="@_idea.StatusId" @onchange="OnStatusChanged"
                                        disabled="@_changingStatus" title="Move in board">
                                    @foreach (var s in _statusOptions)
                                    {
                                        <option value="@s.StatusId">@s.Name</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <span class="status"><span class="dot" style="background:@StatusColor(_idea.StatusId)"></span>@_idea.StatusName</span>
                            }
                        </div>
                        <div class="topactions">
                            <button class="up @(_idea.HasUpvoted ? "mine" : "")" @onclick="ToggleUpvote" disabled="@_upvoting"
                                    aria-label="@(_idea.HasUpvoted ? "Remove your upvote" : "Upvote this idea")"
                                    title="@(_idea.HasUpvoted ? "Remove your upvote" : "Upvote this idea")">
                                <FluentIcon Value="@(new Icons.Regular.Size16.CaretUp())" aria-hidden="true" /> @_idea.UpvoteCount
                            </button>
                            @if (_canEdit)
                            {
                                <button class="btn" @onclick="StartEdit">Edit idea</button>
                            }
                        </div>
                    </div>

                    <p class="detail-copy">@(string.IsNullOrWhiteSpace(_idea.Description) ? "No description." : _idea.Description)</p>

                    <div class="facts">
                        @if (!string.IsNullOrWhiteSpace(_idea.IdeaTypeName))
                        {
                            <div class="fact">
                                <div class="k">Idea type</div>
                                <div class="v">
                                    <div class="typerow">
                                        <TypeBadge Name="@_idea.IdeaTypeName" ColorHex="@_idea.IdeaTypeColorHex" Icon="@_idea.IdeaTypeIcon" />
                                        @if (_canReassign)
                                        {
                                            <button class="btn subtle sm" @onclick="ToggleReassign" disabled="@_reassigning">Reassign…</button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_idea.BusinessImpactName))
                        {
                            <div class="fact">
                                <div class="k">Business impact</div>
                                <div class="v"><span class="pill neutral" style="@BusinessImpactStyle(_idea.BusinessImpactColor)">@_idea.BusinessImpactName</span></div>
                            </div>
                        }
                        <div class="fact">
                            <div class="k">Priority</div>
                            <div class="v"><span class="pill @PriorityPill(_idea.Priority)">@_idea.Priority</span></div>
                        </div>
                        <div class="fact">
                            <div class="k">Assigned to</div>
                            <div class="v">
                                @if (_idea.Assignees.Count == 0)
                                {
                                    <span class="muted">Unassigned</span>
                                }
                                else
                                {
                                    <div class="assignees">
                                        @foreach (var a in _idea.Assignees)
                                        {
                                            <span class="assignee"><span class="avatar s">@Initials(a.DisplayName)</span>@a.DisplayName</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_idea.DueDate))
                        {
                            <div class="fact">
                                <div class="k">Due date</div>
                                <div class="v">@_idea.DueDate</div>
                            </div>
                        }
                        <div class="fact">
                            <div class="k">Tags</div>
                            <div class="v">
                                @if (_idea.TagNames.Count == 0)
                                {
                                    <span class="muted">None</span>
                                }
                                else
                                {
                                    <div class="taglist">
                                        @foreach (var t in _idea.TagNames)
                                        {
                                            <span class="pill neutral">@t</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                        @foreach (var f in _resolvedFields)
                        {
                            var display = DisplayFieldValue(f);
                            @if (!string.IsNullOrEmpty(display))
                            {
                                <div class="fact">
                                    <div class="k">@f.Name</div>
                                    <div class="v">@display</div>
                                </div>
                            }
                        }
                        @foreach (var av in ArchivedValues)
                        {
                            <div class="fact">
                                <div class="k">@av.FieldName <span class="archtag">archived</span></div>
                                <div class="v muted">@ArchivedDisplay(av)</div>
                            </div>
                        }
                    </div>

                    @if (_showReassign && _canReassign)
                    {
                        <div class="reassign-box">
                            <label>Reassign type <span class="muted">(admin break-glass)</span></label>
                            <p class="help">Type is set at creation and immutable for regular edits. Values outside the new type's fields are archived, not lost, and the change is logged.</p>
                            <select value="@_reassignTargetId" @onchange="OnReassignTargetChanged" disabled="@_reassigning">
                                @foreach (var t in _ideaTypes.Where(t => !t.IsDeleted))
                                {
                                    <option value="@t.IdeaTypeId">@t.Name</option>
                                }
                            </select>
                            @if (ReassignArchivedNames.Count > 0)
                            {
                                <div class="authnote" style="margin-top:8px">
                                    <strong>@string.Join(", ", ReassignArchivedNames)</strong>
                                    @(ReassignArchivedNames.Count == 1 ? " isn't" : " aren't") on the new type — its value@(ReassignArchivedNames.Count == 1 ? "" : "s") will be kept but hidden (archived).
                                </div>
                            }
                            @if (_reassignError is not null)
                            {
                                <div class="autherror" role="alert" style="margin-top:8px">@_reassignError</div>
                            }
                            <div class="btnrow" style="margin-top:10px">
                                <button class="btn primary sm" @onclick="ConfirmReassign"
                                        disabled="@(_reassigning || string.IsNullOrEmpty(_reassignTargetId) || _reassignTargetId == _idea.IdeaTypeId)">
                                    @(_reassigning ? "Reassigning…" : "Confirm reassignment")
                                </button>
                                <button class="btn subtle sm" @onclick="ToggleReassign" disabled="@_reassigning">Cancel</button>
                            </div>
                        </div>
                    }

                    <h3 class="section-title">Discussion <span class="meta">@_comments.Count comment@(_comments.Count == 1 ? "" : "s")</span></h3>
                    @if (_commentsError is not null)
                    {
                        <div class="autherror" role="alert">@_commentsError</div>
                    }
                    @if (_comments.Count == 0)
                    {
                        <p class="empty">No comments yet. Start the discussion below.</p>
                    }
                    else
                    {
                        @foreach (var c in _comments)
                        {
                            <div class="comment">
                                <span class="avatar s">@Initials(DisplayNameFor(c.AuthorUserId))</span>
                                <div class="cbody">
                                    <div class="cbyline"><span class="who">@DisplayNameFor(c.AuthorUserId)</span> <span class="when">@FormatWhen(c.CreatedAtUtc)</span></div>
                                    <p>@c.Body</p>
                                </div>
                            </div>
                        }
                    }

                    <div class="addcomment">
                        <span class="avatar s">@Initials(_currentUserName)</span>
                        <div class="addbox">
                            <textarea aria-label="Add a comment" maxlength="2000"
                                      placeholder="Join the discussion… type someone's email with @@ to notify them"
                                      @bind="_newComment" @bind:event="oninput" disabled="@_postingComment"></textarea>
                            <div class="addrow">
                                <span class="charcount @(_newComment.Length > 2000 ? "over" : "")">@_newComment.Length / 2000</span>
                                <button class="btn primary sm" @onclick="PostComment"
                                        disabled="@(_postingComment || string.IsNullOrWhiteSpace(_newComment) || _newComment.Length > 2000)">
                                    @(_postingComment ? "Posting…" : "Post comment")
                                </button>
                            </div>
                        </div>
                    </div>

                    @if (_canDelete)
                    {
                        <div class="dangerzone">
                            @if (!_confirmingDelete)
                            {
                                <button class="btn danger" @onclick="() => _confirmingDelete = true" disabled="@_deleting">Delete idea</button>
                            }
                            else
                            {
                                <span class="confirmtext">Delete this idea? This can't be undone.</span>
                                <button class="btn danger" @onclick="DeleteIdea" disabled="@_deleting">@(_deleting ? "Deleting…" : "Confirm delete")</button>
                                <button class="btn subtle sm" @onclick="() => _confirmingDelete = false" disabled="@_deleting">Cancel</button>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="surface-body" id="drawer-form">
                    <div class="formgrid">
                        <div class="span2">
                            <label for="ed-title">Title <span class="required">*</span> <span class="charlim">@_title.Length / 150</span></label>
                            <input id="ed-title" type="text" maxlength="150" @bind="_title" @bind:event="oninput" disabled="@_savingIdea" />
                        </div>
                        <div class="span2">
                            <label for="ed-desc">Description <span class="charlim">@_description.Length / 4000</span></label>
                            <textarea id="ed-desc" rows="6" maxlength="4000" @bind="_description" @bind:event="oninput" disabled="@_savingIdea"></textarea>
                            <div class="help">Type an email with @@ to notify that person.</div>
                        </div>
                        <div>
                            <label for="ed-prio">Priority</label>
                            <select id="ed-prio" @bind="_priority" disabled="@_savingIdea">
                                <option value="Critical">Critical</option>
                                <option value="High">High</option>
                                <option value="Medium">Medium</option>
                                <option value="Low">Low</option>
                            </select>
                        </div>
                        <div>
                            <label for="ed-impact">Business impact</label>
                            <select id="ed-impact" @bind="_businessImpactId" disabled="@(_savingIdea || _businessImpacts.Count == 0)">
                                @foreach (var b in _businessImpacts.Where(b => !b.IsDeleted || b.BusinessImpactId == _businessImpactId))
                                {
                                    <option value="@b.BusinessImpactId">@b.Name</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label>Idea type</label>
                            <div class="readbadge"><TypeBadge Name="@_idea.IdeaTypeName" ColorHex="@_idea.IdeaTypeColorHex" Icon="@_idea.IdeaTypeIcon" /></div>
                            <div class="help">Immutable after creation.</div>
                        </div>
                        <div>
                            <label for="ed-due">Due date</label>
                            <input id="ed-due" type="date" value="@_dueDate" @onchange="e => _dueDate = e.Value?.ToString()" disabled="@_savingIdea" />
                        </div>
                        <div class="span2">
                            <label>Assigned to <span class="muted">(@_assigneeIds.Count / 5)</span></label>
                            @if (_assigneeIds.Count > 0)
                            {
                                <div class="chips">
                                    @foreach (var uid in _assigneeIds)
                                    {
                                        <span class="editchip">@UserName(uid)
                                            <button type="button" class="x" @onclick="() => RemoveAssignee(uid)" disabled="@_savingIdea" aria-label="Remove assignee">×</button>
                                        </span>
                                    }
                                </div>
                            }
                            @if (_assigneeIds.Count < 5)
                            {
                                <select value="" @onchange="OnAddAssignee" disabled="@_savingIdea">
                                    <option value="">Add assignee…</option>
                                    @foreach (var u in AssignableUsers)
                                    {
                                        <option value="@u.UserId">@($"{u.FirstName} {u.LastName}".Trim())</option>
                                    }
                                </select>
                            }
                        </div>
                        <div class="span2">
                            <label>Tags <span class="muted">(@_tags.Count / 10)</span></label>
                            @if (_tags.Count > 0)
                            {
                                <div class="chips">
                                    @foreach (var t in _tags)
                                    {
                                        <span class="editchip">@t
                                            <button type="button" class="x" @onclick="() => RemoveTag(t)" disabled="@_savingIdea" aria-label="Remove tag">×</button>
                                        </span>
                                    }
                                </div>
                            }
                            @if (_tags.Count < 10)
                            {
                                <div class="tagadd">
                                    <input type="text" placeholder="Add a tag" @bind="_tagDraft" @bind:event="oninput"
                                           @onkeydown="OnTagKeyDown" disabled="@_savingIdea" />
                                    <button type="button" class="btn sm" @onclick="AddTag" disabled="@(_savingIdea || string.IsNullOrWhiteSpace(_tagDraft))">Add</button>
                                </div>
                            }
                        </div>
                        @if (_resolvedFields.Count > 0)
                        {
                            <div class="span2">
                                <h4 class="udf-head">Custom fields</h4>
                                <IdeaFieldInputs Fields="_resolvedFields" Values="_fieldValues" Disabled="_savingIdea" OnChanged="StateHasChanged" />
                            </div>
                        }
                    </div>
                </div>
                <footer class="surface-foot">
                    <button class="btn" @onclick="CancelEdit" disabled="@_savingIdea">Cancel</button>
                    <button class="btn primary" @onclick="SaveIdea" disabled="@_savingIdea">@(_savingIdea ? "Saving…" : "Save changes")</button>
                </footer>
            }
        }
    </aside>
}

@code {
    [Parameter] public string? IdeaId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<IdeaDetailDto> OnChanged { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private IdeaDetailDto? _idea;
    private readonly List<CommentListItemDto> _comments = new();
    private List<StatusItemDto> _statusOptions = new();
    private readonly Dictionary<string, string> _names = new();
    private IReadOnlyList<UserListItemDto> _orgUsers = Array.Empty<UserListItemDto>();
    private IReadOnlyList<BusinessImpactOptionDto> _businessImpacts = Array.Empty<BusinessImpactOptionDto>();

    private IReadOnlyList<FieldDefinitionDto> _fieldDefs = Array.Empty<FieldDefinitionDto>();
    private IReadOnlyList<FieldDefinitionDto> _resolvedFields = Array.Empty<FieldDefinitionDto>();
    private IReadOnlyList<IdeaTypeOptionDto> _ideaTypes = Array.Empty<IdeaTypeOptionDto>();
    private Dictionary<string, string?> _fieldValues = new();

    // Edit working copies.
    private string _title = "";
    private string _description = "";
    private string _priority = "Medium";
    private string _businessImpactId = "";
    private string? _dueDate;
    private readonly List<string> _assigneeIds = new();
    private readonly List<string> _tags = new();
    private string _tagDraft = "";
    private string _newComment = "";

    private string _role = "";
    private string? _currentUserId;
    private string _currentUserName = "";
    private string? _organizationId;
    private string _boardName = "";

    private bool _loading;
    private bool _editing;
    private bool _savingIdea;
    private bool _changingStatus;
    private bool _upvoting;
    private bool _postingComment;
    private bool _deleting;
    private bool _confirmingDelete;
    private int _statusSelectNonce;

    private string? _error;
    private string? _actionError;
    private string? _commentsError;
    private string? _saveMessage;

    private string? _loadedId;

    // Admin reassign break-glass.
    private bool _showReassign;
    private bool _reassigning;
    private string _reassignTargetId = "";
    private string? _reassignError;

    private bool _canEdit => _role != "ReadOnly" && !string.IsNullOrEmpty(_role);
    private bool _canReassign =>
        string.Equals(_role, "OrgAdmin", StringComparison.OrdinalIgnoreCase)
        || string.Equals(_role, "SiteAdmin", StringComparison.OrdinalIgnoreCase);
    private bool _canDelete => _canReassign;

    private string BoardName => _boardName;

    private IEnumerable<UserListItemDto> AssignableUsers =>
        _orgUsers.Where(u => !_assigneeIds.Contains(u.UserId)
            && string.Equals(u.Status, "Active", StringComparison.OrdinalIgnoreCase));

    private IdeaTypeOptionDto? SelectedIdeaType =>
        _idea is null ? null : _ideaTypes.FirstOrDefault(t => t.IdeaTypeId == _idea.IdeaTypeId);

    protected override async Task OnParametersSetAsync()
    {
        if (IdeaId is null)
        {
            _loadedId = null;
            return;
        }
        if (IdeaId == _loadedId)
        {
            return;
        }
        _loadedId = IdeaId;
        await LoadAsync(IdeaId);
    }

    private async Task LoadAsync(string ideaId)
    {
        _loading = true;
        _editing = false;
        _confirmingDelete = false;
        _showReassign = false;
        _error = _actionError = _commentsError = _saveMessage = null;
        // Reset per-idea draft state so an unsent comment/tag/reassign from a previously
        // viewed idea can't carry over (and post) onto the next one opened in the same drawer instance.
        _newComment = "";
        _tagDraft = "";
        _reassignTargetId = "";
        _reassignError = null;
        _comments.Clear();
        _names.Clear();
        StateHasChanged();

        if (AuthStateTask is not null)
        {
            var user = (await AuthStateTask).User;
            _role = user.FindFirst(ClaimTypes.Role)?.Value ?? "";
            _currentUserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            _currentUserName = user.FindFirst(ClaimTypes.Name)?.Value ?? "";
            _organizationId = user.FindFirst("organizationId")?.Value;
        }

        var result = await Api.GetIdeaAsync(ideaId);
        if (ideaId != _loadedId) return; // a newer open superseded this load; abandon it
        if (!result.Succeeded || result.Value is null)
        {
            _error = result.Error ?? "This idea could not be loaded.";
            _idea = null;
            _loading = false;
            StateHasChanged();
            return;
        }

        SetIdea(result.Value);

        var board = await Api.GetBoardAsync(_idea!.BoardId);
        if (board.Succeeded && board.Value is not null)
        {
            _organizationId = board.Value.OrganizationId;
            _boardName = board.Value.Name;
            _statusOptions = board.Value.Swimlanes
                .OrderBy(s => s.Order)
                .Select(s => new StatusItemDto(s.StatusId, board.Value.OrganizationId, s.StatusName, s.StatusColor, s.Order, s.StatusIsDeleted))
                .ToList();
        }

        if (!string.IsNullOrEmpty(_organizationId))
        {
            var fieldsResult = await Api.GetActiveFieldDefinitionsAsync(_organizationId);
            if (fieldsResult.Succeeded)
            {
                _fieldDefs = fieldsResult.Value!;
            }
            var typesResult = await Api.GetIdeaTypesAsync(_organizationId);
            if (typesResult.Succeeded)
            {
                _ideaTypes = typesResult.Value!.OrderBy(t => t.SortOrder).ToList();
            }
            var impactsResult = await Api.GetBusinessImpactsAsync(_organizationId);
            if (impactsResult.Succeeded)
            {
                _businessImpacts = impactsResult.Value!.OrderBy(b => b.SortOrder).ToList();
            }
            var users = await Api.GetAllOrganizationUsersAsync(_organizationId);
            if (users.Succeeded && users.Value is not null)
            {
                _orgUsers = users.Value;
                foreach (var u in users.Value)
                {
                    _names[u.UserId] = $"{u.FirstName} {u.LastName}".Trim();
                }
            }
        }

        if (ideaId != _loadedId) return; // superseded while loading related org data
        _resolvedFields = IdeaTypeFieldResolution.Resolve(SelectedIdeaType, _fieldDefs);
        await LoadCommentsAsync(ideaId);
        if (ideaId != _loadedId) return; // superseded while loading comments

        _loading = false;
        StateHasChanged();
    }

    private void SetIdea(IdeaDetailDto idea)
    {
        _idea = idea;
        _title = idea.Title;
        _description = idea.Description;
        _priority = idea.Priority;
        _businessImpactId = idea.BusinessImpactId;
        _dueDate = idea.DueDate;
        _assigneeIds.Clear();
        _assigneeIds.AddRange(idea.Assignees.Select(a => a.UserId));
        _tags.Clear();
        _tags.AddRange(idea.TagNames);

        foreach (var a in idea.Assignees)
        {
            _names[a.UserId] = a.DisplayName;
        }
        foreach (var m in idea.Mentions)
        {
            _names[m.UserId] = m.DisplayName;
        }
    }

    private void SeedFieldValues()
    {
        _fieldValues = new Dictionary<string, string?>();
        if (_idea is null)
        {
            return;
        }
        foreach (var f in _resolvedFields)
        {
            _fieldValues[f.FieldDefinitionId] = _idea.FieldValues?.FirstOrDefault(v => v.FieldDefinitionId == f.FieldDefinitionId)?.Value;
        }
    }

    private async Task LoadCommentsAsync(string ideaId)
    {
        var comments = await Api.GetIdeaCommentsAsync(ideaId);
        _comments.Clear();
        if (comments.Succeeded && comments.Value is not null)
        {
            _comments.AddRange(comments.Value.Items.OrderBy(c => c.CreatedAtUtc));
        }
        else if (_idea is not null)
        {
            _comments.AddRange(_idea.Comments
                .OrderBy(c => c.CreatedAtUtc)
                .Select(c => new CommentListItemDto(c.CommentId, c.IdeaId, c.AuthorUserId, c.Body, c.CreatedAtUtc, c.UpdatedAtUtc)));
            if (!comments.Succeeded)
            {
                _commentsError = comments.Error;
            }
        }
    }

    private void StartEdit()
    {
        if (_idea is null)
        {
            return;
        }
        _title = _idea.Title;
        _description = _idea.Description;
        _priority = _idea.Priority;
        _businessImpactId = _idea.BusinessImpactId;
        _dueDate = _idea.DueDate;
        _assigneeIds.Clear();
        _assigneeIds.AddRange(_idea.Assignees.Select(a => a.UserId));
        _tags.Clear();
        _tags.AddRange(_idea.TagNames);
        _tagDraft = "";
        SeedFieldValues();
        _actionError = _saveMessage = null;
        _editing = true;
    }

    private void CancelEdit()
    {
        _editing = false;
        _actionError = null;
    }

    private void OnAddAssignee(ChangeEventArgs e)
    {
        var id = e.Value?.ToString();
        if (!string.IsNullOrEmpty(id) && _assigneeIds.Count < 5 && !_assigneeIds.Contains(id))
        {
            _assigneeIds.Add(id);
        }
    }

    private void RemoveAssignee(string id) => _assigneeIds.Remove(id);

    private void AddTag()
    {
        var t = _tagDraft.Trim();
        if (!string.IsNullOrEmpty(t) && _tags.Count < 10
            && !_tags.Any(x => string.Equals(x, t, StringComparison.OrdinalIgnoreCase)))
        {
            _tags.Add(t);
        }
        _tagDraft = "";
    }

    private void OnTagKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or ",")
        {
            AddTag();
        }
    }

    private void RemoveTag(string t) => _tags.Remove(t);

    private async Task SaveIdea()
    {
        if (_idea is null || !_canEdit)
        {
            return;
        }
        var title = _title.Trim();
        if (string.IsNullOrWhiteSpace(title))
        {
            _actionError = "A title is required.";
            return;
        }
        var missing = _resolvedFields.FirstOrDefault(f => f.IsRequired && string.IsNullOrWhiteSpace(_fieldValues.GetValueOrDefault(f.FieldDefinitionId)));
        if (missing is not null)
        {
            _actionError = $"{missing.Name} is required.";
            return;
        }

        _savingIdea = true;
        _actionError = _saveMessage = null;

        var fieldValues = _resolvedFields
            .Select(f => new IdeaFieldValueWriteDto(f.FieldDefinitionId, _fieldValues.GetValueOrDefault(f.FieldDefinitionId)))
            .ToList();

        var body = new UpdateIdeaRequestDto(
            title,
            _description,
            _priority,
            _idea.IdeaTypeId,
            _businessImpactId,
            string.IsNullOrWhiteSpace(_dueDate) ? null : _dueDate,
            _assigneeIds.ToList(),
            _tags.ToList(),
            ExtractMentionEmails(_description),
            _resolvedFields.Count > 0 ? fieldValues : null);

        var result = await Api.UpdateIdeaAsync(_idea.IdeaId, body);
        if (result.Succeeded && result.Value is not null)
        {
            SetIdea(result.Value);
            _resolvedFields = IdeaTypeFieldResolution.Resolve(SelectedIdeaType, _fieldDefs);
            _saveMessage = "Changes saved.";
            _editing = false;
            await OnChanged.InvokeAsync(_idea);
        }
        else
        {
            _actionError = result.Error ?? "Save failed.";
        }
        _savingIdea = false;
    }

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        var targetId = e.Value?.ToString();
        if (_idea is null || string.IsNullOrEmpty(targetId) || targetId == _idea.StatusId)
        {
            return;
        }
        _changingStatus = true;
        _actionError = _saveMessage = null;

        var result = await Api.ChangeIdeaStatusAsync(_idea.IdeaId, new ChangeIdeaStatusRequestDto(targetId));
        if (result.Succeeded)
        {
            var target = _statusOptions.FirstOrDefault(s => s.StatusId == targetId);
            _idea = _idea with { StatusId = targetId, StatusName = target?.Name ?? _idea.StatusName };
            _saveMessage = "Status updated.";
            await OnChanged.InvokeAsync(_idea);
        }
        else
        {
            _statusSelectNonce++;
            _actionError = result.Error ?? "Status change failed.";
        }
        _changingStatus = false;
    }

    private async Task ToggleUpvote()
    {
        if (_idea is null)
        {
            return;
        }
        _upvoting = true;
        _actionError = null;
        var result = await Api.ToggleUpvoteAsync(_idea.IdeaId);
        if (result.Succeeded && result.Value is not null)
        {
            _idea = _idea with { HasUpvoted = result.Value.HasUpvoted, UpvoteCount = result.Value.UpvoteCount };
            await OnChanged.InvokeAsync(_idea);
        }
        else
        {
            _actionError = result.Error ?? "Could not update your upvote.";
        }
        _upvoting = false;
    }

    private async Task PostComment()
    {
        if (_idea is null || string.IsNullOrWhiteSpace(_newComment) || _newComment.Length > 2000)
        {
            return;
        }
        _postingComment = true;
        _actionError = null;
        var body = new CreateCommentRequestDto(_newComment, ExtractMentionEmails(_newComment));
        var result = await Api.AddIdeaCommentAsync(_idea.IdeaId, body);
        if (result.Succeeded)
        {
            _newComment = "";
            await LoadCommentsAsync(_idea.IdeaId);
        }
        else
        {
            _actionError = result.Error ?? "Could not post your comment.";
        }
        _postingComment = false;
    }

    private async Task DeleteIdea()
    {
        if (_idea is null || !_canDelete)
        {
            return;
        }
        _deleting = true;
        _actionError = null;
        var result = await Api.DeleteIdeaAsync(_idea.IdeaId);
        if (result.Succeeded)
        {
            await OnChanged.InvokeAsync(_idea);
            await OnClose.InvokeAsync();
        }
        else
        {
            _actionError = result.Error ?? "Could not delete this idea.";
            _confirmingDelete = false;
        }
        _deleting = false;
    }

    private void ToggleReassign()
    {
        _showReassign = !_showReassign;
        _reassignError = null;
        if (_showReassign && _idea is not null)
        {
            _reassignTargetId = _idea.IdeaTypeId;
        }
    }

    private void OnReassignTargetChanged(ChangeEventArgs e) => _reassignTargetId = e.Value?.ToString() ?? "";

    private async Task ConfirmReassign()
    {
        if (_idea is null || !_canReassign || string.IsNullOrEmpty(_organizationId) || string.IsNullOrEmpty(_reassignTargetId))
        {
            return;
        }
        if (_reassignTargetId == _idea.IdeaTypeId)
        {
            _reassignError = "Choose a different idea type.";
            return;
        }
        _reassigning = true;
        _reassignError = null;
        var result = await Api.ReassignIdeaTypeAsync(_organizationId!, _idea.IdeaId, new ReassignIdeaTypeRequestDto(_reassignTargetId));
        _reassigning = false;
        if (!result.Succeeded)
        {
            _reassignError = result.Error ?? "Reassigning the idea type failed.";
            return;
        }
        _showReassign = false;
        await LoadAsync(_idea.IdeaId);
        await OnChanged.InvokeAsync(_idea!);
    }

    private async Task CloseAsync()
    {
        if (_savingIdea || _deleting)
        {
            return;
        }
        await OnClose.InvokeAsync();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await CloseAsync();
        }
    }

    // Historical values whose field is no longer in this idea's resolved set — preserved, shown muted.
    private IReadOnlyList<IdeaFieldValueDetailDto> ArchivedValues
    {
        get
        {
            if (_idea?.FieldValues is null)
            {
                return Array.Empty<IdeaFieldValueDetailDto>();
            }
            var resolved = _resolvedFields.Select(f => f.FieldDefinitionId).ToHashSet();
            return _idea.FieldValues
                .Where(v => !string.IsNullOrWhiteSpace(v.Value) && !resolved.Contains(v.FieldDefinitionId))
                .ToList();
        }
    }

    private IReadOnlyList<string> ReassignArchivedNames
    {
        get
        {
            if (_idea?.FieldValues is null || string.IsNullOrEmpty(_reassignTargetId))
            {
                return Array.Empty<string>();
            }
            var target = _ideaTypes.FirstOrDefault(t => t.IdeaTypeId == _reassignTargetId);
            var targetResolved = IdeaTypeFieldResolution.Resolve(target, _fieldDefs).Select(f => f.FieldDefinitionId).ToHashSet();
            return _idea.FieldValues
                .Where(v => !string.IsNullOrWhiteSpace(v.Value) && !targetResolved.Contains(v.FieldDefinitionId))
                .Select(v => v.FieldName)
                .ToList();
        }
    }

    private static readonly Regex EmailPattern =
        new(@"[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}", RegexOptions.Compiled);

    private static List<string>? ExtractMentionEmails(string body)
    {
        var emails = EmailPattern.Matches(body)
            .Select(m => m.Value)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        return emails.Count > 0 ? emails : null;
    }

    private string UserName(string userId) =>
        _names.TryGetValue(userId, out var name) && !string.IsNullOrWhiteSpace(name) ? name : "Member";

    private string DisplayNameFor(string userId)
    {
        if (!string.IsNullOrEmpty(userId) && _names.TryGetValue(userId, out var name) && !string.IsNullOrWhiteSpace(name))
        {
            return name;
        }
        return string.Equals(userId, _currentUserId, StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(_currentUserName)
            ? _currentUserName
            : "Member";
    }

    private static string Initials(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "?";
        }
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1
            ? parts[0][..1].ToUpperInvariant()
            : (parts[0][..1] + parts[^1][..1]).ToUpperInvariant();
    }

    private string? DisplayFieldValue(FieldDefinitionDto f)
    {
        var raw = _idea?.FieldValues?.FirstOrDefault(v => v.FieldDefinitionId == f.FieldDefinitionId)?.Value;
        if (string.IsNullOrWhiteSpace(raw))
        {
            return null;
        }
        return f.FieldType switch
        {
            "Boolean" => string.Equals(raw, "true", StringComparison.OrdinalIgnoreCase) ? "Yes" : "No",
            "Dropdown" => f.Options.FirstOrDefault(o => o.OptionId == raw)?.Label ?? raw,
            "MultiSelect" => string.Join(", ", raw
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(idv => f.Options.FirstOrDefault(o => o.OptionId == idv)?.Label ?? idv)),
            _ => raw,
        };
    }

    private string ArchivedDisplay(IdeaFieldValueDetailDto av)
    {
        var raw = av.Value ?? "";
        if (string.IsNullOrWhiteSpace(raw))
        {
            return "";
        }
        var f = _fieldDefs.FirstOrDefault(x => x.FieldDefinitionId == av.FieldDefinitionId);
        return av.FieldType switch
        {
            "Boolean" => string.Equals(raw, "true", StringComparison.OrdinalIgnoreCase) ? "Yes" : "No",
            "Dropdown" => f?.Options.FirstOrDefault(o => o.OptionId == raw)?.Label ?? raw,
            "MultiSelect" => string.Join(", ", raw
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(idv => f?.Options.FirstOrDefault(o => o.OptionId == idv)?.Label ?? idv)),
            _ => raw,
        };
    }

    private string StatusColor(string statusId) =>
        _statusOptions.FirstOrDefault(s => s.StatusId == statusId)?.Color ?? "#64748B";

    private static string BusinessImpactStyle(string? color) =>
        string.IsNullOrWhiteSpace(color) ? string.Empty : $"border-left:3px solid {color};padding-left:8px";

    private static string PriorityPill(string priority) => priority switch
    {
        "Critical" => "err",
        "High" => "warn",
        "Medium" => "info",
        _ => "neutral",
    };

    private static string FormatWhen(DateTime utc) =>
        DateTime.SpecifyKind(utc, DateTimeKind.Utc).ToLocalTime().ToString("MMM d, yyyy · h:mm tt");
}
