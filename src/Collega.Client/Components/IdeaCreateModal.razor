@using System.Security.Claims
@using System.Text.RegularExpressions
@using Collega.Client.Services
@inject ApiClient Api

@*
    Create-idea surface (SPEC/20-feature-client-ui.md → "Idea Detail Surface"). Opened from the Ideas
    list and board headers. On success it closes and returns control to the host (no detail drawer
    auto-opens).

    Renders in the right slide-in DrawerShell since 2026-08-17 (user decision), not the centered
    CreateModalShell it used from 2026-08-10. That completes the 2026-08-14 admin-create move, so every
    list/detail surface now creates, reads and edits through the same right-edge drawer. The type name
    is kept as-is to hold the change surgical; it is a drawer despite the "Modal" in the name.

    Priority is included even though the review comp omits it, because the create contract
    (SPEC/30-Contracts.md POST /boards/{boardId}/ideas) requires it.

    Public contract:
      Open      : whether the modal is shown.
      BoardId   : create context. When null (launched from the global Ideas list), a board picker is shown.
      OnCancel  : dismissed without saving.
      OnCreated : fired with the created idea's detail after a successful create.
*@

@*
    Chrome (overlay, right panel, header, scroll body, footer, and dismissal) is delegated to the
    reusable DrawerShell — the same shell IdeaDrawer and the five admin pages use; everything below is
    Idea-specific content. Cancel is passed as OnClose so the surface can block dismissal mid-create.
*@
<DrawerShell IsOpen="Open" OnClose="Cancel"
             Eyebrow="New idea" Title="Create an idea"
             Meta="@(_boardName is { Length: > 0 } ? _boardName : "Choose a board")"
             FooterContent="RenderFooter">
    @if (_error is not null)
    {
        <div class="autherror" role="alert">@_error</div>
    }

    @if (_loadingContext)
    {
        <div class="loading"><FluentProgressRing /> <span>Loading…</span></div>
    }
    else
    {
                    <div class="formgrid">
                        @if (BoardId is null)
                        {
                            <div class="span2">
                                <label for="cr-board">Board <span class="required">*</span></label>
                                <select id="cr-board" value="@_selectedBoardId" @onchange="OnBoardPicked" disabled="@_creating">
                                    <option value="">Select a board…</option>
                                    @foreach (var b in _boards)
                                    {
                                        <option value="@b.BoardId">@b.Name</option>
                                    }
                                </select>
                            </div>
                        }

                        <div class="span2">
                            <div class="lblrow">
                                <label for="cr-title">Title <span class="required">*</span> <span class="charlim">@_title.Length / 150</span></label>
                                @if (IsSuggested(nameof(_title)))
                                {
                                    <span class="sugchip">Suggested</span>
                                    <button type="button" class="sug-clear" @onclick="() => ClearSuggestion(nameof(_title))">clear</button>
                                }
                            </div>
                            <input id="cr-title" type="text" maxlength="150" placeholder="What's the idea?"
                                   class="@SuggestedClass(nameof(_title))"
                                   @bind="_title" @bind:event="oninput" disabled="@(_creating || !_hasBoard)" />
                        </div>
                        <div class="span2">
                            <div class="lblrow">
                                <label for="cr-desc">Description <span class="required">*</span> <span class="charlim">@_description.Length / 4000</span></label>
                                @if (IsSuggested(nameof(_description)))
                                {
                                    <span class="sugchip">Suggested</span>
                                    <button type="button" class="sug-clear" @onclick="() => ClearSuggestion(nameof(_description))">clear</button>
                                }
                            </div>
                            <textarea id="cr-desc" rows="5" maxlength="4000" placeholder="Add context, motivation, or details…"
                                      class="@SuggestedClass(nameof(_description))"
                                      @bind="_description" @bind:event="oninput" disabled="@(_creating || !_hasBoard)"></textarea>
                            <div class="help">Type an email with @@ to notify that person.</div>
                        </div>
                        <div>
                            <div class="lblrow">
                                <label for="cr-type">Idea type <span class="required">*</span></label>
                                @if (IsSuggested(nameof(_ideaTypeId)))
                                {
                                    <span class="sugchip">Suggested</span>
                                }
                            </div>
                            <select id="cr-type" value="@_ideaTypeId" class="@SuggestedClass(nameof(_ideaTypeId))"
                                    @onchange="OnIdeaTypeChanged" disabled="@(_creating || !_hasBoard)">
                                @foreach (var t in _ideaTypes)
                                {
                                    <option value="@t.IdeaTypeId">@t.Name</option>
                                }
                            </select>
                        </div>
                        <div>
                            <div class="lblrow">
                                <label for="cr-impact">Business impact <span class="required">*</span></label>
                                @if (IsSuggested(nameof(_businessImpactId)))
                                {
                                    <span class="sugchip">Suggested</span>
                                }
                            </div>
                            <select id="cr-impact" class="@SuggestedClass(nameof(_businessImpactId))"
                                    @bind="_businessImpactId" disabled="@(_creating || !_hasBoard)">
                                @foreach (var b in _businessImpacts)
                                {
                                    <option value="@b.BusinessImpactId">@b.Name</option>
                                }
                            </select>
                        </div>
                        <div>
                            <div class="lblrow">
                                <label for="cr-prio">Priority</label>
                                @if (IsSuggested(nameof(_priority)))
                                {
                                    <span class="sugchip">Suggested</span>
                                }
                            </div>
                            <select id="cr-prio" class="@SuggestedClass(nameof(_priority))"
                                    @bind="_priority" disabled="@(_creating || !_hasBoard)">
                                <option value="Critical">Critical</option>
                                <option value="High">High</option>
                                <option value="Medium">Medium</option>
                                <option value="Low">Low</option>
                            </select>
                        </div>
                        <div>
                            <label for="cr-status">Status</label>
                            <select id="cr-status" @bind="_statusId" disabled="@(_creating || !_hasBoard || _statusOptions.Count == 0)">
                                @foreach (var s in _statusOptions)
                                {
                                    <option value="@s.StatusId">@s.Name</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label for="cr-due">Due date</label>
                            <input id="cr-due" type="date" value="@_dueDate" @onchange="e => _dueDate = e.Value?.ToString()" disabled="@(_creating || !_hasBoard)" />
                        </div>
                        <div class="span2">
                            <label>Assigned to <span class="muted">(@_assigneeIds.Count / 5)</span></label>
                            @if (_assigneeIds.Count > 0)
                            {
                                <div class="chips">
                                    @foreach (var uid in _assigneeIds)
                                    {
                                        <span class="editchip">@UserName(uid)
                                            <button type="button" class="x" @onclick="() => RemoveAssignee(uid)" disabled="@_creating" aria-label="Remove assignee">×</button>
                                        </span>
                                    }
                                </div>
                            }
                            @if (_assigneeIds.Count < 5)
                            {
                                <select value="" @onchange="OnAddAssignee" disabled="@(_creating || !_hasBoard)">
                                    <option value="">Add assignee…</option>
                                    @foreach (var u in AssignableUsers)
                                    {
                                        <option value="@u.UserId">@($"{u.FirstName} {u.LastName}".Trim())</option>
                                    }
                                </select>
                            }
                        </div>
                        <div class="span2">
                            <label>Tags <span class="muted">(@_tags.Count / 10)</span></label>
                            @if (_tags.Count > 0)
                            {
                                <div class="chips">
                                    @foreach (var t in _tags)
                                    {
                                        <span class="editchip">@t
                                            <button type="button" class="x" @onclick="() => RemoveTag(t)" disabled="@_creating" aria-label="Remove tag">×</button>
                                        </span>
                                    }
                                </div>
                            }
                            @if (_tags.Count < 10)
                            {
                                <div class="tagadd">
                                    <input type="text" placeholder="Add a tag" @bind="_tagDraft" @bind:event="oninput"
                                           @onkeydown="OnTagKeyDown" disabled="@(_creating || !_hasBoard)" />
                                    <button type="button" class="btn sm" @onclick="AddTag" disabled="@(_creating || string.IsNullOrWhiteSpace(_tagDraft))">Add</button>
                                </div>
                            }
                        </div>
                        @if (_resolvedFields.Count > 0)
                        {
                            <div class="span2">
                                <h4 class="udf-head">Custom fields</h4>
                                <IdeaFieldInputs Fields="_resolvedFields" Values="_fieldValues" Disabled="_creating" OnChanged="StateHasChanged" />
                            </div>
                        }
                    </div>
    }
</DrawerShell>

@code {
    // Create action bar, passed as the shell footer.
    private RenderFragment RenderFooter => @<text>
        <button class="btn" @onclick="Cancel" disabled="@_creating">Cancel</button>
        <button class="btn primary" @onclick="Create" disabled="@(_creating || !_hasBoard || _loadingContext)">
            @(_creating ? "Creating…" : "Create idea")
        </button>
    </text>;

    [Parameter] public bool Open { get; set; }
    [Parameter] public string? BoardId { get; set; }
    /// <summary>
    /// The draft carried over from the brainstorm chat (D-PREFILL). Every value arrives as an
    /// <b>editable default</b> marked with a teal suggestion indicator — the user may change or clear
    /// any of them, and nothing is committed until they submit the form (rules 19-20, 23).
    /// </summary>
    [Parameter] public IdeaDraftDto? InitialDraft { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback<IdeaDetailDto?> OnCreated { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private bool _wasOpen;
    private bool _loadingContext;
    private bool _creating;
    private string? _error;

    private string? _authOrganizationId;
    private string? _organizationId;
    private string? _selectedBoardId;
    private string _boardName = "";

    private IReadOnlyList<BoardListItemDto> _boards = Array.Empty<BoardListItemDto>();
    private List<StatusItemDto> _statusOptions = new();
    private IReadOnlyList<IdeaTypeOptionDto> _ideaTypes = Array.Empty<IdeaTypeOptionDto>();
    private IReadOnlyList<BusinessImpactOptionDto> _businessImpacts = Array.Empty<BusinessImpactOptionDto>();
    private IReadOnlyList<OrganizationMemberDto> _orgUsers = Array.Empty<OrganizationMemberDto>();
    private IReadOnlyList<FieldDefinitionDto> _fieldDefs = Array.Empty<FieldDefinitionDto>();
    private IReadOnlyList<FieldDefinitionDto> _resolvedFields = Array.Empty<FieldDefinitionDto>();

    private string _title = "";
    private string _description = "";
    private string _priority = "Medium";
    private string _ideaTypeId = "";
    private string _businessImpactId = "";
    private string _statusId = "";
    private string? _dueDate;
    private readonly List<string> _assigneeIds = new();
    private readonly List<string> _tags = new();
    private string _tagDraft = "";
    private readonly Dictionary<string, string> _names = new();
    private Dictionary<string, string?> _fieldValues = new();

    private bool _hasBoard => !string.IsNullOrEmpty(_selectedBoardId);

    // The members endpoint already returns only active members, so we filter only out the already-chosen.
    private IEnumerable<OrganizationMemberDto> AssignableUsers =>
        _orgUsers.Where(u => !_assigneeIds.Contains(u.UserId));

    private IdeaTypeOptionDto? SelectedIdeaType => _ideaTypes.FirstOrDefault(t => t.IdeaTypeId == _ideaTypeId);

    protected override async Task OnParametersSetAsync()
    {
        if (Open && !_wasOpen)
        {
            _wasOpen = true;
            await OpenAsync();
        }
        else if (!Open)
        {
            _wasOpen = false;
        }
    }

    private async Task OpenAsync()
    {
        ResetForm();
        _error = null;
        _suggested.Clear();

        // Split by what each value actually depends on. Title, description and priority need no
        // catalog, so they apply now — otherwise they would be lost entirely on the global
        // Ideas-list path, which returns below to show a board picker before any catalog loads.
        ApplyDraftText();
        _loadingContext = true;

        if (AuthStateTask is not null)
        {
            _authOrganizationId = (await AuthStateTask).User.FindFirst("organizationId")?.Value;
        }

        _selectedBoardId = BoardId;

        if (BoardId is null)
        {
            // Global Ideas-list entry point: list the caller's boards for the picker.
            if (!string.IsNullOrEmpty(_authOrganizationId))
            {
                var boards = await Api.GetBoardsAsync(_authOrganizationId);
                if (boards.Succeeded)
                {
                    _boards = boards.Value!;
                }
            }
            _loadingContext = false;
            StateHasChanged();
            return;
        }

        await LoadBoardContextAsync(BoardId);
        _loadingContext = false;
        StateHasChanged();
    }

    private void ResetForm()
    {
        _title = _description = _tagDraft = "";
        _priority = "Medium";
        _dueDate = null;
        _assigneeIds.Clear();
        _tags.Clear();
        _fieldValues = new Dictionary<string, string?>();
        _resolvedFields = Array.Empty<FieldDefinitionDto>();
        _statusOptions = new List<StatusItemDto>();
        _statusId = "";
        _boardName = "";
    }

    private async Task OnBoardPicked(ChangeEventArgs e)
    {
        var id = e.Value?.ToString();
        _selectedBoardId = string.IsNullOrEmpty(id) ? null : id;
        _assigneeIds.Clear();
        if (_hasBoard)
        {
            _loadingContext = true;
            StateHasChanged();
            await LoadBoardContextAsync(_selectedBoardId!);
            _loadingContext = false;
        }
    }

    private async Task LoadBoardContextAsync(string boardId)
    {
        var board = await Api.GetBoardAsync(boardId);
        if (!board.Succeeded || board.Value is null)
        {
            _error = board.Error ?? "Couldn't load the board.";
            return;
        }
        _boardName = board.Value.Name;
        _organizationId = board.Value.OrganizationId;
        _statusOptions = board.Value.Swimlanes
            .OrderBy(s => s.Order)
            .Select(s => new StatusItemDto(s.StatusId, board.Value.OrganizationId, s.StatusName, s.StatusColor, s.Order, s.StatusIsDeleted))
            .ToList();
        _statusId = _statusOptions.FirstOrDefault()?.StatusId ?? "";

        await LoadOrgOptionsAsync(_organizationId!);
        ApplyDraftOptions();
    }

    /// <summary>
    /// The catalog-independent half of the draft. Applied as soon as the modal opens, so it survives
    /// the global Ideas-list path where the user must pick a board before any catalog is fetched.
    /// </summary>
    private void ApplyDraftText()
    {
        if (InitialDraft is null)
        {
            return;
        }

        if (!string.IsNullOrWhiteSpace(InitialDraft.Title))
        {
            _title = Clamp(InitialDraft.Title!, 150);
            _suggested.Add(nameof(_title));
        }

        if (!string.IsNullOrWhiteSpace(InitialDraft.Description))
        {
            _description = Clamp(InitialDraft.Description!, 4000);
            _suggested.Add(nameof(_description));
        }

        if (InitialDraft.Priority is { Length: > 0 } priority)
        {
            _priority = priority;
            _suggested.Add(nameof(_priority));
        }
    }

    /// <summary>
    /// The catalog-dependent half: the option ids. Runs after <see cref="LoadOrgOptionsAsync"/>,
    /// because that is what seeds the selects — applying earlier would be silently overwritten. An id
    /// no longer in the catalog is skipped and the default stands: a stale suggestion should not leave
    /// the form pointing at an option that isn't there.
    /// </summary>
    private void ApplyDraftOptions()
    {
        if (InitialDraft is null)
        {
            return;
        }

        if (InitialDraft.IdeaTypeId is { Length: > 0 } typeId
            && _ideaTypes.Any(t => t.IdeaTypeId == typeId))
        {
            _ideaTypeId = typeId;
            _suggested.Add(nameof(_ideaTypeId));
            // The resolved field set follows the type, so a suggested type must re-resolve it —
            // otherwise the form shows the default type's fields under the suggested type's name.
            RecomputeResolvedFields();
        }

        if (InitialDraft.BusinessImpactId is { Length: > 0 } impactId
            && _businessImpacts.Any(b => b.BusinessImpactId == impactId))
        {
            _businessImpactId = impactId;
            _suggested.Add(nameof(_businessImpactId));
        }
    }

    private static string Clamp(string value, int maxLength) =>
        value.Length <= maxLength ? value : value[..maxLength];

    /// <summary>
    /// Which fields carry a suggestion indicator. Set once when the draft is applied and cleared per
    /// field on demand — v1 deliberately tracks nothing finer. Direction C keeps the draft strip
    /// read-only precisely so no suggested-vs-user-edited state machine is needed; if a chip lingers
    /// after the user edits a field, that is the accepted trade, not a bug to fix with more state.
    /// </summary>
    private readonly HashSet<string> _suggested = new();

    private bool IsSuggested(string field) => _suggested.Contains(field);

    private string? SuggestedClass(string field) => _suggested.Contains(field) ? "sug-input" : null;

    private void ClearSuggestion(string field)
    {
        if (!_suggested.Remove(field))
        {
            return;
        }

        if (field == nameof(_title))
        {
            _title = "";
        }
        else if (field == nameof(_description))
        {
            _description = "";
        }
    }

    private async Task LoadOrgOptionsAsync(string organizationId)
    {
        var typesResult = await Api.GetIdeaTypesAsync(organizationId);
        if (typesResult.Succeeded)
        {
            _ideaTypes = typesResult.Value!.Where(t => !t.IsDeleted).OrderBy(t => t.SortOrder).ToList();
            _ideaTypeId = _ideaTypes.FirstOrDefault()?.IdeaTypeId ?? "";
        }
        var impactsResult = await Api.GetBusinessImpactsAsync(organizationId);
        if (impactsResult.Succeeded)
        {
            _businessImpacts = impactsResult.Value!.Where(b => !b.IsDeleted).OrderBy(b => b.SortOrder).ToList();

            // Medium by name, not first-in-list: the seeded order is most-severe-first, so taking the
            // first option would pre-mark every new idea Critical and inflate reported severity through
            // a default nobody chose. Matches Priority's fixed Medium default above. Falls back to
            // first-active for an organization that renamed or removed Medium.
            _businessImpactId = (_businessImpacts.FirstOrDefault(b =>
                    string.Equals(b.Name, "Medium", StringComparison.OrdinalIgnoreCase))
                ?? _businessImpacts.FirstOrDefault())?.BusinessImpactId ?? "";
        }
        var fieldsResult = await Api.GetActiveFieldDefinitionsAsync(organizationId);
        if (fieldsResult.Succeeded)
        {
            _fieldDefs = fieldsResult.Value!;
        }
        var users = await Api.GetAssignableMembersAsync(organizationId);
        if (users.Succeeded && users.Value is not null)
        {
            _orgUsers = users.Value;
            _names.Clear();
            foreach (var u in users.Value)
            {
                _names[u.UserId] = $"{u.FirstName} {u.LastName}".Trim();
            }
        }
        RecomputeResolvedFields();
    }

    private void OnIdeaTypeChanged(ChangeEventArgs e)
    {
        _ideaTypeId = e.Value?.ToString() ?? "";
        RecomputeResolvedFields();
    }

    private void RecomputeResolvedFields()
    {
        _resolvedFields = IdeaTypeFieldResolution.Resolve(SelectedIdeaType, _fieldDefs);
        var next = new Dictionary<string, string?>();
        foreach (var f in _resolvedFields)
        {
            next[f.FieldDefinitionId] = _fieldValues.GetValueOrDefault(f.FieldDefinitionId);
        }
        _fieldValues = next;
    }

    private void OnAddAssignee(ChangeEventArgs e)
    {
        var id = e.Value?.ToString();
        if (!string.IsNullOrEmpty(id) && _assigneeIds.Count < 5 && !_assigneeIds.Contains(id))
        {
            _assigneeIds.Add(id);
        }
    }

    private void RemoveAssignee(string id) => _assigneeIds.Remove(id);

    private void AddTag()
    {
        var t = _tagDraft.Trim();
        if (!string.IsNullOrEmpty(t) && _tags.Count < 10
            && !_tags.Any(x => string.Equals(x, t, StringComparison.OrdinalIgnoreCase)))
        {
            _tags.Add(t);
        }
        _tagDraft = "";
    }

    private void OnTagKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or ",")
        {
            AddTag();
        }
    }

    private void RemoveTag(string t) => _tags.Remove(t);

    private async Task Create()
    {
        if (!_hasBoard)
        {
            _error = "Select a board first.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_title))
        {
            _error = "A title is required.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_description))
        {
            _error = "A description is required.";
            return;
        }
        if (_ideaTypes.Count == 0 || _businessImpacts.Count == 0)
        {
            _error = "Couldn't load Idea Type / Business Impact options. Reload and try again.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_ideaTypeId) || string.IsNullOrWhiteSpace(_businessImpactId))
        {
            _error = "Idea Type and Business Impact are required.";
            return;
        }
        var missing = _resolvedFields.FirstOrDefault(f => f.IsRequired && string.IsNullOrWhiteSpace(_fieldValues.GetValueOrDefault(f.FieldDefinitionId)));
        if (missing is not null)
        {
            _error = $"{missing.Name} is required.";
            return;
        }

        _creating = true;
        _error = null;

        var fieldValues = _resolvedFields
            .Select(f => new IdeaFieldValueWriteDto(f.FieldDefinitionId, _fieldValues.GetValueOrDefault(f.FieldDefinitionId)))
            .Where(v => !string.IsNullOrWhiteSpace(v.Value))
            .ToList();

        var body = new CreateIdeaRequestDto(
            _title.Trim(),
            _description.Trim(),
            _priority,
            _ideaTypeId,
            _businessImpactId,
            string.IsNullOrEmpty(_statusId) ? null : _statusId,
            fieldValues.Count > 0 ? fieldValues : null,
            string.IsNullOrWhiteSpace(_dueDate) ? null : _dueDate,
            _assigneeIds.Count > 0 ? _assigneeIds.ToList() : null,
            _tags.Count > 0 ? _tags.ToList() : null,
            ExtractMentionEmails(_description));

        var result = await Api.CreateIdeaAsync(_selectedBoardId!, body);
        if (!result.Succeeded || result.Value is null)
        {
            _error = result.Error ?? "Creating the idea failed.";
            _creating = false;
            return;
        }

        // Best-effort: fetch the full detail so the host gets a complete DTO. The host reloads its list
        // regardless, so a failed fetch still closes the modal successfully.
        var detail = await Api.GetIdeaAsync(result.Value.IdeaId);
        _creating = false;
        _wasOpen = false;
        await OnCreated.InvokeAsync(detail.Value);
    }

    private async Task Cancel()
    {
        if (_creating)
        {
            return;
        }
        _wasOpen = false;
        await OnCancel.InvokeAsync();
    }

    private string UserName(string userId) =>
        _names.TryGetValue(userId, out var name) && !string.IsNullOrWhiteSpace(name) ? name : "Member";

    private static readonly Regex EmailPattern =
        new(@"[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}", RegexOptions.Compiled);

    private static List<string>? ExtractMentionEmails(string body)
    {
        var emails = EmailPattern.Matches(body)
            .Select(m => m.Value)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        return emails.Count > 0 ? emails : null;
    }
}
