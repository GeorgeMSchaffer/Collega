@implements IAsyncDisposable
@inject IJSRuntime JS

@*
    DrawerShell — reusable right slide-in drawer chrome (overlay + panel + header + body + footer).

    Presentation only. It owns the surface and nothing entity-specific: the dimmed overlay, the
    ~620px right panel (full-width sheet at ≤768px), the header row with a close button, the
    scrollable body, an optional pinned footer, and the three ways to dismiss (close button, overlay
    click, Escape). Visual design is locked in SPEC/mockups/comp-c-review-09-detail-surfaces.html —
    do not restyle here. Any entity/URL-specific logic stays in the host component.

    It is also a modal surface, so opening it moves focus into the panel, disables the background
    (js/drawerFocus.js) and closing returns focus to the control that opened it. Without that the
    Escape handler below never sees a keystroke, and the background stays tabbable while
    aria-modal="true" tells assistive technology it is hidden.

    On any dismiss the shell simply raises OnClose; the host decides whether to actually close (e.g.
    to block dismissal mid-save). Extracted from IdeaDrawer for reuse across the admin List+Drawer
    conversions (Organizations, Users, Statuses, Idea Types, Custom Fields).

    Public API
      IsOpen           bool             When false the shell renders nothing.
      OnClose          EventCallback    Raised on close button, overlay click, or Escape.
      Title            string?          Heading text; also the aria-labelledby target.
      Eyebrow          string?          Small uppercase kicker above the title.
      Meta             string?          Small secondary line below the title.
      HeaderContent    RenderFragment?  Optional; replaces the Eyebrow/Title/Meta block inside the header.
      SubHeaderContent RenderFragment?  Optional; sits between header and the scrollable body (e.g. inline
                                        flash/status), so it is not scrolled away with the body.
      ChildContent     RenderFragment?  The scrollable body.
      FooterContent    RenderFragment?  Optional pinned action bar; the footer element is omitted when null.

    Usage
      <DrawerShell IsOpen="@(_selectedId is not null)" OnClose="Close"
                   Eyebrow="Organization" Title="@_name" Meta="@_meta">
          <ChildContent>...detail / edit form...</ChildContent>
          <FooterContent>
              <button class="btn" @onclick="Close">Cancel</button>
              <button class="btn primary" @onclick="Save">Save</button>
          </FooterContent>
      </DrawerShell>
*@

@if (IsOpen)
{
    <div class="surface-backdrop open" @onclick="OnClose"></div>
    <aside @ref="_panel" class="drawer open" role="dialog" aria-modal="true"
           aria-labelledby="@(Title is not null ? _titleId : null)"
           tabindex="-1" @onkeydown="OnKeyDown">
        <header class="surface-head">
            <div class="grow">
                @if (HeaderContent is not null)
                {
                    @HeaderContent
                }
                else
                {
                    @if (!string.IsNullOrEmpty(Eyebrow))
                    {
                        <div class="eyebrow">@Eyebrow</div>
                    }
                    <h2 id="@_titleId">@Title</h2>
                    @if (!string.IsNullOrEmpty(Meta))
                    {
                        <div class="meta">@Meta</div>
                    }
                }
            </div>
            <button class="iconbtn" @onclick="OnClose" aria-label="Close">×</button>
        </header>

        @if (SubHeaderContent is not null)
        {
            @SubHeaderContent
        }

        <div class="surface-body">
            @ChildContent
        </div>

        @if (FooterContent is not null)
        {
            <footer class="surface-foot">@FooterContent</footer>
        }
    </aside>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter] public string? Meta { get; set; }
    [Parameter] public RenderFragment? HeaderContent { get; set; }
    [Parameter] public RenderFragment? SubHeaderContent { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }

    // Stable per-instance id so the panel's aria-labelledby resolves without colliding across
    // instances. It doubles as the key drawerFocus.js files this drawer's background state under,
    // which has to survive the panel element itself: on close Blazor has already removed it.
    private readonly string _titleId = $"drawer-title-{Guid.NewGuid():N}";

    private ElementReference _panel;
    private IJSObjectReference? _module;
    private bool _activated;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Import before anything opens, not on the first open. The module registers the focusin
        // listener that remembers the invoking control, and StatusesAdmin and IdeaTypesAdmin
        // disable that control in the very render that opens the drawer. Importing lazily
        // registered the listener *after* that blur, so the first open of every page load had
        // nothing to restore focus to — the interaction a user makes first.
        if (firstRender)
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/drawerFocus.js");

            if (_disposed)
            {
                await _module.DisposeAsync();
                _module = null;
                return;
            }
        }

        if (IsOpen == _activated)
        {
            return;
        }

        _activated = IsOpen;
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/drawerFocus.js");

        // The import is the one slow await here, and the panel can be gone by the time it
        // resolves — navigate away while a drawer is open and DisposeAsync has already run with
        // _module still null, so it had nothing to unwind. Re-read the state rather than the
        // captured IsOpen: activating against a detached panel inerts nothing and throws on focus.
        if (_disposed)
        {
            await _module.DisposeAsync();
            return;
        }

        if (_activated != IsOpen)
        {
            return;
        }

        if (IsOpen)
        {
            await _module.InvokeVoidAsync("activate", _titleId, _panel);
            await _panel.FocusAsync();
        }
        else
        {
            await _module.InvokeVoidAsync("deactivate", _titleId);
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await OnClose.InvokeAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        // Read by OnAfterRenderAsync after its import completes, which is how a teardown that
        // lands mid-import still gets unwound.
        _disposed = true;

        if (_module is null)
        {
            return;
        }

        // A drawer can be torn down without IsOpen ever going false — its host page navigates away
        // while it is open — and inert left behind on the shell would take the whole app with it.
        if (_activated)
        {
            await _module.InvokeVoidAsync("deactivate", _titleId);
        }

        await _module.DisposeAsync();
    }
}
