# Copy this file to .env (gitignored) and set a real password before running docker compose.
# Must satisfy SQL Server complexity requirements: 8+ chars, upper+lower+digit+symbol.
MSSQL_SA_PASSWORD=Ch4ngeMe!Now

# Optional: host-side port mapping for the SQL Server container.
MSSQL_HOST_PORT=1433

# Seed Site Admin credential (bound by the API to SiteAdmin__Email / SiteAdmin__Password;
# only consumed by the `api` service, so unused until src/Collega.API exists).
SITE_ADMIN_EMAIL=admin@collega.local
SITE_ADMIN_PASSWORD=Ch4ngeMe!Now
