# Copy this file to .env (gitignored) and set a real password before running docker compose.
POSTGRES_PASSWORD=Ch4ngeMe!Now

# Role the Postgres container creates on first init. Kept as `collega` so local,
# in-cluster (SPEC/50-kubernetes-deployment.md) and app connection strings all name the
# same role. Note this is still the container's *superuser*, just not called `postgres` —
# the image has no way to create a least-privileged role without an init script. Azure
# deliberately differs (`collegaadmin`), because its managed admin-user model dictates it.
POSTGRES_USER=collega

# Optional: host-side port mapping for the Postgres container.
POSTGRES_HOST_PORT=5432

# Seed Site Admin credential (bound by the API to SiteAdmin__Email / SiteAdmin__Password;
# only consumed by the `api` service, so unused until src/Collega.API exists).
SITE_ADMIN_EMAIL=admin@collega.local
SITE_ADMIN_PASSWORD=Ch4ngeMe!Now

# The single deployment-level Anthropic key for AI idea assist, shared by every
# organization (SPEC/20-feature-ai-idea-assist.md rule 29). Bound by the `api` service under
# the same name. Leave it empty and the feature runs dark: the brainstorm falls back to its
# scripted prompts and the API answers "not configured" rather than erroring (rule 31).
#
# The key has no `:` segment, so the configuration key and the environment-variable name are
# the same string. This file only reaches the API under docker compose — `dotnet run` does
# not read .env, but it does read the variable straight from your shell, and user-secrets
# still works as a per-project alternative:
#   dotnet user-secrets set "ANTHROPIC_API_KEY" "<key>" --project src/Collega.API
ANTHROPIC_API_KEY=

# The connection string, and the one place any real credential belongs. `.env` is gitignored;
# never put a live URL in this file, in a spec, or in a commit.
#
# The Nest host accepts either this or the POSTGRES_* parts above, composing the URL from the
# parts when this is unset. **The Prisma CLI does not** - `prisma db pull`, `prisma migrate` and
# `prisma studio` read `env("DATABASE_URL")` straight out of the schema and cannot see the parts.
# So set this whenever you intend to run a Prisma command, even locally, and set it verbatim in
# deployment, which is the shape Prisma Postgres hands over.
# DATABASE_URL=postgresql://collega:<password>@127.0.0.1:5432/Collega?schema=public

# --- apps/api (Nest host, Sprint 9) ---

# Signs the session cookie's JWT (SPEC/decisions.md 2026-09-04, ticket 08). Optional locally -
# a random per-process key is generated if unset, exactly like .NET's Auth:TokenSigningKey -
# but that invalidates every session on restart and is never shared across instances, so a real
# deployment with more than one running instance MUST set this explicitly.
# ACCESS_TOKEN_SIGNING_KEY=

# Minutes before the session cookie's JWT expires. Defaults to 480 (8h), matching .NET's
# Auth:AccessTokenLifetimeMinutes default.
# ACCESS_TOKEN_LIFETIME_MINUTES=480

# apps/api's HTTP port. Defaults to 3001 (apps/web takes Next's default 3000). Vercel injects
# its own PORT in deployment.
# PORT=3001
